// =============================================================================
// LIÊN KẾT KHÓA NGOẠI (RELATIONSHIPS)
// =============================================================================
Ref: hatang.Ga.MaTuyen > hatang.TuyenDuong.MaTuyen // FK_Ga_TuyenDuong
Ref: hatang.DuongRayGa.MaGa > hatang.Ga.MaGa // FK_DuongRay_Ga
Ref: hatang.KhuGian.MaGaDau > hatang.Ga.MaGa // FK_KhuGian_GaDau
Ref: hatang.KhuGian.MaGaCuoi > hatang.Ga.MaGa // FK_KhuGian_GaCuoi
Ref: hatang.DuongNgang.MaKhuGian > hatang.KhuGian.MaKhuGian // FK_DuongNgang_KhuGian
Ref: phanquyen.TaiKhoan.MaNhanVien > nhansu.NhanVien.MaNhanVien // FK_TaiKhoan_NhanVien
Ref: phanquyen.TaiKhoan_VaiTro.MaTaiKhoan > phanquyen.TaiKhoan.MaTaiKhoan // FK_TKVT_TaiKhoan
Ref: phanquyen.TaiKhoan_VaiTro.MaVaiTro > phanquyen.VaiTro.MaVaiTro // FK_TKVT_VaiTro
Ref: phanquyen.TaiKhoan_VaiTro.NguoiCap > phanquyen.TaiKhoan.MaTaiKhoan // FK_TKVT_NguoiCap
Ref: phanquyen.VaiTro_Quyen.MaVaiTro > phanquyen.VaiTro.MaVaiTro // FK_VTQ_VaiTro
Ref: phanquyen.VaiTro_Quyen.MaQuyen > phanquyen.Quyen.MaQuyen // FK_VTQ_Quyen
Ref: phanquyen.LichSuDangNhap.MaTaiKhoan > phanquyen.TaiKhoan.MaTaiKhoan // FK_LSDN_TaiKhoan
Ref: phuongtien.DauMay.MaDongDauMay > phuongtien.DongDauMay.MaDongDauMay // FK_DauMay_Dong
Ref: phuongtien.ToaXe.MaChungLoai > phuongtien.ChungLoaiToa.MaChungLoai // FK_ToaXe_ChungLoai
Ref: vanhanh.MacTauMau.MaGaDi > hatang.Ga.MaGa // FK_MacTau_GaDi
Ref: vanhanh.MacTauMau.MaGaDen > hatang.Ga.MaGa // FK_MacTau_GaDen
Ref: vanhanh.ChuyenTau.MaMacTau > vanhanh.MacTauMau.MaMacTau // FK_ChuyenTau_MacTau
Ref: vanhanh.LichDungGa.MaChuyenTau > vanhanh.ChuyenTau.MaChuyenTau // FK_LichDung_ChuyenTau
Ref: vanhanh.LichDungGa.MaGa > hatang.Ga.MaGa // FK_LichDung_Ga
Ref: vanhanh.LichDungGa.MaDuongRay > hatang.DuongRayGa.MaDuongRay // FK_LichDung_DuongRay
Ref: vanhanh.DoanTau.MaChuyenTau > vanhanh.ChuyenTau.MaChuyenTau // FK_DoanTau_ChuyenTau
Ref: vanhanh.DoanTau.MaDauMayChinh > phuongtien.DauMay.MaDauMay // FK_DoanTau_DauMayChinh
