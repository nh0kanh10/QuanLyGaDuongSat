<UserControl x:Class="GUI.Views.UserControls.SearchableComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="RootCtrl"
             Focusable="True"
             KeyDown="RootCtrl_KeyDown">

    <Grid x:Name="LayoutRoot">
        <!-- NÚT BẤM HIỂN THỊ CHÍNH (LOOKS LIKE A SLEEK VNR COMBOBOX) -->
        <Border x:Name="bdTrigger"
                Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="4"
                Height="28"
                Cursor="Hand"
                Padding="8,0,8,0"
                PreviewMouseLeftButtonUp="BdTrigger_PreviewMouseLeftButtonUp">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#003B73"/>
                            <Setter Property="Background" Value="#F8FAFC"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tên mục đã chọn / Placeholder -->
                <TextBlock x:Name="txtDisplayText"
                           Grid.Column="0"
                           Text="Chọn ga..."
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Nhãn phụ nếu có (ví dụ: km 0.0) -->
                <Border x:Name="bdSubText"
                        Grid.Column="1"
                        Background="#F1F5F9"
                        CornerRadius="3"
                        Padding="4,1"
                        Margin="6,0,4,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock x:Name="txtSubText"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#64748B"/>
                </Border>

                <!-- Mũi tên Dropdown Chevron -->
                <ui:SymbolIcon x:Name="iconChevron"
                               Grid.Column="2"
                               Symbol="ChevronDown24"
                               FontSize="11"
                               Foreground="#64748B"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
            </Grid>
        </Border>

        <!-- POPUP MENU THẢ XUỐNG KÈM THANH TÌM KIẾM (IN-POPUP SEARCH - SELECT2 STYLE) -->
        <Popup x:Name="popDropdown"
               PlacementTarget="{Binding ElementName=bdTrigger}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Opened="PopDropdown_Opened"
               Closed="PopDropdown_Closed">
            <Border x:Name="bdPopupContainer"
                    Background="#FFFFFF"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,4,0,0"
                    MinWidth="280"
                    MaxWidth="380"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.2" Color="#0F172A"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0. Thanh tìm kiếm Header -->
                        <RowDefinition Height="*"/>    <!-- 1. Danh sách kết quả -->
                        <RowDefinition Height="Auto"/> <!-- 2. Footer tóm tắt số lượng -->
                    </Grid.RowDefinitions>

                    <!-- 1. THANH TÌM KIẾM DÍNH TRÊN ĐẦU (STICKY SEARCH HEADER) -->
                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,1"
                            Padding="8,6"
                            CornerRadius="5,5,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:SymbolIcon Symbol="Search24"
                                           FontSize="13"
                                           Foreground="#003B73"
                                           VerticalAlignment="Center"
                                           Margin="2,0,6,0"/>

                            <Grid Grid.Column="1">
                                <TextBox x:Name="txtSearch"
                                         Height="28"
                                         BorderThickness="1"
                                         BorderBrush="#CBD5E1"
                                         Background="#FFFFFF"
                                         Padding="6,2"
                                         FontSize="12"
                                         FontWeight="Medium"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TxtSearch_TextChanged"
                                         KeyDown="TxtSearch_KeyDown"/>

                                <!-- Watermark hướng dẫn gõ tìm kiếm -->
                                <TextBlock x:Name="txtSearchWatermark"
                                           Text="Gõ tên ga để lọc (vd: hà nội, đà nẵng)..."
                                           FontSize="11"
                                           Foreground="#94A3B8"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           IsHitTestVisible="False"
                                           Visibility="Visible"/>
                            </Grid>

                            <Button x:Name="btnClearSearch"
                                    Grid.Column="2"
                                    Width="22" Height="22"
                                    Margin="4,0,0,0"
                                    Padding="0"
                                    Background="#F1F5F9"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="BtnClearSearch_Click"
                                    Visibility="Collapsed">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Foreground="#64748B"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 2. DANH SÁCH CÁC MỤC (LISTBOX) -->
                    <ListBox x:Name="lstItems"
                             Grid.Row="1"
                             MinHeight="180"
                             MaxHeight="260"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionMode="Single"
                             KeyDown="LstItems_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ListBoxItem_PreviewMouseLeftButtonUp"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}"
                                                    BorderThickness="0,0,0,1"
                                                    BorderBrush="#F1F5F9">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#F1F5F9"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#E0F2FE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon ga -->
                                    <ui:SymbolIcon Symbol="Location24"
                                                   FontSize="12"
                                                   Foreground="#003B73"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>

                                    <!-- Tên ga -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayText}"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               Foreground="#1E293B"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Badge Lý trình / Mã phụ -->
                                    <Border Grid.Column="2"
                                            Background="#F1F5F9"
                                            CornerRadius="3"
                                            Padding="4,1"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding SubTextVisibility}">
                                        <TextBlock Text="{Binding SubText}"
                                                   FontSize="9.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#64748B"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state nếu không tìm thấy -->
                    <TextBlock x:Name="txtEmptyState"
                               Grid.Row="1"
                               Text="Không tìm thấy mục phù hợp"
                               Foreground="#94A3B8"
                               FontSize="11"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,20"
                               Visibility="Collapsed"/>

                    <!-- 3. FOOTER ĐẾM SỐ LƯỢNG KẾT QUẢ -->
                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,1,0,0"
                            Padding="8,4"
                            CornerRadius="0,0,5,5">
                        <Grid>
                            <TextBlock x:Name="txtResultCount"
                                       Text="27 mục khả dụng"
                                       FontSize="9.5"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Dùng ↑ ↓ và Enter để chọn"
                                       FontSize="9.5"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
