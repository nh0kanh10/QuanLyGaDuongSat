<UserControl x:Class="GUI.Views.UserControls.InspectorHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <Border Background="#F8FAFC" 
            BorderBrush="#E2E8F0" 
            BorderThickness="0,0,0,1" 
            Padding="14,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Biểu tượng -->
            <Border Grid.Column="0" 
                    Width="28" Height="28" 
                    Background="#F1F5F9" 
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="3" 
                    Margin="0,0,10,0">
                <ui:SymbolIcon x:Name="iconHeader" Symbol="Location24" 
                               FontSize="14" Foreground="#003B73"/>
            </Border>

            <!-- Tiêu đề -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="txtTitle" 
                           Text="CHI TIẾT GA" 
                           FontSize="12" 
                           FontWeight="Bold" 
                           Foreground="#003B73"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="txtSubtitle" 
                           Text="Chọn một ga từ danh sách để xem và chỉnh sửa" 
                           FontSize="11" 
                           Foreground="#64748B" 
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="badgeContainer"
                        CornerRadius="3" 
                        Padding="7,2" 
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Background="#F1F5F9"
                        BorderThickness="1"
                        BorderBrush="#CBD5E1"
                        Cursor="Hand"
                        MouseLeftButtonUp="BadgeContainer_MouseLeftButtonUp"
                        ToolTip="Nhấp để sao chép mã kỹ thuật ga">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="10" Foreground="#64748B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtBadge" 
                                   Text="MÃ #" 
                                   FontSize="10.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="#475569"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button x:Name="btnMoreActions" Click="BtnMoreActions_Click" 
                        Height="26" Width="28" Padding="0" Style="{StaticResource DesktopButton}"
                        ToolTip="Tùy chọn tác vụ nâng cao">
                    <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14" Foreground="#475569"/>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ctxHeaderActions" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1">
                            <MenuItem x:Name="menuItemXoaGa" Header="Xóa vĩnh viễn ga này..." Click="BtnXoaGa_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#DC2626"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
