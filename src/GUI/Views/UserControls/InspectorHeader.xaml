<UserControl x:Class="GUI.Views.UserControls.InspectorHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <Border Background="#F8FAFC" 
            BorderBrush="#E2E8F0" 
            BorderThickness="0,0,0,1" 
            Padding="14,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Biểu tượng -->
            <Border Grid.Column="0" 
                    Width="28" Height="28" 
                    Background="#F1F5F9" 
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="3" 
                    Margin="0,0,10,0">
                <ui:SymbolIcon x:Name="iconHeader" Symbol="Location24" 
                               FontSize="14" Foreground="#003B73"/>
            </Border>

            <!-- Tiêu đề -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="txtTitle" 
                           Text="CHI TIẾT GA" 
                           FontSize="12" 
                           FontWeight="Bold" 
                           Foreground="#003B73"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="txtSubtitle" 
                           Text="Chọn một ga từ danh sách để xem và chỉnh sửa" 
                           FontSize="11" 
                           Foreground="#64748B" 
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Trạng thái / ID -->
            <Border Grid.Column="2" 
                    x:Name="badgeContainer"
                    CornerRadius="2" 
                    Padding="8,2" 
                    VerticalAlignment="Center"
                    Background="#F1F5F9"
                    BorderThickness="1"
                    BorderBrush="#CBD5E1">
                <TextBlock x:Name="txtBadge" 
                           Text="ID: #" 
                           FontSize="10" 
                           FontWeight="SemiBold" 
                           Foreground="#475569"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
