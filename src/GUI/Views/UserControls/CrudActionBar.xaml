<UserControl x:Class="GUI.Views.UserControls.CrudActionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Border Background="#F8FAFC" 
            BorderBrush="#CBD5E1" 
            BorderThickness="0,1,0,0" 
            Padding="14,10">
        <StackPanel>
            <!-- Nút Lưu và Hủy -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="btnLuu" 
                        Click="BtnLuu_Click" 
                        Style="{StaticResource PrimaryDesktopButton}"
                        HorizontalAlignment="Stretch"
                        Height="32"
                        ToolTip="Phím tắt: Ctrl + S">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon x:Name="iconLuu" Symbol="Save24" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock x:Name="txtLuu" Text="Lưu Thay Đổi" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" 
                        x:Name="btnHuy" 
                        Click="BtnHuy_Click" 
                        Style="{StaticResource DesktopButton}"
                        Height="32"
                        Padding="14,0"
                        ToolTip="Hủy các thay đổi chưa lưu (Phím tắt: Esc)">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Margin="0,0,5,0" Foreground="#64748B"/>
                        <TextBlock Text="Hủy Bỏ" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Nút Xóa -->
            <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                <Button x:Name="btnXoa" 
                        Click="BtnXoa_Click" 
                        Style="{StaticResource DangerDesktopButton}"
                        HorizontalAlignment="Stretch"
                        Height="28"
                        ToolTip="Xóa vĩnh viễn ga này khỏi cơ sở dữ liệu">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="12" Margin="0,0,6,0" Foreground="#B91C1C"/>
                        <TextBlock Text="Xóa ga" FontWeight="SemiBold" FontSize="11"/>
                    </StackPanel>
                </Button>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
