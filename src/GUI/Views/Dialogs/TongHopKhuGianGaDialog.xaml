<Window x:Class="GUI.Views.Dialogs.TongHopKhuGianGaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Tổng Hợp Hạ Tầng Khu Gian Liền Kề"
        Width="820" Height="590"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#FFFFFF" 
            BorderBrush="#003B73" 
            BorderThickness="1.5" 
            CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>

            <!-- 1. Header sắc sảo màu Xanh Hải Quân VNR -->
            <Border Grid.Row="0" Background="#003B73" CornerRadius="3,3,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="16" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtTitleHeader" Text="TỔNG HỢP HẠ TẦNG 2 KHU GIAN KẾT NỐI LIỀN KỀ" 
                                   Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Click="BtnDong_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="26" Height="26" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="✕" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Thân nội dung tổng hợp trực quan -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                <StackPanel>
                    <!-- A. Header Ga Trung Tâm & Sơ Đồ Hành Trình Trực Quan -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="txtGaTrungTam" Text="GA GIÁP BÁT (GB)" FontSize="15" FontWeight="Bold" Foreground="#003B73"/>
                                    <TextBlock x:Name="txtMoTaGaTrungTam" Text="Lý trình Km 5.00 — Tuyến Hà Nội - Sài Gòn (Đường Sắt Thống Nhất)" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="3" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtTongKhuGianBadge" Text="2 KHU GIAN KẾT NỐI" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>
                                </Border>
                            </Grid>

                            <!-- Sơ đồ đường chạy tàu liên kết trực quan (Visual Corridor) -->
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Ga Liền Kề Bắc -->
                                        <ColumnDefinition Width="150"/>
                                        <!-- Ray nối Bắc -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Ga Hiện Tại -->
                                        <ColumnDefinition Width="180"/>
                                        <!-- Ray nối Nam -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Ga Liền Kề Nam -->
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Box Ga Bắc -->
                                    <Border Grid.Column="0" x:Name="bdVisualGaBac" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="6,4" VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="PHÍA BẮC (HÀ NỘI)" FontSize="8" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="txtVisualGaBacTen" Text="Ga Hà Nội" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="txtVisualGaBacKm" Text="Km 0.00" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Đường ray nối Bắc (Visual Corridor) -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                        <Rectangle x:Name="rectRayBac" Height="4" Fill="#047857" RadiusX="2" RadiusY="2"/>
                                        <Border x:Name="bdRayBacBadge" Background="#FFFFFF" BorderBrush="#047857" BorderThickness="1.5" CornerRadius="3" Padding="5,1" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="txtRayBacDot" Text="●" FontSize="7" Foreground="#047857" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                <TextBlock x:Name="txtVisualCulyBac" Text="5.00 km" FontSize="9" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Box Ga Trung Tâm -->
                                    <Border Grid.Column="2" Background="#003B73" CornerRadius="3" Padding="8,5" VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="★ GA HIỆN TẠI" FontSize="8" FontWeight="Bold" Foreground="#93C5FD" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="txtVisualGaHienTaiTen" Text="GA GIÁP BÁT" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="txtVisualGaHienTaiKm" Text="Km 5.00" FontSize="9" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Đường ray nối Nam (Visual Corridor) -->
                                    <Grid Grid.Column="3" VerticalAlignment="Center" Margin="4,0">
                                        <Rectangle x:Name="rectRayNam" Height="4" Fill="#047857" RadiusX="2" RadiusY="2"/>
                                        <Border x:Name="bdRayNamBadge" Background="#FFFFFF" BorderBrush="#047857" BorderThickness="1.5" CornerRadius="3" Padding="5,1" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="txtRayNamDot" Text="●" FontSize="7" Foreground="#047857" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                <TextBlock x:Name="txtVisualCulyNam" Text="51.00 km" FontSize="9" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Box Ga Nam -->
                                    <Border Grid.Column="4" x:Name="bdVisualGaNam" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="6,4" VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="PHÍA NAM (SÀI GÒN)" FontSize="8" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="txtVisualGaNamTen" Text="Ga Phủ Lý" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="txtVisualGaNamKm" Text="Km 56.00" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- B. 2 Khối Thẻ So Sánh Chi Tiết 2 Khu Gian Song Song -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CỘT 1: KHU GIAN PHÍA BẮC -->
                        <Border Grid.Column="0" x:Name="bdCardKhuGianBac" Background="#FFFFFF" BorderBrush="#047857" BorderThickness="2,1,1,1" CornerRadius="3" Padding="12,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Border Background="#E0E7FF" CornerRadius="2" Padding="5,1" HorizontalAlignment="Left" Margin="0,0,0,4">
                                            <TextBlock Text="KHU GIAN PHÍA BẮC" FontSize="9" FontWeight="Bold" Foreground="#003B73"/>
                                        </Border>
                                        <TextBlock x:Name="txtTenKhuGianBac" Text="Hà Nội ↔ Giáp Bát" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" x:Name="bdStatusKhuGianBac" Background="#047857" BorderBrush="#065F46" BorderThickness="1" CornerRadius="2" Padding="7,2" VerticalAlignment="Top">
                                        <TextBlock x:Name="txtStatusKhuGianBac" Text="THÔNG ĐƯỜNG" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                </Grid>

                                <!-- Bảng chỉ số kỹ thuật Bắc -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="22"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Cự ly phân đoạn:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtCulyBac" Text="5.00 km" FontSize="10" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vmax Khách / Hàng:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtVmaxBac" Text="60 km/h / 40 km/h" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Độ dốc dọc lớn nhất:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtDoDocBac" Text="0.0 ‰" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Máy đẩy vượt dốc:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtMayDayBac" Text="Không yêu cầu" FontSize="10" FontWeight="Normal" Foreground="#475569" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Đường ngang:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtDuongNgangBac" Text="Không có giao cắt (An toàn)" FontSize="10" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="txtGhiChuBac" Text="Phân đoạn kết nối trung tâm vận tải ga Hà Nội và ga hàng hóa Giáp Bát."
                                           FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- CỘT 2: KHU GIAN PHÍA NAM -->
                        <Border Grid.Column="2" x:Name="bdCardKhuGianNam" Background="#FFFFFF" BorderBrush="#047857" BorderThickness="2,1,1,1" CornerRadius="3" Padding="12,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Border Background="#FEF3C7" CornerRadius="2" Padding="5,1" HorizontalAlignment="Left" Margin="0,0,0,4">
                                            <TextBlock Text="KHU GIAN PHÍA NAM" FontSize="9" FontWeight="Bold" Foreground="#B45309"/>
                                        </Border>
                                        <TextBlock x:Name="txtTenKhuGianNam" Text="Giáp Bát ↔ Phủ Lý" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" x:Name="bdStatusKhuGianNam" Background="#047857" BorderBrush="#065F46" BorderThickness="1" CornerRadius="2" Padding="7,2" VerticalAlignment="Top">
                                        <TextBlock x:Name="txtStatusKhuGianNam" Text="THÔNG ĐƯỜNG" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                </Grid>

                                <!-- Bảng chỉ số kỹ thuật Nam -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="22"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Cự ly phân đoạn:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtCulyNam" Text="51.00 km" FontSize="10" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vmax Khách / Hàng:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtVmaxNam" Text="80 km/h / 50 km/h" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Độ dốc dọc lớn nhất:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtDoDocNam" Text="0.0 ‰" FontSize="10" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Máy đẩy vượt dốc:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtMayDayNam" Text="Không yêu cầu" FontSize="10" FontWeight="Normal" Foreground="#475569" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Đường ngang:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtDuongNgangNam" Text="Không có giao cắt (An toàn)" FontSize="10" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="txtGhiChuNam" Text="Phân đoạn đi qua khu vực đồng bằng sông Hồng, tốc độ khai thác tiêu chuẩn 80 km/h."
                                           FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- C. Khuyến cáo an toàn đường đơn -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="10,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="14" Foreground="#003B73" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Quy chuẩn khai thác đường sắt đơn: Mỗi phân đoạn khu gian chỉ cho phép 1 đoàn tàu chiếm dụng. Tuyệt đối không gửi tàu khi chưa nhận tín hiệu xin đường và chấp nhận từ ga đối diện."
                                       FontSize="10" Foreground="#475569" FontStyle="Italic" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer hành động -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,3,3" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Button Click="BtnMoPhanHeKhuGian_Click" HorizontalAlignment="Left"
                            Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1"
                            Padding="12,6" Cursor="Hand" ToolTip="Chuyển hẳn sang phân hệ Khu Gian để chỉnh sửa nâng cao">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Open24" FontSize="12" Foreground="#003B73" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Mở Phân Hệ Khu Gian Chi Tiết" FontSize="11" FontWeight="SemiBold" Foreground="#003B73"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnDong_Click" HorizontalAlignment="Right"
                            Background="#003B73" Foreground="#FFFFFF" BorderThickness="0"
                            Padding="22,6" Cursor="Hand" FontWeight="Bold" FontSize="11">
                        <TextBlock Text="Đóng (Esc)"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
