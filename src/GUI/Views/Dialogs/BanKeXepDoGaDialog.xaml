<Window x:Class="GUI.Views.Dialogs.BanKeXepDoGaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Bản Kê Tác Nghiệp Xếp Dỡ Hàng Hóa Tại Ga"
        Width="1020"
        Height="780"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="12">
        <Border Background="#FFFFFF" 
                BorderBrush="#003B73" 
                BorderThickness="1.5" 
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="28" ShadowDepth="6" Opacity="0.3"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>      <!-- 1. Header Bar -->
                    <RowDefinition Height="Auto"/>    <!-- 2. Thanh lọc điều kiện tác nghiệp -->
                    <RowDefinition Height="*"/>       <!-- 3. Khu vực bản in tài liệu A4 -->
                    <RowDefinition Height="Auto"/>    <!-- 4. Footer Action -->
                </Grid.RowDefinitions>

                <!-- 1. HEADER BAR -->
                <Grid Grid.Row="0" Background="#003B73" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                    <Border CornerRadius="7,7,0,0" Background="#003B73"/>
                    <Grid Margin="16,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="16" Foreground="#38BDF8" Margin="0,0,8,0"/>
                            <TextBlock Text="BẢN KÊ TÁC NGHIỆP XẾP DỠ HÀNG HÓA TẠI GA - VIETNAM RAILWAYS" 
                                       FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>

                        <Button Grid.Column="1" Click="BtnDong_Click" Width="28" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="#FFFFFF"/>
                        </Button>
                    </Grid>
                </Grid>

                <!-- 2. THANH LỌC ĐIỀU KIỆN TÁC NGHIỆP TẠI GA -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Chọn Ga tác nghiệp -->
                        <TextBlock Grid.Column="0" Text="Ga tác nghiệp:" FontWeight="SemiBold" Foreground="#003B73" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" x:Name="cboGaTacNghiep" Height="30" FontSize="11.5"
                                  DisplayMemberPath="TenGa" SelectedValuePath="MaGa"
                                  SelectionChanged="CboGaTacNghiep_SelectionChanged"/>

                        <!-- Chọn Ngày tác nghiệp -->
                        <TextBlock Grid.Column="3" Text="Ngày tác nghiệp:" FontWeight="SemiBold" Foreground="#003B73" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker Grid.Column="4" x:Name="dpNgayTacNghiep" Height="30" FontSize="11.5"
                                    SelectedDateChanged="DpNgayTacNghiep_SelectedDateChanged"/>

                        <!-- Chế độ xem lọc -->
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="radXemTatCa" Content="Tất cả (Hai chiều)" IsChecked="True" 
                                         FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,12,0"
                                         Click="RadCheDoXem_Click"/>
                            <RadioButton x:Name="radXemDoXuong" Content="Hàng dỡ xuống (Đến)" 
                                         FontSize="11" FontWeight="SemiBold" Foreground="#003B73" Margin="0,0,12,0"
                                         Click="RadCheDoXem_Click"/>
                            <RadioButton x:Name="radXemXepLen" Content="Hàng xếp lên (Đi)" 
                                         FontSize="11" FontWeight="SemiBold" Foreground="#0284C7"
                                         Click="RadCheDoXem_Click"/>
                        </StackPanel>

                        <!-- Nút Tải lại -->
                        <Button Grid.Column="7" Click="BtnLamMoi_Click" Style="{StaticResource DesktopButton}" Height="30" Padding="10,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowCounterclockwise24" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="Tải Lại" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 3. KHU VỰC BẢN IN TÀI LIỆU A4 (PRINTABLE AREA) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#F1F5F9" Padding="16">
                    <Border x:Name="bdInBanKe" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="24" MaxWidth="960">
                        <StackPanel>
                            <!-- Header biểu mẫu chính quy VNR -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Đơn vị quản lý bên trái -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TỔNG CÔNG TY ĐƯỜNG SẮT VIỆT NAM (VNR)" FontSize="12" FontWeight="Bold" Foreground="#003B73"/>
                                    <TextBlock Text="CÔNG TY CỔ PHẦN VẬN TẢI ĐƯỜNG SẮT" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="txtTieuDeGaHienTai" Text="TRỰC BAN BÃI HÀNG GA: GIÁP BÁT" FontSize="11.5" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Mẫu số bên phải -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="MẪU SỐ: 02/BK-XDHH" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                    <TextBlock Text="Ban hành kèm theo Quyết định số 189/QĐ-ĐS" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="txtNgayInHienTai" Text="Ngày tác nghiệp: 16/11/2026" FontSize="10.5" FontWeight="SemiBold" Foreground="#003B73" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Tiêu đề bản kê -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,4,0,18">
                                <TextBlock Text="BẢN KÊ TÁC NGHIỆP XẾP DỠ HÀNG HÓA TẠI GA" 
                                           FontSize="16" FontWeight="Black" Foreground="#003B73" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="txtPhuDeBanKe" Text="KẾ HOẠCH BÀN GIAO &amp; THEO DÕI HIỆN TRƯỜNG XẾP DỠ HAI CHIỀU (ĐẾN / ĐI)" 
                                           FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- ========================================================================= -->
                            <!-- PHẦN I. DANH SÁCH HÀNG DỠ XUỐNG TẠI GA (HÀNG ĐẾN GIAO TRẢ KHÁCH)          -->
                            <!-- ========================================================================= -->
                            <Border x:Name="pnlPhan1DoXuong" Margin="0,0,0,20">
                                <StackPanel>
                                    <!-- Tiêu đề Phần 1 -->
                                    <Border Background="#F1F5F9" BorderBrush="#003B73" BorderThickness="3,0,0,0" Padding="8,4" Margin="0,0,0,6">
                                        <Grid>
                                            <TextBlock Text="I. DANH SÁCH HÀNG DỠ XUỐNG TẠI GA (HÀNG ĐẾN - UNLOADING MANIFEST)" 
                                                       FontSize="11.5" FontWeight="Bold" Foreground="#003B73" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtThongKeDoXuong" Text="Tổng số: 0 vận đơn (0.00 tấn)" 
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="#0284C7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Bảng danh sách hàng dỡ xuống -->
                                    <DataGrid x:Name="dgHangDoXuong" AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                                              BorderBrush="#CBD5E1" BorderThickness="1" Background="#FFFFFF"
                                              GridLinesVisibility="All" HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#F8FAFC"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="10.5"/>
                                                <Setter Property="Padding" Value="6,4"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="35"/>
                                            <DataGridTextColumn Header="Mã Vận Đơn" Binding="{Binding MaVanDonCode}" Width="135">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="#003B73"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Tàu &amp; Giờ Đến" Binding="{Binding ThongTinTauGio}" Width="120">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#0F172A"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Ga Gửi Đi" Binding="{Binding TenGaGui}" Width="90"/>
                                            <DataGridTextColumn Header="Mặt Hàng &amp; Quy Cách" Binding="{Binding MatHangVaDacThu}" Width="180"/>
                                            <DataGridTextColumn Header="Trọng Lượng" Binding="{Binding TrongLuongHienThi}" Width="85">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="FontFamily" Value="Consolas"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Người Nhận &amp; SĐT" Binding="{Binding NguoiNhanVaSdt}" Width="150"/>
                                            <DataGridTextColumn Header="Vị Trí Dỡ / Kho" Binding="{Binding ViTriKhoBai}" Width="95"/>
                                            <DataGridTextColumn Header="Ký Kiểm Đếm" Binding="{Binding OChecklistKiemDem}" Width="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- ========================================================================= -->
                            <!-- PHẦN II. DANH SÁCH HÀNG XẾP LÊN TÀU TẠI GA (HÀNG NHẬN GỬI ĐI)             -->
                            <!-- ========================================================================= -->
                            <Border x:Name="pnlPhan2XepLen" Margin="0,0,0,24">
                                <StackPanel>
                                    <!-- Tiêu đề Phần 2 -->
                                    <Border Background="#F1F5F9" BorderBrush="#0284C7" BorderThickness="3,0,0,0" Padding="8,4" Margin="0,0,0,6">
                                        <Grid>
                                            <TextBlock Text="II. DANH SÁCH HÀNG XẾP LÊN TÀU TẠI GA (HÀNG ĐI - LOADING MANIFEST)" 
                                                       FontSize="11.5" FontWeight="Bold" Foreground="#003B73" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txtThongKeXepLen" Text="Tổng số: 0 vận đơn (0.00 tấn)" 
                                                       FontSize="10.5" FontWeight="SemiBold" Foreground="#0284C7" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Bảng danh sách hàng xếp lên -->
                                    <DataGrid x:Name="dgHangXepLen" AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column"
                                              BorderBrush="#CBD5E1" BorderThickness="1" Background="#FFFFFF"
                                              GridLinesVisibility="All" HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="#E2E8F0">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#F8FAFC"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="10.5"/>
                                                <Setter Property="Padding" Value="6,4"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="35"/>
                                            <DataGridTextColumn Header="Mã Vận Đơn" Binding="{Binding MaVanDonCode}" Width="135">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="#003B73"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Tàu &amp; Giờ Chạy" Binding="{Binding ThongTinTauGio}" Width="120">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#0F172A"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Ga Nhận Đích" Binding="{Binding TenGaNhan}" Width="90"/>
                                            <DataGridTextColumn Header="Mặt Hàng &amp; Quy Cách" Binding="{Binding MatHangVaDacThu}" Width="180"/>
                                            <DataGridTextColumn Header="Trọng Lượng" Binding="{Binding TrongLuongHienThi}" Width="85">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="FontFamily" Value="Consolas"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Người Gửi &amp; SĐT" Binding="{Binding NguoiGuiVaSdt}" Width="150"/>
                                            <DataGridTextColumn Header="Toa Xe Dự Kiến" Binding="{Binding ToaXeDuKien}" Width="95"/>
                                            <DataGridTextColumn Header="Ký Xếp Toa" Binding="{Binding OChecklistKiemDem}" Width="80">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Khối chữ ký xác nhận 3 bên -->
                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Cột 1: Trực ban bãi dồn -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="TRỰC BAN BÃI DỒN GA" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="(Ký, ghi rõ họ tên)" FontSize="9.5" FontStyle="Italic" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    <Border Height="55"/>
                                    <TextBlock Text="........................................." FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Cột 2: Thủ kho hàng hóa -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="THỦ KHO HÀNG HÓA" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="(Ký, ghi rõ họ tên)" FontSize="9.5" FontStyle="Italic" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    <Border Height="55"/>
                                    <TextBlock Text="........................................." FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Cột 3: Trưởng tàu nhận bàn giao -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="TRƯỞNG TÀU / ÁP TẢI" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="(Ký nhận niêm phong chì)" FontSize="9.5" FontStyle="Italic" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    <Border Height="55"/>
                                    <TextBlock Text="........................................." FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- 4. FOOTER ACTION BAR -->
                <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="#0284C7" Margin="0,0,6,0"/>
                            <TextBlock Text="Bản kê xuất theo chuẩn A4 phục vụ kiểm đếm hiện trường bãi hàng ga. Nhấn phím F8 hoặc Ctrl+P để in."
                                       FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Click="BtnInBanKe_Click" Style="{StaticResource PrimaryDesktopButton}" Height="32" Padding="16,0" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Print24" FontSize="13" Margin="0,0,6,0" Foreground="#FFFFFF"/>
                                    <TextBlock Text="In Bản Kê (F8 / Ctrl+P)" FontSize="11.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Click="BtnDong_Click" Style="{StaticResource DesktopButton}" Height="32" Padding="14,0">
                                <TextBlock Text="Đóng (Esc)" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
