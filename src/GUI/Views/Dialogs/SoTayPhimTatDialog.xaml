<Window x:Class="GUI.Views.Dialogs.SoTayPhimTatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Sổ Tay Phím Tắt Tác Nghiệp"
        Width="960"
        Height="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Border x:Name="bdWindowBorder"
                Background="#FFFFFF" 
                BorderBrush="#002855" 
                BorderThickness="1.5" 
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="32" ShadowDepth="8" Opacity="0.38"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- 0. Header -->
                    <RowDefinition Height="50"/>
                    <!-- 1. Single-Row Segmented Tab Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2. Main Content Cards List -->
                    <RowDefinition Height="*"/>
                    <!-- 3. Footer Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 0. Header -->
                <Grid Grid.Row="0" 
                      x:Name="gridHeader"
                      Background="#003B73" 
                      MouseLeftButtonDown="Header_MouseLeftButtonDown"
                      Cursor="SizeAll">
                    <Border CornerRadius="7,7,0,0" Background="{Binding Background, ElementName=gridHeader}"/>
                    
                    <Grid Margin="18,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#0F172A" CornerRadius="5" Padding="8,4" Margin="0,0,12,0" BorderBrush="#38BDF8" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Keyboard24" FontSize="13" Foreground="#38BDF8" Margin="0,0,5,0"/>
                                    <TextBlock Text="F1" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SỔ TAY PHÍM TẮT TÁC NGHIỆP — VNR OCC ENTERPRISE" 
                                           FontSize="13.5" 
                                           FontWeight="Bold" 
                                           Foreground="#FFFFFF"/>
                                <TextBlock Text="Bảng tra cứu phím tắt công nghiệp &amp; thao tác nhanh tự động thích ứng ngữ cảnh tác nghiệp" 
                                           FontSize="11" 
                                           Foreground="#93C5FD" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Click="BtnDong_Click"
                                Width="32" Height="32"
                                Background="Transparent" 
                                BorderThickness="0" 
                                Cursor="Hand"
                                ToolTip="Đóng cửa sổ (Esc)">
                            <TextBlock Text="✕" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Grid>

                <!-- 1. Single-Row Segmented Tab Bar -->
                <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="14,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Clean Single-Row Buttons Strip with Vector SymbolIcons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnTabGa" Click="TabFilter_Click" Tag="MangLuoiGa" Margin="0,0,6,0" Padding="12,6" Background="#E2E8F0" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="icoTabGa" Symbol="VehicleSubway24" FontSize="14" Foreground="#334155" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="txtTabGa" Text="Mạng Lưới Ga" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnTabKhuGian" Click="TabFilter_Click" Tag="KhuGian" Margin="0,0,6,0" Padding="12,6" Background="#E2E8F0" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="icoTabKhuGian" Symbol="ArrowSwap24" FontSize="14" Foreground="#334155" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="txtTabKhuGian" Text="Khu Gian" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnTabLichTrinh" Click="TabFilter_Click" Tag="LichTrinh" Margin="0,0,6,0" Padding="12,6" Background="#E2E8F0" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="icoTabLichTrinh" Symbol="CalendarClock24" FontSize="14" Foreground="#334155" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="txtTabLichTrinh" Text="Lịch Trình Tàu" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnTabBanVe" Click="TabFilter_Click" Tag="BanVe" Margin="0,0,6,0" Padding="12,6" Background="#E2E8F0" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="icoTabBanVe" Symbol="TicketDiagonal24" FontSize="14" Foreground="#334155" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="txtTabBanVe" Text="Bán Vé" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnTabHangHoa" Click="TabFilter_Click" Tag="HangHoa" Margin="0,0,6,0" Padding="12,6" Background="#E2E8F0" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="icoTabHangHoa" Symbol="Box24" FontSize="14" Foreground="#334155" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="txtTabHangHoa" Text="Hàng Hóa" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnTabTatCa" Click="TabFilter_Click" Tag="ALL" Margin="0,0,6,0" Padding="12,6" Background="#E2E8F0" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="icoTabTatCa" Symbol="Apps24" FontSize="14" Foreground="#334155" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="txtTabTatCa" Text="Toàn Bộ" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Context Indicator Badge -->
                        <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtCurrentModuleBadge" Text="Đang tác nghiệp: Vận Tải Hàng Hóa" FontSize="11.5" FontWeight="Bold" Foreground="#065F46"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. Main Content: Shortcut Cards List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="#F8FAFC" Padding="20,16">
                    <StackPanel>
                        <!-- Section 1: Module Specific Shortcuts Header -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="txtSectionTitle" Text="PHÍM TẮT ĐẶC THÙ PHÂN HỆ" FontSize="12" FontWeight="Bold" Foreground="#003B73" Grid.Column="0" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="1" Height="1" Fill="#CBD5E1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Dynamic Items Container for Module-Specific Shortcuts -->
                        <ItemsControl x:Name="icPhanHeShortcuts">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,11" Margin="0,0,0,9">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#64748B" BlurRadius="5" ShadowDepth="1" Opacity="0.08"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Raised Keycap Badge -->
                                            <Border Grid.Column="0" 
                                                    Background="{Binding MauKeycapBrush}" 
                                                    BorderBrush="{Binding MauKeycapBorderBrush}" 
                                                    BorderThickness="1.5" 
                                                    CornerRadius="5" 
                                                    Padding="10,5" 
                                                    HorizontalAlignment="Left" 
                                                    VerticalAlignment="Center" 
                                                    MinWidth="54">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1.5" Opacity="0.25"/>
                                                </Border.Effect>
                                                <TextBlock Text="{Binding Phim}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Action Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,16,0">
                                                <TextBlock Text="{Binding TenTacNghiep}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding MoTa}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="17"/>
                                            </StackPanel>

                                            <!-- Tag / Scope Badge -->
                                            <Border Grid.Column="2" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="9,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TagNhan}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Section 2: Global Shortcuts Header -->
                        <Grid Margin="0,14,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PHÍM TẮT ĐIỀU HÀNH TOÀN HỆ THỐNG" FontSize="12" FontWeight="Bold" Foreground="#475569" Grid.Column="0" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="1" Height="1" Fill="#CBD5E1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Global Shortcuts Items -->
                        <ItemsControl x:Name="icToanCucShortcuts">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,11" Margin="0,0,0,9">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#64748B" BlurRadius="5" ShadowDepth="1" Opacity="0.08"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Raised Keycap Badge -->
                                            <Border Grid.Column="0" 
                                                    Background="{Binding MauKeycapBrush}" 
                                                    BorderBrush="{Binding MauKeycapBorderBrush}" 
                                                    BorderThickness="1.5" 
                                                    CornerRadius="5" 
                                                    Padding="10,5" 
                                                    HorizontalAlignment="Left" 
                                                    VerticalAlignment="Center" 
                                                    MinWidth="54">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1.5" Opacity="0.25"/>
                                                </Border.Effect>
                                                <TextBlock Text="{Binding Phim}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Action Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,16,0">
                                                <TextBlock Text="{Binding TenTacNghiep}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding MoTa}" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="17"/>
                                            </StackPanel>

                                            <!-- Tag / Scope Badge -->
                                            <Border Grid.Column="2" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="9,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TagNhan}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. Footer Bar -->
                <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Lightbulb24" FontSize="15" Foreground="#D97706" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Mẹo tác nghiệp: Bạn có thể nhấn phím vật lý trên bàn phím hoặc click trực tiếp vào dải nút phím tắt ở thanh công cụ dưới đáy." 
                                       FontSize="11.5" 
                                       Foreground="#475569" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Click="BtnDong_Click" 
                                Padding="24,7" 
                                Background="#003B73" 
                                BorderThickness="0" 
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="Đã Hiểu (Esc)" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
