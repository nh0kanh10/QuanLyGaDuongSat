<Window x:Class="GUI.Views.Dialogs.DangNhapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Đăng Nhập — Hệ Thống Điều Hành Vận Tải Đường Sắt"
        Width="760" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="Segoe UI, sans-serif"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUI;component/Resources/Styles/KyThuatDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource KtDialogKhung}" Margin="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- BÊN TRÁI: NHẬN DIỆN HỆ THỐNG (kéo cửa sổ) -->
            <Border Grid.Column="0" Background="#002855" CornerRadius="3,0,0,3" Padding="26,26,22,22"
                    MouseLeftButtonDown="KeoCuaSo_MouseLeftButtonDown">
                <DockPanel LastChildFill="False">
                    <Border DockPanel.Dock="Top" Background="#FFFFFF" CornerRadius="3" Padding="8,4" HorizontalAlignment="Left">
                        <Image Source="/Resources/Images/logo_dsvn.png" Height="30" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Margin="0,22,0,0" Text="HỆ THỐNG ĐIỀU HÀNH &amp; QUẢN LÝ VẬN TẢI"
                               Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock DockPanel.Dock="Top" Margin="0,4,0,0" Text="Tuyến đường sắt Thống Nhất Bắc – Nam"
                               Foreground="#93C5FD" FontSize="12"/>
                    <StackPanel DockPanel.Dock="Top" Margin="0,22,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="15" Foreground="#38BDF8" Margin="0,0,8,0"/>
                            <TextBlock Text="Mỗi nhân viên một tài khoản riêng" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="15" Foreground="#38BDF8" Margin="0,0,8,0"/>
                            <TextBlock Text="Chỉ thấy phân hệ được cấp quyền" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="History24" FontSize="15" Foreground="#38BDF8" Margin="0,0,8,0"/>
                            <TextBlock Text="Mọi lần đăng nhập đều được ghi lại" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- TRẠNG THÁI & 2 NÚT THIẾT LẬP KẾT NỐI CSDL -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <DockPanel Margin="0,0,0,8">
                            <ui:SymbolIcon x:Name="iconKetNoi" DockPanel.Dock="Left" Symbol="Database24" FontSize="14" Foreground="#38BDF8" Margin="0,1,6,0" VerticalAlignment="Top"/>
                            <TextBlock x:Name="txtKetNoi" Foreground="#94A3B8" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Nút 1: Nhập chuỗi kết nối / Đổi Server -->
                            <Button x:Name="btnNhapChuoiKetNoi" Grid.Column="0" Click="BtnNhapChuoiKetNoi_Click"
                                    Height="30" Padding="4,0" Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1"
                                    Cursor="Hand" ToolTip="Mở hộp thoại nhập chuỗi kết nối hoặc chọn máy chủ SQL Server và lưu cấu hình">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="12" Foreground="#38BDF8" Margin="0,0,4,0"/>
                                    <TextBlock Text="Chuỗi kết nối" FontSize="11" Foreground="#F0F9FF" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <!-- Nút 2: Tự lấy file MDF -->
                            <Button x:Name="btnAutoMdf" Grid.Column="2" Click="BtnAutoMdf_Click"
                                    Height="30" Padding="4,0" Background="#065F46" BorderBrush="#059669" BorderThickness="1"
                                    Cursor="Hand" ToolTip="Tự động nhận diện hoặc chọn file CSDL QuanLyDuongSatV2.mdf chạy LocalDB">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="12" Foreground="#34D399" Margin="0,0,4,0"/>
                                    <TextBlock Text="Tự nhận MDF" FontSize="11" Foreground="#ECFDF5" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- BÊN PHẢI: FORM -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="26,18,10,0" MouseLeftButtonDown="KeoCuaSo_MouseLeftButtonDown" Background="Transparent">
                    <StackPanel>
                        <TextBlock Text="ĐĂNG NHẬP" FontSize="18" FontWeight="Bold" Foreground="#003B73"/>
                        <TextBlock Text="Nhập tài khoản được quản trị viên cấp." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource KtNutDong}" Click="BtnThoat_Click" Foreground="#64748B"
                            HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Thoát (Esc)"/>
                </Grid>

                <StackPanel Grid.Row="1" Margin="26,18,26,8">
                    <TextBlock Text="Tên đăng nhập" Style="{StaticResource KtNhanTruong}"/>
                    <TextBox x:Name="txtTenDangNhap" Height="34" FontSize="13" MaxLength="50" Padding="8,0"
                             VerticalContentAlignment="Center" AutomationProperties.Name="Tên đăng nhập"
                             TextChanged="O_ThayDoi"/>

                    <TextBlock Text="Mật khẩu" Style="{StaticResource KtNhanTruong}" Margin="0,12,0,4"/>
                    <PasswordBox x:Name="txtMatKhau" Height="34" FontSize="13" MaxLength="64" Padding="8,0"
                                 VerticalContentAlignment="Center" AutomationProperties.Name="Mật khẩu"
                                 PasswordChanged="O_ThayDoi" KeyUp="MatKhau_KeyUp"/>
                    <TextBlock x:Name="txtCapsLock" Text="Caps Lock đang bật." FontSize="11" Foreground="#B45309"
                               Margin="0,4,0,0" Visibility="Collapsed"/>

                    <!-- NÚT ĐĂNG NHẬP NHANH TÀI KHOẢN TOÀN QUYỀN (ADMIN) -->
                    <Border x:Name="bdDangNhapNhanh" Margin="0,14,0,0" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4">
                        <Button x:Name="btnDangNhapNhanhAdmin" Click="BtnDangNhapNhanhAdmin_Click" 
                                Height="34" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="Đăng nhập ngay với tài khoản Quản trị viên toàn quyền (admin) - Phím tắt F2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Flash24" FontSize="15" Foreground="#16A34A" Margin="0,0,6,0"/>
                                <TextBlock Text="Đăng Nhập Nhanh Toàn Quyền (Admin)" FontWeight="SemiBold" Foreground="#15803D" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border x:Name="bdLoi" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="3"
                            Padding="10,7" Margin="0,12,0,0" Visibility="Collapsed">
                        <DockPanel>
                            <ui:SymbolIcon x:Name="iconLoi" DockPanel.Dock="Left" Symbol="ErrorCircle24" FontSize="15" Foreground="#B91C1C"
                                           Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock x:Name="txtLoi" FontSize="11.5" Foreground="#991B1B" TextWrapping="Wrap"
                                      />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource KtFooter}" CornerRadius="0,0,3,0">
                    <Grid>
                        <TextBlock x:Name="txtGoiY" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,8,0" MaxWidth="170" HorizontalAlignment="Left"
                                   Text="Quên mật khẩu: nhờ quản trị viên đặt lại."/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource DesktopButton}" Height="34" Click="BtnThoat_Click">
                                <TextBlock Text="Thoát"/>
                            </Button>
                            <Button x:Name="btnDangNhap" Style="{StaticResource PrimaryDesktopButton}" Height="34" Margin="0"
                                    IsDefault="True" Click="BtnDangNhap_Click" MinWidth="130">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowEnterLeft24" FontSize="14" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="txtNutDangNhap" Text="Đăng Nhập"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
