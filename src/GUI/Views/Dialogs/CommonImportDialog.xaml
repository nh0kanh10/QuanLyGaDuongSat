<Window x:Class="GUI.Views.Dialogs.CommonImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Nhập Dữ Liệu Hàng Loạt" 
        Height="720" Width="1180"
        MinHeight="550" MinWidth="920"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F1F5F9"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border BorderBrush="#003B73" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/> <!-- Header thanh tiêu đề -->
                <RowDefinition Height="Auto"/> <!-- Thanh công cụ thao tác -->
                <RowDefinition Height="*"/>    <!-- DataGrid xem trước Preview -->
                <RowDefinition Height="Auto"/> <!-- Footer điều khiển & Nút nạp -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Border Grid.Row="0" Background="#003B73" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="18" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                        <TextBlock x:Name="txtHeaderTitle" Text="NHẬP DỮ LIỆU HÀNG LOẠT (IMPORT CSV/EXCEL)" 
                                   FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="BtnDong_Click"
                            Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Đóng (Esc)">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#DC2626"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Thanh công cụ -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nút chọn tệp -->
                    <Button Grid.Column="0" Click="BtnChonTep_Click" 
                            Style="{StaticResource PrimaryDesktopButton}" 
                            Height="32" Padding="14,0" Margin="0,0,8,0"
                            ToolTip="Mở hộp thoại chọn tệp Excel (.xlsx) hoặc CSV chứa danh sách dữ liệu">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                            <TextBlock Text="Chọn Tệp Excel / CSV (.xlsx, .csv)" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút tải tệp mẫu -->
                    <Button Grid.Column="1" Click="BtnTaiMau_Click" 
                            Style="{StaticResource DesktopButton}" 
                            Height="32" Padding="12,0" Margin="0,0,8,0"
                            ToolTip="Tải tệp mẫu Excel (.xlsx) hoặc CSV có cấu trúc chuẩn và ghi chú hướng dẫn">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Foreground="#003B73" Margin="0,0,6,0"/>
                            <TextBlock Text="Tải Tệp Mẫu (.xlsx / .csv)" FontSize="11" FontWeight="SemiBold" Foreground="#003B73"/>
                        </StackPanel>
                    </Button>

                    <!-- Tùy chọn thông minh: Cho phép cập nhật nếu đã tồn tại -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <CheckBox x:Name="chkCapNhat" 
                                  Content="Cho phép cập nhật nếu đã có trong CSDL" 
                                  FontSize="11" FontWeight="SemiBold" Foreground="#334155"
                                  VerticalAlignment="Center"
                                  Checked="ChkCapNhat_Changed" Unchecked="ChkCapNhat_Changed"
                                  ToolTip="Nếu tích chọn: Những bản ghi đã có mã trong CSDL sẽ được cập nhật thông tin mới thay vì báo lỗi trùng lặp"/>
                    </StackPanel>

                    <!-- Thống kê trạng thái đọc tệp (Option 2: Status Dot Badges chuẩn Windows 11 Fluent) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtTongDong" Text="Tổng: 0 dòng" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtHopLe" Text="Hợp lệ: 0" FontSize="11" FontWeight="Bold" Foreground="#1E293B"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="bdCapNhat" Visibility="Collapsed" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#2563EB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtCapNhat" Text="Cập nhật: 0" FontSize="11" FontWeight="Bold" Foreground="#1E40AF"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="#DC2626" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtLoi" Text="Lỗi: 0" FontSize="11" FontWeight="Bold" Foreground="#1E293B"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Bảng Preview xem trước -->
            <Border Grid.Row="2" Background="#FFFFFF" Margin="12,10,12,0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <DataGrid x:Name="dgPreview" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              SelectionMode="Single" 
                              CanUserAddRows="False" 
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              AlternatingRowBackground="#F8FAFC"
                              RowHeight="32">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#003B73"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="BorderBrush" Value="#00274D"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Setter Property="Foreground" Value="#003B73"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <!-- Các cột dữ liệu sẽ được tạo động theo Profile + Cột trạng thái kiểm tra -->
                    </DataGrid>

                    <!-- Placeholder khi chưa chọn tệp -->
                    <StackPanel x:Name="pnlPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="Table24" FontSize="42" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Chưa có dữ liệu xem trước" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nhấn 'Chọn Tệp Excel / CSV' hoặc 'Tải Tệp Mẫu' để bắt đầu" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. Footer điều khiển & Nạp dữ liệu -->
            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,10" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtThongTinNhanDien" Text="Hệ thống tự động nhận diện tiêu đề cột thông minh, loại bỏ dòng tiêu đề và dòng tổng kết." FontSize="11" FontWeight="SemiBold" Foreground="#003B73"/>
                        <TextBlock x:Name="txtHuongDan" Text="Chỉ những dòng Hợp Lệ hoặc Cập Nhật mới được lưu vào CSDL để bảo vệ toàn vẹn dữ liệu." FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Click="BtnDong_Click" 
                            Style="{StaticResource DesktopButton}" 
                            Height="32" Padding="14,0" Margin="0,0,8,0" Content="Đóng"/>

                    <Button Grid.Column="2" x:Name="btnNapVaoCSDL" Click="BtnNapVaoCSDL_Click" 
                            Style="{StaticResource PrimaryDesktopButton}" 
                            Height="32" Padding="16,0" IsEnabled="False"
                            ToolTip="Lưu tất cả các dòng dữ liệu hợp lệ vào Cơ sở dữ liệu">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                            <TextBlock Text="Nạp Vào Cơ Sở Dữ Liệu" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
