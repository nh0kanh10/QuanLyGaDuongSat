<Window x:Class="GUI.Views.Dialogs.PhieuGuiHangDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Phiếu Gửi Hàng Hóa &amp; Biên Nhận Vận Tải VNR"
        Width="680"
        SizeToContent="Height"
        MaxHeight="920"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="16">
        <Border Background="#FFFFFF" 
                BorderBrush="#003B73" 
                BorderThickness="1.5" 
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="30" ShadowDepth="8" Opacity="0.35"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header Bar -->
                <Grid Grid.Row="0" Background="#003B73" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                    <Border CornerRadius="7,7,0,0" Background="#003B73"/>
                    <Grid Margin="16,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Box24" FontSize="16" Foreground="#38BDF8" Margin="0,0,8,0"/>
                            <TextBlock Text="PHIẾU GỬI HÀNG HÓA &amp; BIÊN NHẬN VẬN TẢI - VIETNAM RAILWAYS" 
                                       FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>

                        <Button Grid.Column="1" Click="BtnDong_Click" Width="28" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="#FFFFFF"/>
                        </Button>
                    </Grid>
                </Grid>

                <!-- 2. Scrollable / Printable Body Area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0">
                    <Border x:Name="bdInPhieu" Margin="20,16,20,16" Padding="20" Background="#FFFFFF" 
                            BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <!-- Header Đơn Vị & Mẫu Số -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TỔNG CÔNG TY ĐƯỜNG SẮT VIỆT NAM (VNR)" FontSize="12" FontWeight="ExtraBold" Foreground="#003B73"/>
                                    <TextBlock Text="CÔNG TY CỔ PHẦN VẬN TẢI ĐƯỜNG SẮT" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,2,0,0"/>
                                    <TextBlock Text="Trung tâm Điều hành Vận tải Hàng hóa Quốc gia" FontSize="10" Foreground="#64748B"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <Border Background="#F0F9FF" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="MÃ VẬN ĐƠN: " FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                                            <TextBlock x:Name="txtMaVanDonCode" Text="VD_CONT_SAMSUNG" FontFamily="Consolas" FontSize="12" FontWeight="ExtraBold" Foreground="#0284C7"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Mẫu số: 01/VTĐS-2026 • Ký hiệu: VNR-HH" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Tiêu đề chứng từ -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,4,0,14">
                                <TextBlock Text="PHIẾU GỬI HÀNG HÓA &amp; BIÊN NHẬN VẬN TẢI" 
                                           FontSize="17" FontWeight="ExtraBold" Foreground="#003B73" HorizontalAlignment="Center"/>
                                <TextBlock Text="(Hóa đơn kiêm chứng từ giao nhận hàng hóa đường sắt - Liên 1: Lưu trạm &amp; Giao khách)" 
                                           FontSize="10.5" FontStyle="Italic" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <Rectangle Height="2" Width="180" Fill="#0284C7" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Thẻ Hành Trình Tuyến Ga -->
                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Ga Gửi -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="GA GỬI HÀNG (ORIGIN)" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock x:Name="txtTenGaGui" Text="GIÁP BÁT" FontSize="16" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="txtThoiDiemGui" Text="Thời điểm lập: 16/11/2026 08:30" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Mũi Tên & Cự Ly -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0">
                                        <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="12" Padding="10,3">
                                            <TextBlock x:Name="txtCuLyKm" Text="1,726 Km" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                                        </Border>
                                        <ui:SymbolIcon Symbol="ArrowRight24" FontSize="16" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Ga Nhận -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="GA TRẢ HÀNG (DESTINATION)" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="txtTenGaNhan" Text="SÓNG THẦN" FontSize="16" FontWeight="ExtraBold" Foreground="#0F172A" Margin="0,2,0,0" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="txtHinhThucVC" Text="Hình thức: Đường sắt Bắc - Nam" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Khối 2 Cột: Bên Gửi & Bên Nhận -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Cột Người Gửi -->
                                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <ui:SymbolIcon Symbol="PersonArrowLeft24" FontSize="14" Foreground="#0284C7" Margin="0,0,6,0"/>
                                            <TextBlock Text="THÔNG TIN BÊN GỬI" FontSize="11" FontWeight="Bold" Foreground="#003B73"/>
                                        </StackPanel>

                                        <TextBlock Text="Tên người / Đơn vị gửi:" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock x:Name="txtTenNguoiGui" Text="Tập đoàn Điện tử Samsung VN" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,1,0,6"/>

                                        <TextBlock Text="Số điện thoại liên hệ:" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock x:Name="txtSdtNguoiGui" Text="02223888999" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,1,0,6"/>

                                        <TextBlock Text="Địa chỉ lấy hàng / bàn giao:" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock x:Name="txtDiaChiNguoiGui" Text="KCN Yên Phong, Bắc Ninh" FontSize="11" Foreground="#475569" Margin="0,1,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Cột Người Nhận -->
                                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <ui:SymbolIcon Symbol="PersonArrowRight24" FontSize="14" Foreground="#16A34A" Margin="0,0,6,0"/>
                                            <TextBlock Text="THÔNG TIN BÊN NHẬN" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                        </StackPanel>

                                        <TextBlock Text="Tên người / Đơn vị nhận:" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock x:Name="txtTenNguoiNhan" Text="Trung tâm Phân phối SEHC Sài Gòn" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,1,0,6"/>

                                        <TextBlock Text="Số điện thoại nhận hàng:" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock x:Name="txtSdtNguoiNhan" Text="0283888555" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,1,0,6"/>

                                        <TextBlock Text="Địa chỉ nhận hàng tại đích:" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock x:Name="txtDiaChiNguoiNhan" Text="Khu Công nghệ cao, TP. Thủ Đức, TP.HCM" FontSize="11" Foreground="#475569" Margin="0,1,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Khối Chi Tiết Lô Hàng Hóa -->
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="14" Foreground="#003B73" Margin="0,0,6,0"/>
                                        <TextBlock Text="QUY CÁCH VÀ ĐẶC TÍNH HÀNG HÓA VẬN CHUYỂN" FontSize="11" FontWeight="Bold" Foreground="#003B73"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Mặt hàng:" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Grid.Column="1" x:Name="txtTenHangHoa" Text="Linh kiện điện tử / Thiết bị công nghệ" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A"/>

                                        <TextBlock Grid.Column="2" Text="Trọng lượng:" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Grid.Column="3" x:Name="txtTrongLuong" Text="22.00 tấn" FontSize="11.5" FontWeight="Bold" Foreground="#003B73"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Phân loại cước:" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Grid.Column="1" x:Name="txtNhomCuoc" Text="Nhóm 1 (Hàng công nghiệp cao cấp)" FontSize="11" Foreground="#334155"/>

                                        <TextBlock Grid.Column="2" Text="Đơn giá tham chiếu:" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Grid.Column="3" x:Name="txtDonGiaTanKm" Text="550 đ/tấn.km" FontSize="11" Foreground="#334155"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Đặc thù phương tiện:" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Grid.Column="1" x:Name="txtThongTinDacThu" Text="Số Container: CONT-VNR-7722 | Chì hải quan: SEAL-VNR-8821" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Ghi chú vận chuyển:" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Grid.Column="1" x:Name="txtGhiChu" Text="Hàng công nghệ cao, đóng pallet cẩn thận, chằng buộc cố định trên toa mặt phẳng chuyên dụng." FontSize="11" FontStyle="Italic" Foreground="#475569" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Khối Cước Phí, Trạng Thái & QR Tra Cứu -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Bảng tính cước & Trạng thái -->
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Trạng thái vận đơn:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" x:Name="bdTrangThai" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock x:Name="txtTrangThai" Text="ĐÃ GIAO HÀNG THÀNH CÔNG" FontSize="10.5" FontWeight="Bold" Foreground="#15803D"/>
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Cước vận chuyển chính:" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="1" x:Name="txtCuocVanChuyen" Text="21,000,000 VNĐ" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="TỔNG TIỀN THANH TOÁN:" FontSize="11.5" FontWeight="Bold" Foreground="#003B73"/>
                                            <TextBlock Grid.Column="1" x:Name="txtTongCuoc" Text="21,000,000 VNĐ" FontSize="16" FontWeight="ExtraBold" Foreground="#B91C1C"/>
                                        </Grid>

                                        <TextBlock x:Name="txtBangChu" Text="(Viết bằng chữ: Hai mươi mốt triệu đồng chẵn)" FontSize="10.5" FontStyle="Italic" Foreground="#475569"/>
                                    </StackPanel>

                                    <!-- QR Code Tra cứu -->
                                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Image x:Name="imgQrCode" Width="96" Height="96"/>
                                            <TextBlock Text="Quét tra cứu tiến độ" FontSize="8.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Khối Chữ Ký & Đóng Dấu (3 Cột) -->
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="NGƯỜI GỬI HÀNG" FontSize="10" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                                    <TextBlock Text="(Ký, ghi rõ họ tên)" FontSize="9" FontStyle="Italic" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Đã ký bàn giao" FontSize="10" FontWeight="SemiBold" Foreground="#0284C7" Margin="0,32,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="ĐẠI DIỆN VẬN TẢI ĐSVN" FontSize="10" FontWeight="Bold" Foreground="#003B73" HorizontalAlignment="Center"/>
                                    <TextBlock Text="(Ký, đóng dấu trạm gửi)" FontSize="9" FontStyle="Italic" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    <Border Background="#FEE2E2" BorderBrush="#F87171" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,24,0,0">
                                        <TextBlock Text="[ĐÃ XÁC NHẬN VNR]" FontSize="9.5" FontWeight="Bold" Foreground="#DC2626"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="NGƯỜI NHẬN HÀNG" FontSize="10" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                                    <TextBlock Text="(Ký khi nhận tại ga đến)" FontSize="9" FontStyle="Italic" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Đã nhận đủ hàng" FontSize="10" FontWeight="SemiBold" Foreground="#16A34A" Margin="0,32,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- 3. Bottom Action Bar -->
                <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="#64748B" Margin="0,0,6,0"/>
                            <TextBlock Text="Phím tắt: [F8] để In phiếu trực tiếp • [Esc] để Đóng" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Click="BtnInPhieu_Click" Width="130" Height="32" Background="#003B73" Foreground="#FFFFFF" 
                                    BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Print24" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="In Phiếu (F8)" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Click="BtnDong_Click" Width="90" Height="32" Background="#FFFFFF" Foreground="#475569" 
                                    BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                                <TextBlock Text="Đóng (Esc)"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>