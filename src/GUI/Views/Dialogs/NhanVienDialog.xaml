<Window x:Class="GUI.Views.Dialogs.NhanVienDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Hồ Sơ Nhân Viên"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUI;component/Resources/Styles/KyThuatDialogStyles.xaml"/>
                <ResourceDictionary Source="/GUI;component/Resources/Styles/KyThuatPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource KtDialogKhung}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TIÊU ĐỀ -->
            <Border Grid.Row="0" Style="{StaticResource KtHeader}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon x:Name="icoTieuDe" Symbol="PersonAdd24" FontSize="17" Foreground="#FFFFFF" Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtTieuDe" Text="THÊM HỒ SƠ NHÂN VIÊN" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="txtTieuDePhu" Text="Ban lái máy, tổ tàu và nhân viên phục vụ" Foreground="#BFDBFE" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource KtNutDong}" Click="BtnHuy_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Đóng (Esc)"/>
                </Grid>
            </Border>

            <!-- THÂN -->
            <StackPanel Grid.Row="1" Margin="18,14,18,6">
                <TextBlock Text="THÔNG TIN NHÂN VIÊN" Style="{StaticResource KtTieuDeMuc}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Style="{StaticResource KtNhanTruong}">
                            <Run Text="Mã nhân viên"/><Run Text="  · cấp theo chức danh" FontWeight="Normal" Foreground="#64748B"/>
                        </TextBlock>
                        <TextBox x:Name="txtMa" MaxLength="20" IsReadOnly="True" Background="#F1F5F9"
                                 TextChanged="TruongNhap_TextChanged"
                                 ToolTip="Hệ thống tự cấp theo chức danh: LT lái tàu · PL phụ lái · TT trưởng tàu · TV tiếp viên · KX khám xe · BV bán vé · NV chức danh khác. Đổi chức danh thì cấp mã mới."/>
                        <TextBlock x:Name="txtLoiMa" Style="{StaticResource KtLoiTruong}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Trạng thái" Style="{StaticResource KtNhanTruong}"/>
                        <ComboBox x:Name="cboTrangThai" SelectionChanged="CboTrangThai_SelectionChanged">
                            <ComboBoxItem Content="Sẵn sàng" Tag="SAN_SANG"/>
                            <ComboBoxItem Content="Đang làm nhiệm vụ" Tag="DANG_LAM"/>
                            <ComboBoxItem Content="Nghỉ ngơi" Tag="NGHI_NGOI"/>
                            <ComboBoxItem Content="Đã nghỉ việc" Tag="DA_NGHI_VIEC"/>
                        </ComboBox>
                        <TextBlock x:Name="txtLoiTrangThai" Style="{StaticResource KtLoiTruong}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Style="{StaticResource KtNhanTruong}">
                            <Run Text="Họ và tên"/><Run Text=" *" Foreground="#DC2626"/>
                        </TextBlock>
                        <TextBox x:Name="txtHoTen" MaxLength="100" TextChanged="TruongNhap_TextChanged" LostFocus="TruongNhap_LostFocus"
                                 ToolTip="Chỉ gồm chữ cái và khoảng trắng, ít nhất 2 từ, tối đa 50 ký tự"/>
                        <TextBlock x:Name="txtLoiHoTen" Style="{StaticResource KtLoiTruong}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Style="{StaticResource KtNhanTruong}">
                            <Run Text="Ngày sinh"/><Run Text=" *" Foreground="#DC2626"/>
                        </TextBlock>
                        <DatePicker x:Name="dpNgaySinh" Height="30" FontSize="12" SelectedDateFormat="Short"
                                    SelectedDateChanged="DpNgaySinh_SelectedDateChanged"
                                    ToolTip="Nhân viên phải từ 18 đến 62 tuổi"/>
                        <TextBlock x:Name="txtLoiNgaySinh" Style="{StaticResource KtLoiTruong}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Style="{StaticResource KtNhanTruong}">
                            <Run Text="Số điện thoại"/><Run Text=" *" Foreground="#DC2626"/>
                        </TextBlock>
                        <TextBox x:Name="txtSoDienThoai" MaxLength="20" TextChanged="TruongNhap_TextChanged" LostFocus="TruongNhap_LostFocus"
                                 ToolTip="Đúng 10 chữ số, bắt đầu bằng 0"/>
                        <TextBlock x:Name="txtLoiSoDienThoai" Style="{StaticResource KtLoiTruong}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Style="{StaticResource KtNhanTruong}">
                            <Run Text="Hạn khám sức khỏe định kỳ"/><Run Text=" *" Foreground="#DC2626"/>
                        </TextBlock>
                        <DatePicker x:Name="dpHanKham" Height="30" FontSize="12" SelectedDateFormat="Short"
                                    SelectedDateChanged="DpHanKham_SelectedDateChanged"/>
                        <TextBlock x:Name="txtLoiHanKham" Style="{StaticResource KtLoiTruong}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="CHỨC DANH &amp; ĐƠN VỊ" Style="{StaticResource KtTieuDeMuc}" Margin="0,2,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Style="{StaticResource KtNhanTruong}">
                            <Run Text="Chức danh"/><Run Text=" *" Foreground="#DC2626"/>
                        </TextBlock>
                        <ComboBox x:Name="cboChucDanh" SelectionChanged="CboChucDanh_Changed"
                                  ToolTip="Chọn chức danh trong danh mục"/>
                        <TextBlock x:Name="txtLoiChucDanh" Style="{StaticResource KtLoiTruong}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock x:Name="txtNhanHangBang" Style="{StaticResource KtNhanTruong}" Text="Hạng bằng lái"/>
                        <ComboBox x:Name="cboHangBang" SelectionChanged="CboHangBang_SelectionChanged"
                                  ToolTip="Dòng đầu máy được phép lái (chỉ áp dụng cho lái tàu, phụ lái)"/>
                        <TextBlock x:Name="txtLoiHangBang" Style="{StaticResource KtLoiTruong}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Style="{StaticResource KtNhanTruong}">
                            <Run Text="Đơn vị chủ quản (depot / đoàn)"/><Run Text=" *" Foreground="#DC2626"/>
                        </TextBlock>
                        <ComboBox x:Name="cboDonVi" SelectionChanged="CboDonVi_Changed"
                                  ToolTip="Chỉ hiện đơn vị hợp với chức danh: lái tàu, phụ lái → đội lái tàu; trưởng tàu, tiếp viên → đoàn tiếp viên; khám xe → trạm; bán vé → ga"/>
                        <TextBlock x:Name="txtLoiDonVi" Style="{StaticResource KtLoiTruong}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="ĐIỀU KIỆN HÀNH NGHỀ" Style="{StaticResource KtTieuDeMuc}" Margin="0,2,0,6"/>
                <Border Style="{StaticResource KtTheXemTruoc}" Padding="11,3">
                    <StackPanel x:Name="pnlTomTat"/>
                </Border>
                <Border x:Name="bdAnhHuong" Visibility="Collapsed" Background="#FFFBEB" BorderBrush="#B45309"
                        BorderThickness="3,0,0,0" Padding="9,6" Margin="0,0,0,8">
                    <TextBlock x:Name="txtAnhHuong" FontSize="11" Foreground="#0F172A" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- CHÂN TRANG -->
            <Border Grid.Row="2" Style="{StaticResource KtFooter}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Info24" FontSize="13" Foreground="#64748B" Margin="0,0,6,0"/>
                        <TextBlock Text="Lưu sẽ ghi vào CSDL (kèm nhật ký). Mã chính thức cấp khi lưu."
                                   FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource DesktopButton}" Height="32" IsCancel="True" Click="BtnHuy_Click">
                            <TextBlock Text="Hủy (Esc)"/>
                        </Button>
                        <Button x:Name="btnLuu" Style="{StaticResource PrimaryDesktopButton}" Height="32" Margin="0"
                                Click="BtnLuu_Click" ToolTip="Lưu hồ sơ (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                <TextBlock x:Name="txtNutLuu" Text="Lưu Hồ Sơ"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
