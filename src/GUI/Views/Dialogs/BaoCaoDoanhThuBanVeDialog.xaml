<Window x:Class="GUI.Views.Dialogs.BaoCaoDoanhThuBanVeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Báo Cáo Doanh Thu Bán Vé &amp; Vận Tải Hành Khách"
        Width="920"
        Height="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Border Background="#FFFFFF" 
                BorderBrush="#003B73" 
                BorderThickness="1.5" 
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="28" ShadowDepth="6" Opacity="0.35"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header Bar -->
                <Grid Grid.Row="0" Background="#003B73" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                    <Border CornerRadius="7,7,0,0" Background="#003B73"/>
                    <Grid Margin="14,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DataPie24" FontSize="16" Foreground="#38BDF8" Margin="0,0,8,0"/>
                            <TextBlock Text="BÁO CÁO DOANH THU BÁN VÉ &amp; VẬN TẢI HÀNH KHÁCH" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                        </StackPanel>

                        <Button Grid.Column="1" Click="BtnDong_Click" 
                                Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="#94A3B8"/>
                        </Button>
                    </Grid>
                </Grid>

                <!-- 2. Thanh lọc tiêu chí & Mẫu báo cáo -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                                <TextBlock Text="Mẫu báo cáo:" FontWeight="SemiBold" FontSize="11" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="cboMauBaoCao" Width="200" Height="28" FontSize="11" VerticalContentAlignment="Center"
                                          SelectionChanged="CboMauBaoCao_SelectionChanged">
                                    <ComboBoxItem Content="1. Doanh thu theo Ngày" IsSelected="True"/>
                                    <ComboBoxItem Content="2. Doanh thu theo Mác Tàu"/>
                                    <ComboBoxItem Content="3. Doanh thu theo Chặng Tuyến"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                                <TextBlock Text="Từ ngày:" FontWeight="SemiBold" FontSize="11" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <DatePicker x:Name="dpTuNgay" Width="110" Height="28" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                                <TextBlock Text="Đến ngày:" FontWeight="SemiBold" FontSize="11" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <DatePicker x:Name="dpDenNgay" Width="110" Height="28" FontSize="11"/>
                            </StackPanel>

                            <Button Click="BtnXemBaoCao_Click" Style="{StaticResource PrimaryDesktopButton}" Height="28" Padding="12,0" Margin="0,2,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Xem Báo Cáo"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Click="BtnXuatExcel_Click" Style="{StaticResource DesktopButton}" Height="28" Padding="10,0" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DocumentTable24" FontSize="13" Foreground="#15803D" Margin="0,0,4,0"/>
                                    <TextBlock Text="Xuất Excel"/>
                                </StackPanel>
                            </Button>
                            <Button Click="BtnInBaoCao_Click" Style="{StaticResource DesktopButton}" Height="28" Padding="10,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Print24" FontSize="13" Foreground="#003B73" Margin="0,0,4,0"/>
                                    <TextBlock Text="In Báo Cáo"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. KPI Cards Tổng Quan -->
                <Grid Grid.Row="2" Margin="14,10,14,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="TỔNG SỐ VÉ PHÁT HÀNH" FontSize="10" FontWeight="Bold" Foreground="#0369A1"/>
                            <TextBlock x:Name="kpiTongVe" Text="0 vé" FontSize="18" FontWeight="Bold" Foreground="#003B73"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="DOANH THU THỰC THU" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                            <TextBlock x:Name="kpiTongThu" Text="0 VNĐ" FontSize="18" FontWeight="Bold" Foreground="#15803D"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="TIỀN THỰC HOÀN VÉ" FontSize="10" FontWeight="Bold" Foreground="#B91C1C"/>
                            <TextBlock x:Name="kpiTongHoan" Text="0 VNĐ" FontSize="18" FontWeight="Bold" Foreground="#B91C1C"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="#FEFCE8" BorderBrush="#FEF08A" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="DOANH THU THUẦN" FontSize="10" FontWeight="Bold" Foreground="#A16207"/>
                            <TextBlock x:Name="kpiDoanhThuThuan" Text="0 VNĐ" FontSize="18" FontWeight="Bold" Foreground="#003B73"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 4. DataGrid Báo Cáo (Khu vực in ấn) -->
                <Grid Grid.Row="3" Margin="14,4,14,8" x:Name="printArea">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="lblTieuDeBang" Grid.Row="0" Text="BẢNG TỔNG HỢP DOANH THU BÁN VÉ" FontSize="12" FontWeight="Bold" Foreground="#003B73" Margin="0,0,0,6"/>

                    <DataGrid Grid.Row="1" x:Name="dgBaoCao" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single"
                              Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1"/>
                </Grid>

                <!-- 5. Footer Bar -->
                <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,8">
                    <Grid>
                        <TextBlock x:Name="lblThongTinTongKet" Text="Dữ liệu trích xuất từ phân hệ Quản lý Vận tải Hành khách" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Click="BtnDong_Click" Style="{StaticResource DesktopButton}" Padding="16,4">
                            <TextBlock Text="Đóng"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
