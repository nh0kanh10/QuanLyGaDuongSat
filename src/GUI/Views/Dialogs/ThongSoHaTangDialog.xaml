<Window x:Class="GUI.Views.Dialogs.ThongSoHaTangDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Thông Số Kỹ Thuật Hạ Tầng"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Background="#FFFFFF" 
            BorderBrush="#003B73" 
            BorderThickness="1.5" 
            CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>

            <!-- 1. Header sắc sảo màu Xanh Hải Quân VNR -->
            <Border Grid.Row="0" Background="#003B73" CornerRadius="3,3,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon x:Name="iconHeader" Symbol="Info24" FontSize="16" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtTitleHeader" Text="HỒ SƠ THÔNG SỐ KỸ THUẬT HẠ TẦNG" 
                                   Foreground="#FFFFFF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Click="BtnDong_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="26" Height="26" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="✕" FontSize="14" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Thân nội dung chi tiết -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14">
                <StackPanel>
                    <!-- Khối tiêu đề lớn của đối tượng -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="14,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="txtTenDoiTuong" Text="Đường Ray Số 1" FontSize="16" FontWeight="Bold" Foreground="#003B73"/>
                                <TextBlock x:Name="txtMoTaPhu" Text="Ga Diêu Trì (DTR) — Lý trình Km 1,095.50" FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" x:Name="bdTrangThai" Background="#F8FAFC" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="3" Padding="8,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="dotTrangThaiBadge" Width="6" Height="6" Fill="#16A34A" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtTrangThaiBadge" Text="SẴN SÀNG" FontSize="10" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Lưới thông số kỹ thuật 2 cột -->
                    <TextBlock Text="CÁC CHỈ SỐ KỸ THUẬT &amp; KHAI THÁC" FontSize="11" FontWeight="Bold" Foreground="#003B73" Margin="0,0,0,8"/>

                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="12,10" Margin="0,0,0,14">
                        <Grid x:Name="gridThongSo">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Hàng 1 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Phân loại chức năng:" FontSize="11" Foreground="#64748B" Margin="0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtChiTietPhanLoai" Text="Chính tuyến đón gửi tàu khách" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4"/>

                            <!-- Hàng 2 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="lblThongSo2" Text="Chiều dài hữu dụng:" FontSize="11" Foreground="#64748B" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtThongSo2" Text="500 mét (sức chứa ~25 toa xe)" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4"/>

                            <!-- Hàng 3 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="lblThongSo3" Text="Hạ tầng ke ga đón khách:" FontSize="11" Foreground="#64748B" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtThongSo3" Text="Có ke ga cao tiêu chuẩn đón trả khách" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4"/>

                            <!-- Hàng 4 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" x:Name="lblThongSo4" Text="Khổ đường ray:" FontSize="11" Foreground="#64748B" Margin="0,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtThongSo4" Text="1,000 mm (Khổ hẹp chuẩn VNR Tuyến Thống Nhất)" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4"/>

                            <!-- Hàng 5 -->
                            <TextBlock Grid.Row="4" Grid.Column="0" x:Name="lblThongSo5" Text="Tiêu chuẩn kết cấu ray:" FontSize="11" Foreground="#64748B" Margin="0,4"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtThongSo5" Text="Ray P50 hàn liền, tà vẹt bê tông dự ứng lực K1, ba-lát 35cm" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4"/>

                            <!-- Hàng 6 -->
                            <TextBlock Grid.Row="5" Grid.Column="0" x:Name="lblThongSo6" Text="Phương thức đóng đường:" FontSize="11" Foreground="#64748B" Margin="0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="txtThongSo6" Text="Mạch điện đường ray &amp; khóa liên khóa rơle 6502" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4"/>

                            <!-- Hàng 7 -->
                            <TextBlock Grid.Row="6" Grid.Column="0" x:Name="lblThongSo7" Text="Quy chuẩn an toàn:" FontSize="11" Foreground="#64748B" Margin="0,4"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="txtThongSo7" Text="QCVN 08:2018/BGTVT (Quy chuẩn kỹ thuật quốc gia về khai thác đường sắt)" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4"/>
                        </Grid>
                    </Border>

                    <!-- Khối ghi chú chuyên gia / khuyến cáo an toàn chạy tàu -->
                    <Border x:Name="bdKhuyenCao" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="3" Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon x:Name="iconKhuyenCao" Symbol="ShieldCheckmark24" FontSize="14" Foreground="#1D4ED8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtTieuDeKhuyenCao" Text="LƯU Ý AN TOÀN TÁC NGHIỆP" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtNoiDungKhuyenCao" 
                                       Text="Đường đón gửi tàu chính tuyến. Cấm dồn dịch toa xe chở hàng nguy hiểm hoặc hóa chất độc hại lưu ban đêm trên đường này khi không có lệnh trực ban điều độ ga." 
                                       FontSize="11" Foreground="#1E3A8A" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Thanh thao tác chân trang -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="14,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="btnMoQuanLy" Click="BtnMoQuanLy_Click" Height="32" Padding="12,0" 
                                Background="#FFFFFF" BorderBrush="#003B73" BorderThickness="1" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="14" Foreground="#003B73" Margin="0,0,6,0"/>
                                <TextBlock Text="Mở Trình Quản Lý Hạ Tầng..." FontSize="11" FontWeight="SemiBold" Foreground="#003B73"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnDong_Click" Height="32" Padding="18,0" 
                                Background="#003B73" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="Đóng (Esc)" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
