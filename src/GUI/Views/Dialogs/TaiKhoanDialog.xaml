<Window x:Class="GUI.Views.Dialogs.TaiKhoanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Tài Khoản"
        Width="760" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, sans-serif"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUI;component/Resources/Styles/KyThuatDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource KtDialogKhung}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource KtHeader}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Person24" FontSize="17" Foreground="#FFFFFF" Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtTieuDe" Text="THÊM TÀI KHOẢN" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="txtTieuDePhu" Text="Mỗi nhân viên một tài khoản · quyền theo vai trò" Foreground="#BFDBFE" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource KtNutDong}" Click="BtnHuy_Click" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Đóng (Esc)"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,14,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="THÔNG TIN TÀI KHOẢN" Style="{StaticResource KtTieuDeMuc}"/>

                    <TextBlock Text="Tên đăng nhập *" Style="{StaticResource KtNhanTruong}"/>
                    <TextBox x:Name="txtTenDangNhap" Height="30" MaxLength="50" VerticalContentAlignment="Center" Padding="6,0"
                             CharacterCasing="Lower" TextChanged="O_ThayDoi"/>
                    <TextBlock x:Name="txtGoiYTen" Text="3–50 ký tự: chữ thường không dấu, chữ số, dấu . _ -" Style="{StaticResource KtGoiY}"/>

                    <TextBlock Text="Tên hiển thị *" Style="{StaticResource KtNhanTruong}"/>
                    <TextBox x:Name="txtHoTen" Height="30" MaxLength="100" VerticalContentAlignment="Center" Padding="6,0" TextChanged="O_ThayDoi"/>

                    <TextBlock Text="Email" Style="{StaticResource KtNhanTruong}"/>
                    <TextBox x:Name="txtEmail" Height="30" MaxLength="100" VerticalContentAlignment="Center" Padding="6,0" TextChanged="O_ThayDoi"/>

                    <TextBlock Text="Hồ sơ nhân viên" Style="{StaticResource KtNhanTruong}"/>
                    <ComboBox x:Name="cboNhanVien" Height="30" SelectionChanged="CboNhanVien_SelectionChanged" IsTextSearchEnabled="True"/>
                    <TextBlock x:Name="txtGoiYNhanVien" Style="{StaticResource KtGoiY}"
                               Text="Nối với hồ sơ để biết tài khoản của ai (nhật ký, ký phiếu, bán vé)."/>

                    <StackPanel x:Name="pnlMatKhau">
                        <TextBlock Text="Mật khẩu ban đầu *" Style="{StaticResource KtNhanTruong}"/>
                        <PasswordBox x:Name="txtMatKhau" Height="30" MaxLength="64" VerticalContentAlignment="Center" Padding="6,0" PasswordChanged="O_ThayDoi"/>
                        <TextBlock Text="Nhập lại mật khẩu *" Style="{StaticResource KtNhanTruong}"/>
                        <PasswordBox x:Name="txtNhapLai" Height="30" MaxLength="64" VerticalContentAlignment="Center" Padding="6,0" PasswordChanged="O_ThayDoi"/>
                        <TextBlock Text="8–64 ký tự, có chữ và số. Người dùng phải đổi ở lần đăng nhập đầu tiên." Style="{StaticResource KtGoiY}"/>
                    </StackPanel>

                    <CheckBox x:Name="chkHoatDong" Content="Tài khoản đang hoạt động (bỏ chọn = vô hiệu hóa, không đăng nhập được)"
                              Margin="0,10,0,0" FontSize="11" Visibility="Collapsed" Checked="O_ThayDoi" Unchecked="O_ThayDoi"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="VAI TRÒ (CHỌN ÍT NHẤT 1)" Style="{StaticResource KtTieuDeMuc}"/>
                    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Background="#FFFFFF" MaxHeight="380">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="icVaiTro" Margin="8,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DuocChon, Mode=TwoWay}" Margin="0,4" Checked="O_ThayDoi" Unchecked="O_ThayDoi">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Ten}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding MoTa}" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" MaxWidth="290"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="txtLoi" Style="{StaticResource KtLoiTruong}" Margin="18,0,18,6" TextWrapping="Wrap"/>
                <Border Style="{StaticResource KtFooter}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Info24" FontSize="13" Foreground="#64748B" Margin="0,0,6,0"/>
                            <TextBlock x:Name="txtChanTrang" Text="Lưu ghi vào CSDL và nhật ký hệ thống (không ghi mật khẩu)." FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource DesktopButton}" Height="32" Click="BtnHuy_Click">
                                <TextBlock Text="Hủy (Esc)"/>
                            </Button>
                            <Button x:Name="btnLuu" Style="{StaticResource PrimaryDesktopButton}" Height="32" Margin="0" Click="BtnLuu_Click" ToolTip="Lưu (Ctrl+S)">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Save24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                    <TextBlock Text="Lưu Tài Khoản"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
