<Window x:Class="GUI.Views.Dialogs.TheLenTauDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Thẻ Lên Tàu Điện Tử"
        Width="580"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Border Background="#FFFFFF" 
                BorderBrush="#003B73" 
                BorderThickness="1.5" 
                CornerRadius="6">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="28" ShadowDepth="6" Opacity="0.35"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Header Bar -->
                <Grid Grid.Row="0" Background="#003B73" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                    <Border CornerRadius="5,5,0,0" Background="#003B73"/>
                    <Grid Margin="14,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="TicketDiagonal24" FontSize="16" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBlock Text="THẺ LÊN TÀU HỎA ĐIỆN TỬ - VIETNAM RAILWAYS" 
                                       FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>

                        <Button Grid.Column="1" Click="BtnDong_Click" Width="28" Height="28"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="#FFFFFF"/>
                        </Button>
                    </Grid>
                </Grid>

                <!-- 2. Body: Bản in Thẻ Lên Tàu -->
                <Border Grid.Row="1" x:Name="bdInVe" Margin="16" Padding="16" Background="#F8FAFC" 
                        BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Ve -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TỔNG CÔNG TY ĐƯỜNG SẮT VIỆT NAM" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                <TextBlock Text="THẺ LÊN TÀU HỎA" FontSize="20" FontWeight="ExtraBold" Foreground="#003B73" Margin="0,2,0,0"/>
                                <TextBlock x:Name="txtMaPNR" Text="Mã Đơn: PNR-SE1-002" FontSize="11" FontWeight="SemiBold" Foreground="#0284C7"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#E0F2FE" BorderBrush="#0284C7" BorderThickness="1" 
                                    CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock x:Name="txtMaVeCode" Text="TK-SE1-01" FontFamily="Consolas" FontSize="13" 
                                           FontWeight="Bold" Foreground="#0369A1"/>
                            </Border>
                        </Grid>

                        <Separator Grid.Row="1" Margin="0,0,0,12" Background="#CBD5E1"/>

                        <!-- Hanh Trinh Chuyen Tau -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" 
                                CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                    <TextBlock Text="GA ĐI" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                    <TextBlock x:Name="txtGaDi" Text="HÀ NỘI" FontSize="16" FontWeight="ExtraBold" Foreground="#0F172A"/>
                                    <TextBlock x:Name="txtGioDi" Text="19:30 - 21/09/2026" FontSize="11" Foreground="#475569" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Background="#003B73" CornerRadius="12" Padding="8,3">
                                        <TextBlock x:Name="txtMacTau" Text="SE1" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                    </Border>
                                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="16" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="GA ĐẾN" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="txtGaDen" Text="SÀI GÒN" FontSize="16" FontWeight="ExtraBold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="txtNgayDen" Text="Chặng xuyên Việt" FontSize="11" Foreground="#475569" Margin="0,2,0,0" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Toa, Ghe, Hanh Khach & QR Code -->
                        <Grid Grid.Row="3" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Hành khách:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" x:Name="txtTenKhach" Text="NGUYỄN VĂN A" FontSize="12" FontWeight="Bold" Foreground="#0F172A"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Số CCCD:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" x:Name="txtCCCD" Text="001085012345" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Toa xe:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" x:Name="txtToa" Text="Toa 3 (NML - Ngồi mềm ĐH)" FontSize="12" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Chỗ ngồi:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" x:Name="txtSoGhe" Text="Ghế số 15" FontSize="13" FontWeight="ExtraBold" Foreground="#003B73"/>
                                </Grid>

                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Tiền vé:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" x:Name="txtGiaVe" Text="1,250,000 VNĐ" FontSize="13" FontWeight="Bold" Foreground="#15803D"/>
                                </Grid>
                            </StackPanel>

                            <!-- QR Code Holder -->
                            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" 
                                    CornerRadius="4" Padding="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <Image x:Name="imgQrCode" Width="100" Height="100"/>
                                    <TextBlock Text="Quét soát vé" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Chu Thich Cuoi Ve -->
                        <Border Grid.Row="4" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="4" Padding="8,6">
                            <TextBlock Text="* Hành khách vui lòng mang theo CCCD/Hộ chiếu và có mặt tại ga trước 30 phút giờ tàu chạy." 
                                       FontSize="10" Foreground="#92400E" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 3. Bottom Action Buttons -->
                <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnInVe_Click" Width="120" Height="32" Background="#003B73" Foreground="#FFFFFF" 
                                BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Print24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="In Thẻ (F8)" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Click="BtnDong_Click" Width="90" Height="32" Background="#FFFFFF" Foreground="#475569" 
                                BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                            <TextBlock Text="Đóng"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
