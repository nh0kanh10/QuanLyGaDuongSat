<Window x:Class="GUI.Views.Dialogs.DatLaiMatKhauDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Đặt Lại Mật Khẩu"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, sans-serif"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUI;component/Resources/Styles/KyThuatDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource KtDialogKhung}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource KtHeader}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="17" Foreground="#FFFFFF" Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ĐẶT LẠI MẬT KHẨU" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="txtTieuDePhu" Foreground="#BFDBFE" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource KtNutDong}" Click="BtnHuy_Click" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Đóng (Esc)"/>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="18,14,18,10">
                <TextBlock FontSize="11" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Đặt mật khẩu tạm rồi báo trực tiếp cho người dùng. Tài khoản được mở khóa và người dùng phải đổi mật khẩu ở lần đăng nhập kế tiếp."/>
                <TextBlock Text="Mật khẩu mới" Style="{StaticResource KtNhanTruong}"/>
                <PasswordBox x:Name="txtMatKhau" Height="30" MaxLength="64" Padding="6,0" VerticalContentAlignment="Center" PasswordChanged="O_ThayDoi"/>
                <TextBlock Text="Nhập lại mật khẩu mới" Style="{StaticResource KtNhanTruong}"/>
                <PasswordBox x:Name="txtNhapLai" Height="30" MaxLength="64" Padding="6,0" VerticalContentAlignment="Center" PasswordChanged="O_ThayDoi"/>
                <TextBlock x:Name="txtLoi" Style="{StaticResource KtLoiTruong}"/>
                <TextBlock Text="8–64 ký tự, có cả chữ cái và chữ số, không có khoảng trắng." Style="{StaticResource KtGoiY}"/>
            </StackPanel>
            <Border Grid.Row="2" Style="{StaticResource KtFooter}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DesktopButton}" Height="32" Click="BtnHuy_Click">
                        <TextBlock Text="Hủy (Esc)"/>
                    </Button>
                    <Button x:Name="btnLuu" Style="{StaticResource PrimaryDesktopButton}" Height="32" Margin="0" IsDefault="True" Click="BtnLuu_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                            <TextBlock Text="Đặt Lại"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
