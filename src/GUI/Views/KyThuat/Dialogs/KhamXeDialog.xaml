<Window x:Class="GUI.Views.KyThuat.Dialogs.KhamXeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Biên Bản Khám Xe Kỹ Thuật"
        Width="820" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUI;component/Views/KyThuat/Styles/KyThuatDialogStyles.xaml"/>
                <ResourceDictionary Source="/GUI;component/Views/KyThuat/Styles/KyThuatPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Lề 12px để bóng đổ không bị cắt -->
    <Border Style="{StaticResource KtDialogKhung}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================================= -->
            <!-- 1. TIÊU ĐỀ                                                    -->
            <!-- ============================================================= -->
            <Border Grid.Row="0" Style="{StaticResource KtHeader}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ClipboardTaskListLtr24" FontSize="17" Foreground="#FFFFFF" Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtTieuDe" Text="LẬP BIÊN BẢN KHÁM XE KỸ THUẬT"
                                       Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="txtTieuDePhu" Text="Thử hãm gió, kiểm tra cấp nước và vệ sinh trước khi xuất bến"
                                       Foreground="#BFDBFE" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource KtNutDong}" Click="BtnHuy_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Đóng (Esc)"/>
                </Grid>
            </Border>

            <!-- ============================================================= -->
            <!-- 2. THÂN: FORM BÊN TRÁI + XEM TRƯỚC BÊN PHẢI                   -->
            <!-- ============================================================= -->
            <Grid Grid.Row="1" Margin="18,14,18,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <!-- ====== FORM ====== -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="THÔNG TIN BIÊN BẢN" Style="{StaticResource KtTieuDeMuc}"/>

                    <!-- Đoàn tàu -->
                    <TextBlock Style="{StaticResource KtNhanTruong}">
                        <Run Text="Đoàn tàu được khám"/><Run Text=" *" Foreground="#DC2626"/>
                    </TextBlock>
                    <ComboBox x:Name="cboDoanTau" DisplayMemberPath="TenHienThi"
                              SelectionChanged="CboDoanTau_SelectionChanged"
                              ToolTip="Đoàn tàu đã lập của chuyến (vanhanh.DoanTau)"/>
                    <TextBlock x:Name="txtLoiDoanTau" Style="{StaticResource KtLoiTruong}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource KtNhanTruong}">
                                <Run Text="Nhân viên khám xe"/><Run Text=" *" Foreground="#DC2626"/>
                            </TextBlock>
                            <ComboBox x:Name="cboNguoiKham" DisplayMemberPath="TenHienThi"
                                      SelectionChanged="CboNguoiKham_SelectionChanged"/>
                            <TextBlock x:Name="txtLoiNguoiKham" Style="{StaticResource KtLoiTruong}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Thời điểm khám" Style="{StaticResource KtNhanTruong}"/>
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3"
                                    Height="30" Padding="9,0">
                                <TextBlock x:Name="txtThoiDiemKham" Text="—" FontSize="11" Foreground="#475569"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="txtGoiYThoiDiem" Text="Tự ghi khi lưu" Style="{StaticResource KtGoiY}" Margin="0,2,0,6"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="KẾT QUẢ THỬ HÃM GIÓ" Style="{StaticResource KtTieuDeMuc}" Margin="0,2,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource KtNhanTruong}">
                                <Run Text="Áp lực hãm (bar)"/><Run Text=" *" Foreground="#DC2626"/>
                            </TextBlock>
                            <TextBox x:Name="txtApLuc" MaxLength="5" TextChanged="TruongNhap_TextChanged"
                                     ToolTip="Áp lực ống hãm chính sau khi nạp gió, 1 chữ số thập phân"/>
                            <TextBlock x:Name="txtLoiApLuc" Style="{StaticResource KtLoiTruong}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource KtNhanTruong}">
                                <Run Text="Độ sụt áp (bar/phút)"/><Run Text=" *" Foreground="#DC2626"/>
                            </TextBlock>
                            <TextBox x:Name="txtSutAp" MaxLength="5" TextChanged="TruongNhap_TextChanged"
                                     ToolTip="Mức giảm áp suất trong 1 phút khi đã khóa nguồn gió (thử kín), 2 chữ số thập phân"/>
                            <TextBlock x:Name="txtLoiSutAp" Style="{StaticResource KtLoiTruong}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="CHUẨN BỊ PHỤC VỤ HÀNH KHÁCH" Style="{StaticResource KtTieuDeMuc}" Margin="0,0,0,6"/>
                    <WrapPanel Margin="0,0,0,10">
                        <CheckBox x:Name="chkCapNuoc" Content="Đã cấp nước sinh hoạt toàn đoàn" FontSize="11"
                                  Margin="0,0,18,4" Checked="HangMuc_Changed" Unchecked="HangMuc_Changed"/>
                        <CheckBox x:Name="chkXaVeSinh" Content="Đã xả két vệ sinh" FontSize="11"
                                  Margin="0,0,0,4" Checked="HangMuc_Changed" Unchecked="HangMuc_Changed"/>
                    </WrapPanel>

                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="txtNhanGhiChu" Text="Ghi chú kỹ thuật" Style="{StaticResource KtNhanTruong}"
                                   VerticalAlignment="Bottom"/>
                        <Button x:Name="btnTaoGhiChu" Click="BtnTaoGhiChu_Click" HorizontalAlignment="Right"
                                Style="{StaticResource DesktopButton}" Height="22" Padding="8,0" Margin="0"
                                ToolTip="Điền ghi chú từ các hạng mục không đạt">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sparkle24" FontSize="11" Foreground="#003B73" Margin="0,0,4,0"/>
                                <TextBlock Text="Tạo từ kết quả" FontSize="10"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBox x:Name="txtGhiChu" Height="62" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             TextChanged="TruongNhap_TextChanged"/>
                    <TextBlock x:Name="txtLoiGhiChu" Style="{StaticResource KtLoiTruong}"/>
                </StackPanel>

                <!-- ====== XEM TRƯỚC ====== -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="KẾT LUẬN (TỰ ĐỘNG)" Style="{StaticResource KtTieuDeMuc}"/>
                    <Border x:Name="bdKetLuan" Style="{StaticResource KtTheXemTruoc}" Padding="12,10"
                            Background="#F8FAFC" BorderBrush="#E2E8F0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="icoKetLuan" Grid.Column="0" Symbol="ShieldCheckmark24" FontSize="26"
                                           Foreground="#94A3B8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="txtKetLuan" Text="CHỜ NHẬP KẾT QUẢ" FontSize="12" FontWeight="Bold"
                                           Foreground="#475569" TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtKetLuanPhu" Text="Nhập áp lực hãm và độ sụt áp" FontSize="10"
                                           Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="ĐỐI CHIẾU HẠNG MỤC" Style="{StaticResource KtTieuDeMuc}"/>
                    <ItemsControl x:Name="icHangMuc" ItemTemplate="{StaticResource KtMauHangMucKhamXe}" Margin="0,0,0,5"/>

                    <!-- Thang áp lực 0 – 10 bar, vạch ngưỡng 4.8 bar -->
                    <Border Style="{StaticResource KtTheXemTruoc}" Padding="11,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Thang áp lực hãm (0 – 10 bar)" FontSize="10" Foreground="#64748B"/>
                                <TextBlock x:Name="txtApLucThang" Text="—" FontSize="10" FontWeight="Bold"
                                           Foreground="#475569" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Height="10">
                                <Border CornerRadius="5" Background="#E2E8F0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="colApLucDat" Width="0*"/>
                                        <ColumnDefinition x:Name="colApLucCon" Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="bdApLucVach" Grid.Column="0" CornerRadius="5" Background="#94A3B8"/>
                                </Grid>
                                <!-- Vạch ngưỡng ở 48% -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48*"/>
                                        <ColumnDefinition Width="52*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="1" Width="2" Fill="#0F172A" HorizontalAlignment="Left"
                                               Margin="-1,-2,0,-2"/>
                                </Grid>
                            </Grid>
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48*"/>
                                    <ColumnDefinition Width="52*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="▲ 4.8 bar" FontSize="9" Foreground="#0F172A" Margin="-4,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ĐOÀN TÀU" Style="{StaticResource KtTieuDeMuc}"/>
                    <Border Style="{StaticResource KtTheXemTruoc}" Padding="11,3" Margin="0">
                        <StackPanel x:Name="pnlDoanTau"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ============================================================= -->
            <!-- 3. CHÂN TRANG                                                 -->
            <!-- ============================================================= -->
            <Border Grid.Row="2" Style="{StaticResource KtFooter}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Info24" FontSize="13" Foreground="#64748B" Margin="0,0,6,0"/>
                        <TextBlock Text="Giai đoạn giao diện: biên bản chỉ hiển thị trên màn hình, chưa ghi vào CSDL."
                                   FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource DesktopButton}" Height="32" IsCancel="True" Click="BtnHuy_Click">
                            <TextBlock Text="Hủy (Esc)"/>
                        </Button>
                        <Button x:Name="btnLuu" Style="{StaticResource PrimaryDesktopButton}" Height="32" Margin="0"
                                Click="BtnLuu_Click" ToolTip="Lưu biên bản (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                <TextBlock x:Name="txtNutLuu" Text="Lưu Biên Bản"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
