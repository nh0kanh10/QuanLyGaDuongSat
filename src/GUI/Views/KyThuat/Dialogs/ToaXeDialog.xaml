<Window x:Class="GUI.Views.KyThuat.Dialogs.ToaXeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Hồ Sơ Toa Xe"
        Width="740" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUI;component/Views/KyThuat/Styles/KyThuatDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource KtDialogKhung}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. TIÊU ĐỀ -->
            <Border Grid.Row="0" Style="{StaticResource KtHeader}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Couch24" FontSize="17" Foreground="#FFFFFF" Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtTieuDe" Text="THÊM MỚI TOA XE"
                                       Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="txtTieuDePhu" Text="Khai báo toa xe mới vào đội phương tiện"
                                       Foreground="#BFDBFE" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource KtNutDong}" Click="BtnHuy_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Đóng (Esc)"/>
                </Grid>
            </Border>

            <!-- 2. THÂN -->
            <Grid Grid.Row="1" Margin="18,14,18,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="262"/>
                </Grid.ColumnDefinitions>

                <!-- FORM -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="THÔNG TIN ĐỊNH DANH" Style="{StaticResource KtTieuDeMuc}"/>

                    <!-- Chủng loại đặt trước để gợi ý số hiệu -->
                    <TextBlock Style="{StaticResource KtNhanTruong}">
                        <Run Text="Chủng loại toa"/><Run Text=" *" Foreground="#DC2626"/>
                    </TextBlock>
                    <ComboBox x:Name="cboChungLoai" DisplayMemberPath="TenHienThi"
                              SelectionChanged="CboChungLoai_SelectionChanged"/>
                    <TextBlock x:Name="txtLoiChungLoai" Style="{StaticResource KtLoiTruong}"/>

                    <TextBlock Style="{StaticResource KtNhanTruong}">
                        <Run Text="Số hiệu toa xe"/><Run Text=" *" Foreground="#DC2626"/>
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="txtSoHieu" MaxLength="20" CharacterCasing="Upper"
                                 TextChanged="TruongNhap_TextChanged"
                                 ToolTip="Mã định danh duy nhất, dạng LOẠI-SỐ. Ví dụ: NML-205"/>
                        <Button Grid.Column="1" x:Name="btnGoiYSoHieu" Click="BtnGoiYSoHieu_Click"
                                Style="{StaticResource DesktopButton}" Margin="6,0,0,0" Padding="8,0"
                                ToolTip="Lấy số hiệu trống kế tiếp của chủng loại đang chọn">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sparkle24" FontSize="12" Foreground="#003B73" Margin="0,0,4,0"/>
                                <TextBlock Text="Gợi ý"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="txtLoiSoHieu" Style="{StaticResource KtLoiTruong}"/>

                    <Grid Margin="0,4,0,8">
                        <TextBlock Text="TẢI TRỌNG" Style="{StaticResource KtTieuDeMuc}" Margin="0"/>
                        <Button x:Name="btnThongSoMacDinh" Click="BtnThongSoMacDinh_Click" HorizontalAlignment="Right"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0"
                                ToolTip="Điền tự trọng / tải trọng tham khảo của chủng loại đang chọn">
                            <TextBlock Text="Dùng thông số mặc định" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#1D4ED8" TextDecorations="Underline"/>
                        </Button>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource KtNhanTruong}">
                                <Run Text="Tự trọng (tấn)"/><Run Text=" *" Foreground="#DC2626"/>
                            </TextBlock>
                            <TextBox x:Name="txtTuTrong" TextChanged="TruongNhap_TextChanged"
                                     ToolTip="Khối lượng bản thân toa khi rỗng"/>
                            <TextBlock x:Name="txtLoiTuTrong" Style="{StaticResource KtLoiTruong}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource KtNhanTruong}">
                                <Run Text="Tải trọng tối đa (tấn)"/><Run Text=" *" Foreground="#DC2626"/>
                            </TextBlock>
                            <TextBox x:Name="txtTaiTrong" TextChanged="TruongNhap_TextChanged"
                                     ToolTip="Khối lượng hàng / hành khách tối đa được phép chở"/>
                            <TextBlock x:Name="txtLoiTaiTrong" Style="{StaticResource KtLoiTruong}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Trạng thái" Style="{StaticResource KtNhanTruong}"/>
                    <WrapPanel Margin="0,2,0,4">
                        <RadioButton x:Name="rdoSanSang" GroupName="TrangThaiToa" Content="Sẵn sàng" Tag="#16A34A"
                                     Style="{StaticResource KtChipRadio}"
                                     ToolTip="Toa ở bãi, có thể đưa vào lập tàu"/>
                        <RadioButton x:Name="rdoDaNoi" GroupName="TrangThaiToa" Content="Đã nối vào đoàn" Tag="#2563EB"
                                     Style="{StaticResource KtChipRadio}"
                                     ToolTip="Toa đang được móc nối trong một đoàn tàu"/>
                        <RadioButton x:Name="rdoBaoDuong" GroupName="TrangThaiToa" Content="Bảo dưỡng" Tag="#D97706"
                                     Style="{StaticResource KtChipRadio}"
                                     ToolTip="Toa đang trong xưởng, không đưa vào lập tàu"/>
                    </WrapPanel>
                </StackPanel>

                <!-- XEM TRƯỚC -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="CHỦNG LOẠI" Style="{StaticResource KtTieuDeMuc}"/>
                    <Border x:Name="bdTheChungLoai" Style="{StaticResource KtTheXemTruoc}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border x:Name="bdMaChungLoai" CornerRadius="3" BorderThickness="1" Padding="8,2"
                                        Background="#EEF2FF" BorderBrush="#C7D2FE" Margin="0,0,8,0">
                                    <TextBlock x:Name="txtMaChungLoai" Text="—" FontSize="11" FontWeight="Bold" Foreground="#4338CA"/>
                                </Border>
                                <TextBlock x:Name="txtNhomToa" Text="" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtMoTaChungLoai" Text="Chọn chủng loại toa" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <StackPanel x:Name="pnlThongSoChungLoai"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="TẢI TRỌNG TRỤC" Style="{StaticResource KtTieuDeMuc}"/>
                    <Border Style="{StaticResource KtTheXemTruoc}" Margin="0">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="txtTaiTrongTruc" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text=" t/trục" FontSize="11" Foreground="#64748B" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                </StackPanel>
                                <TextBlock x:Name="txtNguongTruc" Text="ngưỡng 14.0 t" FontSize="10" Foreground="#94A3B8"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </Grid>
                            <Grid Height="8" Margin="0,6,0,0">
                                <Border CornerRadius="4" Background="#E2E8F0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="colTruc" Width="0*"/>
                                        <ColumnDefinition x:Name="colTrucConLai" Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="bdVachTruc" Grid.Column="0" CornerRadius="4" Background="#15803D"/>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="txtMoTaTruc" Text="" FontSize="10" Foreground="#64748B"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3"
                                    Padding="8,5" Margin="0,8,0,0">
                                <Grid>
                                    <TextBlock Text="Trọng lượng toàn tải" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock x:Name="txtToanTai" Text="0.0 t" FontSize="11" FontWeight="Bold"
                                               Foreground="#0F172A" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 3. CHÂN TRANG -->
            <Border Grid.Row="2" Style="{StaticResource KtFooter}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Info24" FontSize="13" Foreground="#64748B" Margin="0,0,6,0"/>
                        <TextBlock Text="Giai đoạn giao diện: thay đổi chỉ hiển thị trên màn hình, chưa ghi vào CSDL."
                                   FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource DesktopButton}" Height="32" IsCancel="True" Click="BtnHuy_Click">
                            <TextBlock Text="Hủy (Esc)"/>
                        </Button>
                        <Button x:Name="btnLuu" Style="{StaticResource PrimaryDesktopButton}" Height="32" Margin="0"
                                IsDefault="True" Click="BtnLuu_Click" ToolTip="Lưu hồ sơ (Enter hoặc Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                <TextBlock x:Name="txtNutLuu" Text="Thêm Toa Xe"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
