<Window x:Class="GUI.Views.KyThuat.Dialogs.LapTauKeoThaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Mô Phỏng Lập Tàu"
        Width="1210" Height="790"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUI;component/Views/KyThuat/Styles/KyThuatDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Nút X nhỏ trên thẻ toa (chỉ hiện khi rê chuột) -->
            <Style x:Key="NutThaoToa" TargetType="Button">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="9">
                                <TextBlock x:Name="Chu" Text="✕" FontSize="9" Foreground="#64748B"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#DC2626"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#DC2626"/>
                                    <Setter TargetName="Chu" Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================================================================= -->
            <!-- THẺ TOA TRONG ĐOÀN TÀU (có số thứ tự móc nối + bánh xe)           -->
            <!-- ================================================================= -->
            <DataTemplate x:Key="MauToaDoanTau">
                <StackPanel Width="108" Margin="0,0,6,0">
                    <Border x:Name="bdThe" Height="88" CornerRadius="4" BorderThickness="1.5"
                            Background="{Binding MauNen}" BorderBrush="{Binding MauVien}"
                            Cursor="SizeAll" ToolTip="{Binding MoTaChiTiet}"
                            PreviewMouseLeftButtonDown="The_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="The_PreviewMouseMove">
                        <Grid Margin="7,5,5,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="#003B73">
                                        <TextBlock Text="{Binding ThuTu}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding LoaiCode}" FontSize="10" FontWeight="Bold"
                                               Foreground="{Binding MauChu}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button x:Name="btnThao" Style="{StaticResource NutThaoToa}" Click="BtnThaoToa_Click"
                                        HorizontalAlignment="Right" Visibility="Hidden" ToolTip="Tháo toa khỏi đoàn"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="{Binding SoHieu}" FontSize="12" FontWeight="Bold"
                                       Foreground="#0F172A" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="2" Text="{Binding MoTaNgan}" FontSize="10" Foreground="#64748B"
                                       Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding NhanSucChua}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{Binding MauChu}"/>
                                <ui:SymbolIcon x:Name="icoVuotTruc" Symbol="Warning24" FontSize="12" Foreground="#DC2626"
                                               Margin="5,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Hai giá chuyển hướng -->
                    <Grid Height="8" Margin="12,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Ellipse Width="7" Height="7" Fill="#334155" Margin="0,1,3,0"/>
                            <Ellipse Width="7" Height="7" Fill="#334155" Margin="0,1,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Ellipse Width="7" Height="7" Fill="#334155" Margin="0,1,3,0"/>
                            <Ellipse Width="7" Height="7" Fill="#334155" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <DataTemplate.Triggers>
                    <Trigger SourceName="bdThe" Property="IsMouseOver" Value="True">
                        <Setter TargetName="btnThao" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="bdThe" Property="BorderBrush" Value="#003B73"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding VuotTaiTrongTruc}" Value="True">
                        <Setter TargetName="icoVuotTruc" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="bdThe" Property="BorderBrush" Value="#F87171"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- ================================================================= -->
            <!-- THẺ TOA NẰM Ở BÃI                                                 -->
            <!-- ================================================================= -->
            <DataTemplate x:Key="MauToaBai">
                <Border x:Name="bdThe" Width="170" Height="62" Margin="0,0,8,8" CornerRadius="4" BorderThickness="1"
                        Background="#FFFFFF" BorderBrush="#E2E8F0"
                        Cursor="SizeAll" ToolTip="{Binding MoTaChiTiet}"
                        PreviewMouseLeftButtonDown="The_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="The_PreviewMouseMove">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="3,0,0,3" Background="{Binding MauChu}"/>
                        <Grid Grid.Column="1" Margin="9,6,8,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="{Binding SoHieu}" FontSize="12" FontWeight="Bold" Foreground="#0F172A"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,40,0"/>
                                <Border HorizontalAlignment="Right" CornerRadius="3" BorderThickness="1" Padding="6,0"
                                        Background="{Binding MauNen}" BorderBrush="{Binding MauVien}">
                                    <TextBlock Text="{Binding LoaiCode}" FontSize="9" FontWeight="Bold" Foreground="{Binding MauChu}"/>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding MoTaNgan}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding NhanSucChua}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding MauChu}"/>
                                <ui:SymbolIcon x:Name="icoVuotTruc" Symbol="Warning24" FontSize="12" Foreground="#DC2626"
                                               Margin="5,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="bdThe" Property="IsMouseOver" Value="True">
                        <Setter TargetName="bdThe" Property="BorderBrush" Value="#003B73"/>
                        <Setter TargetName="bdThe" Property="Background" Value="#F8FAFC"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding VuotTaiTrongTruc}" Value="True">
                        <Setter TargetName="icoVuotTruc" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Một hạng mục kiểm tra an toàn (đồng bộ với tab Lập Đoàn Tàu) -->
            <DataTemplate x:Key="MauHangMucAnToan">
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="3" Padding="10,8" Margin="0,0,0,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="{Binding BieuTuong}" FontSize="15"
                                       Foreground="{Binding MauSac}" Margin="0,0,9,0" VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding TenHangMuc}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding KetQua}" FontSize="10" Foreground="#64748B"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="bdGoc" Style="{StaticResource KtDialogKhung}" Margin="12"
            AllowDrop="True" PreviewDragOver="Goc_PreviewDragOver" DragOver="Goc_DragOver">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================================= -->
            <!-- 1. TIÊU ĐỀ                                                    -->
            <!-- ============================================================= -->
            <Border Grid.Row="0" Style="{StaticResource KtHeader}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="VehicleSubway24" FontSize="17" Foreground="#FFFFFF" Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MÔ PHỎNG LẬP TÀU KÉO – THẢ" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="txtTieuDePhu" Text="" Foreground="#BFDBFE" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource KtNutDong}" Click="BtnHuy_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Đóng (Esc)"/>
                </Grid>
            </Border>

            <!-- ============================================================= -->
            <!-- 2. THANH CÔNG CỤ: ĐẦU MÁY + THAO TÁC NHANH                    -->
            <!-- ============================================================= -->
            <Grid Grid.Row="1" Margin="16,12,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Đầu máy kéo chính:" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Column="1" x:Name="cboDauMay" Width="310" DisplayMemberPath="NhanHienThi"
                          SelectionChanged="CboDauMay_SelectionChanged"/>

                <Border Grid.Column="2" x:Name="bdDuongTranh" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                        CornerRadius="3" Padding="9,4" Margin="10,0,10,0" VerticalAlignment="Center"
                        ToolTip="Đường tránh ngắn nhất trên các ga tàu dừng của hành trình. Đoàn tàu phải lọt đường này để tránh / nhường tàu.">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Ruler24" FontSize="12" Foreground="#475569" Margin="0,0,6,0"/>
                        <TextBlock Text="Đường tránh ngắn nhất: " FontSize="11" Foreground="#475569"/>
                        <TextBlock x:Name="txtDuongTranh" Text="—" FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource DesktopButton}" Click="BtnTuDongSapXep_Click"
                            ToolTip="Xếp toa khách theo hạng (AN → BN → NML → NC), dồn toa hàng về cuối đoàn">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSort24" FontSize="12" Foreground="#003B73" Margin="0,0,5,0"/>
                            <TextBlock Text="Tự Động Sắp Xếp"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DesktopButton}" Click="BtnThaoHet_Click"
                            ToolTip="Tháo toàn bộ toa về bãi">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="12" Foreground="#64748B" Margin="0,0,5,0"/>
                            <TextBlock Text="Tháo Hết Toa"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DesktopButton}" Margin="0" Click="BtnDatLai_Click"
                            ToolTip="Quay về biên chế ban đầu của chuyến">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowReset24" FontSize="12" Foreground="#64748B" Margin="0,0,5,0"/>
                            <TextBlock Text="Đặt Lại"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================================================= -->
            <!-- 3. ĐOÀN TÀU (vùng thả chính)                                  -->
            <!-- ============================================================= -->
            <Border Grid.Row="2" Margin="16,0,16,10" Background="#FFFFFF" BorderBrush="#CBD5E1"
                    BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,7">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="VehicleSubway24" FontSize="13" Foreground="#003B73" Margin="0,0,8,0"/>
                                <TextBlock Text="ĐOÀN TÀU THEO THỨ TỰ MÓC NỐI" FontSize="11" FontWeight="Bold"
                                           Foreground="#003B73" VerticalAlignment="Center"/>
                                <Border Background="#E2E8F0" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtDemToaDoan" Text="0 toa" FontSize="10" FontWeight="Bold" Foreground="#334155"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Kéo để đổi vị trí  ·  nhấp đúp hoặc kéo xuống bãi để tháo toa  ·  "
                                           FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="12" Foreground="#003B73" Margin="0,0,3,0"
                                               VerticalAlignment="Center"/>
                                <TextBlock Text="Hướng chạy" FontSize="10" FontWeight="Bold" Foreground="#003B73"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" x:Name="bdVungDoanTau" Background="#FCFDFE" AllowDrop="True"
                            DragOver="DoanTau_DragOver" DragLeave="DoanTau_DragLeave" Drop="DoanTau_Drop">
                        <ScrollViewer x:Name="svDoanTau" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Grid x:Name="gridDoanTau" Margin="14,12,14,14" HorizontalAlignment="Left">

                                <!-- Đường ray -->
                                <Border Height="3" Background="#94A3B8" CornerRadius="1"
                                        VerticalAlignment="Bottom" Margin="-6,0,-6,-3"/>

                                <StackPanel Orientation="Horizontal">
                                    <!-- Đầu máy (cố định ở đầu đoàn) -->
                                    <StackPanel Width="134" Margin="0,0,8,0">
                                        <Border Height="88" Background="#003B73" BorderBrush="#002855" BorderThickness="1.5"
                                                CornerRadius="18,4,4,4" Padding="10,6,8,6"
                                                ToolTip="Đầu máy kéo chính — đổi ở ô chọn phía trên">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,0,0,0">
                                                    <ui:SymbolIcon Symbol="Engine24" FontSize="13" Foreground="#93C5FD" Margin="0,0,5,0"/>
                                                    <TextBlock x:Name="txtDauMayDong" Text="" FontSize="10" FontWeight="Bold"
                                                               Foreground="#93C5FD" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Grid.Row="1" x:Name="txtDauMaySoHieu" Text="Chưa chọn" FontSize="13"
                                                           FontWeight="Bold" Foreground="#FFFFFF" Margin="6,5,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="2" x:Name="txtDauMayThongSo" Text="" FontSize="10"
                                                           Foreground="#BFDBFE" Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                                            </Grid>
                                        </Border>
                                        <Grid Height="8" Margin="16,0,12,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Ellipse Width="8" Height="7" Fill="#0F172A" Margin="0,1,3,0"/>
                                                <Ellipse Width="8" Height="7" Fill="#0F172A" Margin="0,1,3,0"/>
                                                <Ellipse Width="8" Height="7" Fill="#0F172A" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Ellipse Width="8" Height="7" Fill="#0F172A" Margin="0,1,3,0"/>
                                                <Ellipse Width="8" Height="7" Fill="#0F172A" Margin="0,1,3,0"/>
                                                <Ellipse Width="8" Height="7" Fill="#0F172A" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Các toa đã móc nối -->
                                    <ItemsControl x:Name="icDoanTau" ItemTemplate="{StaticResource MauToaDoanTau}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <!-- Ô chờ ở cuối đoàn -->
                                    <Grid Width="112" Height="88" VerticalAlignment="Top">
                                        <Rectangle Stroke="#94A3B8" StrokeThickness="1.5" StrokeDashArray="4 3"
                                                   RadiusX="4" RadiusY="4" Fill="#F8FAFC"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Add24" FontSize="16" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="txtOCho" Text="Thả toa vào đây" FontSize="10" Foreground="#64748B"
                                                       TextAlignment="Center" TextWrapping="Wrap" Margin="6,3,6,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Vạch vàng báo vị trí sẽ chèn toa -->
                                <Canvas IsHitTestVisible="False">
                                    <Border x:Name="vachChen" Width="4" Height="100" CornerRadius="2"
                                            Background="#F59E0B" Visibility="Collapsed"/>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================================= -->
            <!-- 4. SỐ LIỆU TỔNG HỢP                                           -->
            <!-- ============================================================= -->
            <Grid Grid.Row="3" Margin="16,0,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Số toa -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="11,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <ui:SymbolIcon Symbol="Couch24" FontSize="12" Foreground="#003B73" Margin="0,0,6,0"/>
                            <TextBlock Text="SỐ TOA TRONG ĐOÀN" FontSize="10" FontWeight="Bold" Foreground="#003B73"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtSoToa" Text="0" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="txtSoToaGioiHan" Text=" / 20 toa" FontSize="11" Foreground="#64748B"
                                       VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        </StackPanel>
                        <TextBlock x:Name="txtSoToaPhu" Text="" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Chiều dài -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="11,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <ui:SymbolIcon Symbol="Ruler24" FontSize="12" Foreground="#4338CA" Margin="0,0,6,0"/>
                            <TextBlock Text="CHIỀU DÀI ĐOÀN TÀU" FontSize="10" FontWeight="Bold" Foreground="#4338CA"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtChieuDai" Text="0.0 m" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="txtChieuDaiGioiHan" Text="" FontSize="11" Foreground="#64748B"
                                       VerticalAlignment="Bottom" Margin="5,0,0,2"/>
                        </StackPanel>
                        <Grid Height="6" Margin="0,4,0,0">
                            <Border CornerRadius="3" Background="#E2E8F0"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="colDaiDaDung" Width="0*"/>
                                    <ColumnDefinition x:Name="colDaiConLai" Width="100*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="bdVachDai" Grid.Column="0" CornerRadius="3" Background="#15803D"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Trọng lượng kéo -->
                <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="11,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <ui:SymbolIcon Symbol="Gauge24" FontSize="12" Foreground="#15803D" Margin="0,0,6,0"/>
                            <TextBlock Text="TRỌNG LƯỢNG KÉO (TOÀN TẢI)" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="txtTrongLuong" Text="0.0 t" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="txtTrongLuongGioiHan" Text="" FontSize="11" Foreground="#64748B"
                                       VerticalAlignment="Bottom" Margin="5,0,0,2"/>
                        </StackPanel>
                        <Grid Height="6" Margin="0,4,0,0">
                            <Border CornerRadius="3" Background="#E2E8F0"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="colTaiDaDung" Width="0*"/>
                                    <ColumnDefinition x:Name="colTaiConLai" Width="100*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="bdVachTai" Grid.Column="0" CornerRadius="3" Background="#15803D"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sức chứa -->
                <Border Grid.Column="6" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="11,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <ui:SymbolIcon Symbol="People24" FontSize="12" Foreground="#B45309" Margin="0,0,6,0"/>
                            <TextBlock Text="SỨC CHỨA HÀNH KHÁCH" FontSize="10" FontWeight="Bold" Foreground="#B45309"/>
                        </StackPanel>
                        <TextBlock x:Name="txtSucChua" Text="0 chỗ" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock x:Name="txtSucChuaPhu" Text="" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================================= -->
            <!-- 5. BÃI TOA + KIỂM TRA AN TOÀN                                 -->
            <!-- ============================================================= -->
            <Grid Grid.Row="4" Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- ====== BÃI TOA ====== -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,7">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Couch24" FontSize="13" Foreground="#003B73" Margin="0,0,8,0"/>
                                    <TextBlock Text="BÃI TOA SẴN SÀNG" FontSize="11" FontWeight="Bold"
                                               Foreground="#003B73" VerticalAlignment="Center"/>
                                    <Border Background="#E2E8F0" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtDemBai" Text="0 toa" FontSize="10" FontWeight="Bold" Foreground="#334155"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Đội toa trong CSDL + toa mẫu mô phỏng  ·  nhấp đúp để móc vào cuối đoàn"
                                           FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Bộ lọc nhanh -->
                        <Grid Grid.Row="1" Margin="12,9,12,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel Grid.Column="0">
                                <RadioButton x:Name="rdoLocTatCa" GroupName="LocBai" Content="Tất cả" IsChecked="True"
                                             Style="{StaticResource KtChipRadio}" Checked="BoLocBai_Changed"/>
                                <RadioButton x:Name="rdoLocNgoi" GroupName="LocBai" Content="Toa ngồi (NC, NML)" Tag="#1D4ED8"
                                             Style="{StaticResource KtChipRadio}" Checked="BoLocBai_Changed"/>
                                <RadioButton x:Name="rdoLocNam" GroupName="LocBai" Content="Toa nằm (BN, AN)" Tag="#15803D"
                                             Style="{StaticResource KtChipRadio}" Checked="BoLocBai_Changed"/>
                                <RadioButton x:Name="rdoLocHang" GroupName="LocBai" Content="Toa hàng (G, M, P)" Tag="#475569"
                                             Style="{StaticResource KtChipRadio}" Checked="BoLocBai_Changed"/>
                            </WrapPanel>
                            <Grid Grid.Column="1" Width="170" VerticalAlignment="Top">
                                <TextBox x:Name="txtTimBai" TextChanged="TxtTimBai_TextChanged" Padding="24,0,6,0"/>
                                <ui:SymbolIcon Symbol="Search24" FontSize="12" Foreground="#94A3B8"
                                               HorizontalAlignment="Left" Margin="8,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock x:Name="txtGoiYTimBai" Text="Tìm số hiệu toa..." FontSize="11" Foreground="#94A3B8"
                                           Margin="25,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>

                        <!-- Vùng bãi toa: cũng là vùng thả để tháo toa -->
                        <Border Grid.Row="2" x:Name="bdVungBai" Background="#FFFFFF" CornerRadius="0,0,3,3" AllowDrop="True"
                                DragOver="Bai_DragOver" DragLeave="Bai_DragLeave" Drop="Bai_Drop">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,6,4,4">
                                    <ItemsControl x:Name="icBaiToa" ItemTemplate="{StaticResource MauToaBai}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock x:Name="txtBaiTrong" Text="Không còn toa nào phù hợp bộ lọc."
                                           FontSize="11" FontStyle="Italic" Foreground="#94A3B8"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                                <!-- Lớp phủ khi kéo toa từ đoàn xuống -->
                                <Grid x:Name="lopThaoToa" Visibility="Collapsed" IsHitTestVisible="False" Margin="6">
                                    <Rectangle Fill="#E6FEF2F2" Stroke="#DC2626" StrokeThickness="1.5" StrokeDashArray="5 3"
                                               RadiusX="4" RadiusY="4"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="22" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Thả vào đây để tháo toa khỏi đoàn" FontSize="12" FontWeight="Bold"
                                                   Foreground="#B91C1C" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ====== KIỂM TRA AN TOÀN ====== -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="13" Foreground="#003B73" Margin="0,0,8,0"/>
                                <TextBlock Text="KIỂM TRA AN TOÀN TRỰC TIẾP" FontSize="11" FontWeight="Bold"
                                           Foreground="#003B73" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
                            <StackPanel>
                                <Border x:Name="bdKetLuan" Background="#F1F5F9" BorderBrush="#CBD5E1"
                                        BorderThickness="1" CornerRadius="3" Padding="11,9" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon x:Name="icoKetLuan" Symbol="Info24" FontSize="20"
                                                       Foreground="#475569" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="txtKetLuan" Text="—" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                                            <TextBlock x:Name="txtKetLuanPhu" Text="" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <ItemsControl x:Name="icHangMucAnToan" ItemTemplate="{StaticResource MauHangMucAnToan}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================= -->
            <!-- 6. CHÂN TRANG                                                 -->
            <!-- ============================================================= -->
            <Border Grid.Row="5" Style="{StaticResource KtFooter}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Info24" FontSize="13" Foreground="#64748B" Margin="0,0,6,0"/>
                        <TextBlock Text="Giai đoạn giao diện: phương án chỉ hiển thị trên tab Lập Đoàn Tàu, chưa ghi vào CSDL."
                                   FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource DesktopButton}" Height="32" Click="BtnHuy_Click">
                            <TextBlock Text="Hủy (Esc)"/>
                        </Button>
                        <Button Style="{StaticResource PrimaryDesktopButton}" Height="32" Margin="0"
                                Click="BtnXacNhan_Click" ToolTip="Xác nhận phương án lập tàu (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                <TextBlock Text="Xác Nhận Lập Tàu"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
