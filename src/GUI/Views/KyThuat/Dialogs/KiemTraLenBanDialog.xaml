<Window x:Class="GUI.Views.KyThuat.Dialogs.KiemTraLenBanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Kiểm Tra Điều Kiện Lên Ban"
        Width="920" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUI;component/Views/KyThuat/Styles/KyThuatDialogStyles.xaml"/>
                <ResourceDictionary Source="/GUI;component/Views/KyThuat/Styles/KyThuatPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource KtDialogKhung}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TIÊU ĐỀ -->
            <Border Grid.Row="0" Style="{StaticResource KtHeader}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="HeartPulse24" FontSize="17" Foreground="#FFFFFF" Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtTieuDe" Text="KIỂM TRA ĐIỀU KIỆN LÊN BAN" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="txtTieuDePhu" Text="" Foreground="#BFDBFE" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource KtNutDong}" Click="BtnHuy_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Đóng (Esc)"/>
                </Grid>
            </Border>

            <!-- THÂN -->
            <StackPanel Grid.Row="1" Margin="18,14,18,6">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="KẾT QUẢ ĐO TRƯỚC GIỜ NHẬN BAN" Style="{StaticResource KtTieuDeMuc}" Margin="0"/>
                    <TextBlock x:Name="txtGioNhanBan" FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Right"/>
                </Grid>

                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3">
                    <Grid x:Name="gridNhap"/>
                </Border>
                <TextBlock x:Name="txtLoi" Style="{StaticResource KtLoiTruong}"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KtTheXemTruoc}" Margin="0" Padding="11,8">
                        <StackPanel>
                            <TextBlock Text="Quy định" FontSize="11" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,3"/>
                            <TextBlock FontSize="11" Foreground="#334155" TextWrapping="Wrap"
                                       Text="Đủ điều kiện lên ban khi nồng độ cồn bằng 0.00 mg/L và đã nghỉ ít nhất 8.0 giờ trước ca. Kết quả đã ghi không sửa được — đo lại thì ghi lần mới, lần không đạt vẫn giữ trong sổ."/>
                            <TextBlock FontSize="10" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Giờ nghỉ được điền sẵn theo lịch phân công (giờ bàn giao ca trước → giờ nhận ban); sửa nếu thực tế khác."/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" x:Name="bdTomTat" Style="{StaticResource KtTheXemTruoc}" Margin="0" Padding="11,8">
                        <StackPanel>
                            <TextBlock x:Name="txtTomTat" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtTomTatPhu" FontSize="11" Foreground="#334155" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- CHÂN TRANG -->
            <Border Grid.Row="2" Style="{StaticResource KtFooter}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Info24" FontSize="13" Foreground="#64748B" Margin="0,0,6,0"/>
                        <TextBlock Text="Nhập tay theo máy đo (không nối thiết bị). Giai đoạn giao diện: chưa ghi vào CSDL."
                                   FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource DesktopButton}" Height="32" IsCancel="True" Click="BtnHuy_Click">
                            <TextBlock Text="Hủy (Esc)"/>
                        </Button>
                        <Button x:Name="btnLuu" Style="{StaticResource PrimaryDesktopButton}" Height="32" Margin="0"
                                Click="BtnLuu_Click" ToolTip="Ghi kết quả (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                <TextBlock Text="Ghi Kết Quả"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
