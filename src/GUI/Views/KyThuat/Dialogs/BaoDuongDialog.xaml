<Window x:Class="GUI.Views.KyThuat.Dialogs.BaoDuongDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Ghi Nhận Bảo Dưỡng Định Kỳ"
        Width="820" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUI;component/Views/KyThuat/Styles/KyThuatDialogStyles.xaml"/>
                <ResourceDictionary Source="/GUI;component/Views/KyThuat/Styles/KyThuatPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Lề 12px để bóng đổ không bị cắt -->
    <Border Style="{StaticResource KtDialogKhung}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================================= -->
            <!-- 1. TIÊU ĐỀ                                                    -->
            <!-- ============================================================= -->
            <Border Grid.Row="0" Style="{StaticResource KtHeader}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="WrenchScrewdriver24" FontSize="17" Foreground="#FFFFFF" Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtTieuDe" Text="GHI NHẬN BẢO DƯỠNG ĐỊNH KỲ"
                                       Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="txtTieuDePhu" Text="Đầu máy cấp R1 / R2 · toa xe cấp D1 / D2"
                                       Foreground="#BFDBFE" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource KtNutDong}" Click="BtnHuy_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Đóng (Esc)"/>
                </Grid>
            </Border>

            <!-- ============================================================= -->
            <!-- 2. THÂN: FORM BÊN TRÁI + XEM TRƯỚC BÊN PHẢI                   -->
            <!-- ============================================================= -->
            <Grid Grid.Row="1" Margin="18,14,18,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- ====== FORM ====== -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PHƯƠNG TIỆN" Style="{StaticResource KtTieuDeMuc}"/>

                    <TextBlock Text="Loại phương tiện" Style="{StaticResource KtNhanTruong}"/>
                    <WrapPanel Margin="0,2,0,6">
                        <RadioButton x:Name="rdoDauMay" GroupName="LoaiPhuongTien" Content="Đầu máy" Tag="#1D4ED8"
                                     Style="{StaticResource KtChipRadio}" Checked="LoaiPhuongTien_Checked"/>
                        <RadioButton x:Name="rdoToaXe" GroupName="LoaiPhuongTien" Content="Toa xe" Tag="#0F766E"
                                     Style="{StaticResource KtChipRadio}" Checked="LoaiPhuongTien_Checked"/>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource KtNhanTruong}">
                        <Run x:Name="runNhanPhuongTien" Text="Đầu máy"/><Run Text=" *" Foreground="#DC2626"/>
                    </TextBlock>
                    <ComboBox x:Name="cboPhuongTien" DisplayMemberPath="TenHienThi"
                              SelectionChanged="CboPhuongTien_SelectionChanged"/>
                    <TextBlock x:Name="txtLoiPhuongTien" Style="{StaticResource KtLoiTruong}"/>

                    <TextBlock Text="CẤP BẢO DƯỠNG &amp; KẾT QUẢ" Style="{StaticResource KtTieuDeMuc}" Margin="0,0,0,8"/>

                    <TextBlock Style="{StaticResource KtNhanTruong}">
                        <Run Text="Cấp bảo dưỡng"/><Run Text=" *" Foreground="#DC2626"/>
                    </TextBlock>
                    <WrapPanel Margin="0,2,0,0">
                        <RadioButton x:Name="rdoCap1" GroupName="CapBaoDuong" Content="R1" Tag="#1D4ED8"
                                     Style="{StaticResource KtChipRadio}" Checked="CapBaoDuong_Checked"/>
                        <RadioButton x:Name="rdoCap2" GroupName="CapBaoDuong" Content="R2" Tag="#6D28D9"
                                     Style="{StaticResource KtChipRadio}" Checked="CapBaoDuong_Checked"/>
                    </WrapPanel>
                    <TextBlock x:Name="txtMoTaCap" Style="{StaticResource KtGoiY}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="txtLoiCap" Style="{StaticResource KtLoiTruong}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource KtNhanTruong}">
                                <Run Text="Số km tại thời điểm"/><Run Text=" *" Foreground="#DC2626"/>
                            </TextBlock>
                            <TextBox x:Name="txtSoKm" MaxLength="11" TextChanged="TruongNhap_TextChanged"
                                     ToolTip="Số km tích lũy của phương tiện lúc hoàn thành bảo dưỡng, 1 chữ số thập phân"/>
                            <TextBlock x:Name="txtLoiSoKm" Style="{StaticResource KtLoiTruong}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource KtNhanTruong}">
                                <Run Text="Người thực hiện"/><Run Text=" *" Foreground="#DC2626"/>
                            </TextBlock>
                            <ComboBox x:Name="cboNguoi" DisplayMemberPath="HoTenHienThi"
                                      SelectionChanged="CboNguoi_SelectionChanged"/>
                            <TextBlock x:Name="txtLoiNguoi" Style="{StaticResource KtLoiTruong}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="txtGoiYSoKm" Style="{StaticResource KtGoiY}" Margin="0,-4,0,8"/>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Ghi chú kỹ thuật" Style="{StaticResource KtNhanTruong}" VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="txtThoiDiem" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </Grid>
                    <TextBox x:Name="txtGhiChu" Height="58" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             ToolTip="Hạng mục đã làm, vật tư thay thế, lưu ý kỹ thuật"/>
                    <TextBlock Style="{StaticResource KtLoiTruong}"/>
                </StackPanel>

                <!-- ====== XEM TRƯỚC ====== -->
                <StackPanel Grid.Column="2">
                    <!-- Gợi ý cấp cần làm -->
                    <Border x:Name="bdGoiYCap" Visibility="Collapsed" Style="{StaticResource KtTheXemTruoc}" Padding="11,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="icoGoiYCap" Grid.Column="0" Symbol="Warning24" FontSize="16"
                                           Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock x:Name="txtGoiYCap" Grid.Column="1" FontSize="10" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="txtTieuDeHienTai" Text="TÌNH TRẠNG HIỆN TẠI" Style="{StaticResource KtTieuDeMuc}"/>
                    <ItemsControl x:Name="icTienDoHienTai" ItemTemplate="{StaticResource KtMauTienDoBaoDuong}" Margin="0,0,0,5"/>

                    <TextBlock Text="SAU KHI GHI NHẬN" Style="{StaticResource KtTieuDeMuc}"/>
                    <ItemsControl x:Name="icTienDoSau" ItemTemplate="{StaticResource KtMauTienDoBaoDuong}" Margin="0,0,0,5"/>

                    <TextBlock x:Name="txtGhiChuChuKy" Style="{StaticResource KtGoiY}"
                               Text="Chu kỳ đầu máy theo tham số hệ thống; chu kỳ toa xe là số tham khảo."/>
                </StackPanel>
            </Grid>

            <!-- ============================================================= -->
            <!-- 3. CHÂN TRANG                                                 -->
            <!-- ============================================================= -->
            <Border Grid.Row="2" Style="{StaticResource KtFooter}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Info24" FontSize="13" Foreground="#64748B" Margin="0,0,6,0"/>
                        <TextBlock Text="Giai đoạn giao diện: phiếu chỉ hiển thị trên màn hình, chưa ghi vào CSDL."
                                   FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource DesktopButton}" Height="32" IsCancel="True" Click="BtnHuy_Click">
                            <TextBlock Text="Hủy (Esc)"/>
                        </Button>
                        <Button x:Name="btnLuu" Style="{StaticResource PrimaryDesktopButton}" Height="32" Margin="0"
                                Click="BtnLuu_Click" ToolTip="Lưu phiếu bảo dưỡng (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                <TextBlock x:Name="txtNutLuu" Text="Lưu Phiếu Bảo Dưỡng"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
