<Window x:Class="GUI.Views.KyThuat.Dialogs.DauMayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Hồ Sơ Đầu Máy"
        Width="740" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUI;component/Views/KyThuat/Styles/KyThuatDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Lề 12px để bóng đổ không bị cắt -->
    <Border Style="{StaticResource KtDialogKhung}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================================= -->
            <!-- 1. TIÊU ĐỀ                                                    -->
            <!-- ============================================================= -->
            <Border Grid.Row="0" Style="{StaticResource KtHeader}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Engine24" FontSize="17" Foreground="#FFFFFF" Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtTieuDe" Text="THÊM MỚI ĐẦU MÁY"
                                       Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="txtTieuDePhu" Text="Khai báo hồ sơ đầu máy mới vào đội phương tiện"
                                       Foreground="#BFDBFE" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource KtNutDong}" Click="BtnHuy_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Đóng (Esc)"/>
                </Grid>
            </Border>

            <!-- ============================================================= -->
            <!-- 2. THÂN: FORM BÊN TRÁI + XEM TRƯỚC BÊN PHẢI                   -->
            <!-- ============================================================= -->
            <Grid Grid.Row="1" Margin="18,14,18,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="262"/>
                </Grid.ColumnDefinitions>

                <!-- ====== FORM ====== -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="THÔNG TIN ĐỊNH DANH" Style="{StaticResource KtTieuDeMuc}"/>

                    <!-- Số hiệu -->
                    <TextBlock Style="{StaticResource KtNhanTruong}">
                        <Run Text="Số hiệu đầu máy"/><Run Text=" *" Foreground="#DC2626"/>
                    </TextBlock>
                    <TextBox x:Name="txtSoHieu" MaxLength="20" CharacterCasing="Upper"
                             TextChanged="TruongNhap_TextChanged"
                             ToolTip="Mã định danh duy nhất, dạng DÒNG-SỐ. Ví dụ: D19E-904"/>
                    <TextBlock x:Name="txtLoiSoHieu" Style="{StaticResource KtLoiTruong}"/>

                    <!-- Dòng đầu máy -->
                    <TextBlock Style="{StaticResource KtNhanTruong}">
                        <Run Text="Dòng đầu máy"/><Run Text=" *" Foreground="#DC2626"/>
                    </TextBlock>
                    <ComboBox x:Name="cboDongMay" DisplayMemberPath="TenHienThi"
                              SelectionChanged="CboDongMay_SelectionChanged"/>
                    <TextBlock x:Name="txtLoiDongMay" Style="{StaticResource KtLoiTruong}"/>

                    <!-- Xí nghiệp -->
                    <TextBlock Style="{StaticResource KtNhanTruong}">
                        <Run Text="Xí nghiệp quản lý (depot)"/><Run Text=" *" Foreground="#DC2626"/>
                    </TextBlock>
                    <ComboBox x:Name="cboXiNghiep" IsEditable="True"
                              ToolTip="Chọn trong danh sách hoặc gõ tên xí nghiệp mới (tối đa 50 ký tự)"/>
                    <TextBlock x:Name="txtLoiXiNghiep" Style="{StaticResource KtLoiTruong}"/>

                    <TextBlock Text="THÔNG TIN KHAI THÁC" Style="{StaticResource KtTieuDeMuc}" Margin="0,4,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource KtNhanTruong}">
                                <Run Text="Năm sản xuất"/><Run Text=" *" Foreground="#DC2626"/>
                            </TextBlock>
                            <TextBox x:Name="txtNamSanXuat" MaxLength="4" TextChanged="TruongNhap_TextChanged"/>
                            <TextBlock x:Name="txtLoiNamSanXuat" Style="{StaticResource KtLoiTruong}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Số km tích lũy" Style="{StaticResource KtNhanTruong}"/>
                            <TextBox x:Name="txtSoKm" TextChanged="TruongNhap_TextChanged"
                                     ToolTip="Tổng quãng đường đã chạy, dùng để tính chu kỳ bảo dưỡng R1 / R2 / Ro"/>
                            <TextBlock x:Name="txtLoiSoKm" Style="{StaticResource KtLoiTruong}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Trạng thái -->
                    <TextBlock Text="Trạng thái khai thác" Style="{StaticResource KtNhanTruong}"/>
                    <WrapPanel Margin="0,2,0,0">
                        <RadioButton x:Name="rdoSanSang" GroupName="TrangThaiDauMay" Content="Sẵn sàng" Tag="#16A34A"
                                     Style="{StaticResource KtChipRadio}" Checked="TrangThai_Checked"/>
                        <RadioButton x:Name="rdoDangChay" GroupName="TrangThaiDauMay" Content="Đang chạy" Tag="#2563EB"
                                     Style="{StaticResource KtChipRadio}" Checked="TrangThai_Checked"/>
                        <RadioButton x:Name="rdoBaoDuong" GroupName="TrangThaiDauMay" Content="Bảo dưỡng" Tag="#D97706"
                                     Style="{StaticResource KtChipRadio}" Checked="TrangThai_Checked"/>
                    </WrapPanel>

                    <!-- Gợi ý chuyển trạng thái khi sát mốc bảo dưỡng -->
                    <Border x:Name="bdGoiYTrangThai" Visibility="Collapsed"
                            Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="3"
                            Padding="10,7" Margin="0,4,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Warning24" FontSize="14" Foreground="#B45309"
                                           Margin="0,0,8,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" x:Name="txtGoiYTrangThai" FontSize="10" Foreground="#92400E"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" x:Name="btnChuyenBaoDuong" Click="BtnChuyenBaoDuong_Click"
                                    Style="{StaticResource DesktopButton}" Height="24" Margin="8,0,0,0" Padding="8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Chuyển sang Bảo dưỡng" FontSize="10"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ====== XEM TRƯỚC ====== -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="THÔNG SỐ DÒNG MÁY" Style="{StaticResource KtTieuDeMuc}"/>
                    <Border Style="{StaticResource KtTheXemTruoc}" Padding="11,4">
                        <StackPanel x:Name="pnlThongSoDong"/>
                    </Border>

                    <TextBlock Text="CHU KỲ BẢO DƯỠNG DỰ KIẾN" Style="{StaticResource KtTieuDeMuc}"/>
                    <Border Style="{StaticResource KtTheXemTruoc}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock x:Name="txtCapKeTiep" Text="Cấp kế tiếp: —" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#0F172A" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="txtTyLeBaoDuong" Text="0%" FontSize="11" FontWeight="Bold"
                                           Foreground="#15803D" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Height="8">
                                <Border CornerRadius="4" Background="#E2E8F0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="colDaChay" Width="0*"/>
                                        <ColumnDefinition x:Name="colConLai" Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="bdVachBaoDuong" Grid.Column="0" CornerRadius="4" Background="#15803D"/>
                                </Grid>
                            </Grid>
                            <TextBlock x:Name="txtMoTaBaoDuong" Text="Nhập số km để xem tiến độ." FontSize="10"
                                       Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource KtTheXemTruoc}" Background="#EFF6FF" BorderBrush="#BFDBFE" Margin="0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="TUỔI KHAI THÁC" FontSize="9" FontWeight="Bold" Foreground="#1D4ED8"/>
                                <TextBlock x:Name="txtTuoiKhaiThac" Text="—" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                            <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="22" Foreground="#93C5FD"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ============================================================= -->
            <!-- 3. CHÂN TRANG                                                 -->
            <!-- ============================================================= -->
            <Border Grid.Row="2" Style="{StaticResource KtFooter}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Info24" FontSize="13" Foreground="#64748B" Margin="0,0,6,0"/>
                        <TextBlock Text="Giai đoạn giao diện: thay đổi chỉ hiển thị trên màn hình, chưa ghi vào CSDL."
                                   FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource DesktopButton}" Height="32" IsCancel="True" Click="BtnHuy_Click">
                            <TextBlock Text="Hủy (Esc)"/>
                        </Button>
                        <Button x:Name="btnLuu" Style="{StaticResource PrimaryDesktopButton}" Height="32" Margin="0"
                                IsDefault="True" Click="BtnLuu_Click" ToolTip="Lưu hồ sơ (Enter hoặc Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                <TextBlock x:Name="txtNutLuu" Text="Thêm Đầu Máy"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
