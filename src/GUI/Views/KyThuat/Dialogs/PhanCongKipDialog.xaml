<Window x:Class="GUI.Views.KyThuat.Dialogs.PhanCongKipDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Phân Công Kíp Lái"
        Width="980" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUI;component/Views/KyThuat/Styles/KyThuatDialogStyles.xaml"/>
                <ResourceDictionary Source="/GUI;component/Views/KyThuat/Styles/KyThuatPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Ứng viên cho một vị trí (UngVienKip). Dòng phụ chỉ hiện trong danh sách thả xuống. -->
            <DataTemplate x:Key="MauUngVien">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding MaNVCode}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding HoTen}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding TomTat}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding MauTomTat}"
                               Margin="8,0,0,0" MaxWidth="170" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="phuDe" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PhuDe}"
                               FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}}" Value="{x:Null}">
                        <Setter TargetName="phuDe" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource KtDialogKhung}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TIÊU ĐỀ -->
            <Border Grid.Row="0" Style="{StaticResource KtHeader}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="17" Foreground="#FFFFFF" Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtTieuDe" Text="PHÂN CÔNG KÍP LÁI" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="txtTieuDePhu" Text="" Foreground="#BFDBFE" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource KtNutDong}" Click="BtnHuy_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Đóng (Esc)"/>
                </Grid>
            </Border>

            <!-- THÂN -->
            <Grid Grid.Row="1" Margin="18,14,18,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ====== FORM ====== -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CHUYẾN VÀ CHẶNG" Style="{StaticResource KtTieuDeMuc}"/>
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="9,6" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="txtChuyen" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock x:Name="txtChuyenPhu" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource KtNhanTruong}">
                                <Run Text="Ga nhận ban"/><Run Text=" *" Foreground="#DC2626"/>
                            </TextBlock>
                            <ComboBox x:Name="cboGaNhan" DisplayMemberPath="TenGa" SelectionChanged="CboGaNhan_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource KtNhanTruong}">
                                <Run Text="Ga bàn giao"/><Run Text=" *" Foreground="#DC2626"/>
                            </TextBlock>
                            <ComboBox x:Name="cboGaGiao" DisplayMemberPath="TenGa" SelectionChanged="CboGaGiao_SelectionChanged"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="txtLoiChang" Style="{StaticResource KtLoiTruong}"/>
                    <TextBlock x:Name="txtKhungGio" FontSize="11" Foreground="#334155" TextWrapping="Wrap" Margin="0,-2,0,10"/>

                    <Border x:Name="bdThay" Visibility="Collapsed" Background="#FFFBEB" BorderBrush="#B45309"
                            BorderThickness="3,0,0,0" Padding="9,6" Margin="0,0,0,10">
                        <TextBlock x:Name="txtThay" FontSize="11" Foreground="#0F172A" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="THÀNH VIÊN KÍP" Style="{StaticResource KtTieuDeMuc}"/>

                    <TextBlock Style="{StaticResource KtNhanTruong}">
                        <Run Text="Lái tàu"/><Run Text=" *" Foreground="#DC2626"/>
                    </TextBlock>
                    <ComboBox x:Name="cboLaiTau" ItemTemplate="{StaticResource MauUngVien}" SelectionChanged="CboThanhVien_SelectionChanged"
                              MaxDropDownHeight="300"/>
                    <TextBlock x:Name="txtLoiLaiTau" Style="{StaticResource KtLoiTruong}"/>

                    <TextBlock Style="{StaticResource KtNhanTruong}">
                        <Run Text="Phụ lái"/><Run Text=" *" Foreground="#DC2626"/>
                    </TextBlock>
                    <ComboBox x:Name="cboPhuLai" ItemTemplate="{StaticResource MauUngVien}" SelectionChanged="CboThanhVien_SelectionChanged"
                              MaxDropDownHeight="300"/>
                    <TextBlock x:Name="txtLoiPhuLai" Style="{StaticResource KtLoiTruong}"/>

                    <TextBlock Style="{StaticResource KtNhanTruong}">
                        <Run Text="Trưởng tàu"/><Run Text=" *" Foreground="#DC2626"/>
                    </TextBlock>
                    <ComboBox x:Name="cboTruongTau" ItemTemplate="{StaticResource MauUngVien}" SelectionChanged="CboThanhVien_SelectionChanged"
                              MaxDropDownHeight="300"/>
                    <TextBlock x:Name="txtLoiTruongTau" Style="{StaticResource KtLoiTruong}"/>

                    <TextBlock Style="{StaticResource KtGoiY}" Margin="0,0,0,6"
                               Text="Danh sách chỉ gồm người đúng chức danh, người đủ điều kiện xếp trước. Chữ đỏ là lý do không phân công được."/>
                </StackPanel>

                <!-- ====== ĐỐI CHIẾU ====== -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ĐỐI CHIẾU ĐIỀU KIỆN" Style="{StaticResource KtTieuDeMuc}"/>
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Margin="0,0,0,10">
                        <Grid x:Name="gridDoiChieu"/>
                    </Border>

                    <Border x:Name="bdKetLuan" Style="{StaticResource KtTheXemTruoc}" Padding="11,8">
                        <StackPanel>
                            <TextBlock x:Name="txtKetLuan" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="txtKetLuanPhu" FontSize="11" Foreground="#334155" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource KtGoiY}"
                               Text="✓ đạt    ✗ vi phạm, không lưu được    ! cần lưu ý, vẫn lưu được    – không áp dụng / chưa có dữ liệu"/>
                </StackPanel>
            </Grid>

            <!-- CHÂN TRANG -->
            <Border Grid.Row="2" Style="{StaticResource KtFooter}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Info24" FontSize="13" Foreground="#64748B" Margin="0,0,6,0"/>
                        <TextBlock Text="Giai đoạn giao diện: kíp chỉ hiển thị trên màn hình, chưa ghi vào CSDL."
                                   FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource DesktopButton}" Height="32" IsCancel="True" Click="BtnHuy_Click">
                            <TextBlock Text="Hủy (Esc)"/>
                        </Button>
                        <Button x:Name="btnLuu" Style="{StaticResource PrimaryDesktopButton}" Height="32" Margin="0"
                                Click="BtnLuu_Click" ToolTip="Lưu phân công (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                <TextBlock x:Name="txtNutLuu" Text="Lưu Phân Công"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
