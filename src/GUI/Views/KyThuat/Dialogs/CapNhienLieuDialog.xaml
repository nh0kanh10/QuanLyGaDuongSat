<Window x:Class="GUI.Views.KyThuat.Dialogs.CapNhienLieuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Phiếu Cấp Phát Nhiên Liệu"
        Width="820" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUI;component/Views/KyThuat/Styles/KyThuatDialogStyles.xaml"/>
                <ResourceDictionary Source="/GUI;component/Views/KyThuat/Styles/KyThuatPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Lề 12px để bóng đổ không bị cắt -->
    <Border Style="{StaticResource KtDialogKhung}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============================================================= -->
            <!-- 1. TIÊU ĐỀ                                                    -->
            <!-- ============================================================= -->
            <Border Grid.Row="0" Style="{StaticResource KtHeader}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="GasPump24" FontSize="17" Foreground="#FFFFFF" Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtTieuDe" Text="CẤP PHÁT NHIÊN LIỆU ĐẦU MÁY"
                                       Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"/>
                            <TextBlock x:Name="txtTieuDePhu" Text="Ghi nhận lượng dầu trả nạp và tính suất tiêu hao so với định mức"
                                       Foreground="#BFDBFE" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource KtNutDong}" Click="BtnHuy_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Đóng (Esc)"/>
                </Grid>
            </Border>

            <!-- ============================================================= -->
            <!-- 2. THÂN: FORM BÊN TRÁI + XEM TRƯỚC BÊN PHẢI                   -->
            <!-- ============================================================= -->
            <Grid Grid.Row="1" Margin="18,14,18,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <!-- ====== FORM ====== -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="THÔNG TIN CẤP PHÁT" Style="{StaticResource KtTieuDeMuc}"/>

                    <!-- Đầu máy -->
                    <TextBlock Style="{StaticResource KtNhanTruong}">
                        <Run Text="Đầu máy được cấp dầu"/><Run Text=" *" Foreground="#DC2626"/>
                    </TextBlock>
                    <ComboBox x:Name="cboDauMay" DisplayMemberPath="TenHienThi"
                              SelectionChanged="CboDauMay_SelectionChanged"/>
                    <TextBlock x:Name="txtLoiDauMay" Style="{StaticResource KtLoiTruong}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource KtNhanTruong}">
                                <Run Text="Nơi cấp dầu"/><Run Text=" *" Foreground="#DC2626"/>
                            </TextBlock>
                            <ComboBox x:Name="cboNoiCap" IsEditable="True"
                                      ToolTip="Chọn trạm dầu hoặc gõ tên nơi cấp khác (tối đa 100 ký tự)"/>
                            <TextBlock x:Name="txtLoiNoiCap" Style="{StaticResource KtLoiTruong}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource KtNhanTruong}">
                                <Run Text="Người cấp phát"/><Run Text=" *" Foreground="#DC2626"/>
                            </TextBlock>
                            <ComboBox x:Name="cboNguoiCap" DisplayMemberPath="TenHienThi"
                                      SelectionChanged="CboNguoiCap_SelectionChanged"/>
                            <TextBlock x:Name="txtLoiNguoiCap" Style="{StaticResource KtLoiTruong}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="SỐ LIỆU CẤP PHÁT &amp; CÔNG TÁC KÉO" Style="{StaticResource KtTieuDeMuc}" Margin="0,2,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource KtNhanTruong}">
                                <Run Text="Số lít trả nạp"/><Run Text=" *" Foreground="#DC2626"/>
                            </TextBlock>
                            <TextBox x:Name="txtSoLit" MaxLength="10" TextChanged="TruongNhap_TextChanged"
                                     ToolTip="Lượng dầu diesel bơm vào bồn (lít), tối đa 2 chữ số thập phân"/>
                            <TextBlock x:Name="txtLoiSoLit" Style="{StaticResource KtLoiTruong}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource KtNhanTruong}">
                                <Run Text="Trọng lượng kéo (tấn)"/><Run Text=" *" Foreground="#DC2626"/>
                            </TextBlock>
                            <TextBox x:Name="txtTanKeo" MaxLength="9" TextChanged="TruongNhap_TextChanged"
                                     ToolTip="Tổng trọng lượng đoàn tàu đầu máy đã kéo trong quãng chạy (tấn)"/>
                            <TextBlock x:Name="txtLoiTanKeo" Style="{StaticResource KtLoiTruong}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource KtNhanTruong}">
                                <Run Text="Cự ly đã chạy (km)"/><Run Text=" *" Foreground="#DC2626"/>
                            </TextBlock>
                            <TextBox x:Name="txtCuLy" MaxLength="8" TextChanged="TruongNhap_TextChanged"
                                     ToolTip="Quãng đường chạy kể từ lần cấp dầu trước (km), 1 chữ số thập phân"/>
                            <TextBlock x:Name="txtLoiCuLy" Style="{StaticResource KtLoiTruong}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Lấy trọng lượng kéo từ đoàn tàu mà đầu máy đã / đang kéo -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3"
                            Padding="10,7" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="VehicleSubway24" FontSize="14" Foreground="#475569"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="cboDoanTau" DisplayMemberPath="TenHienThi"
                                      ToolTip="Các đoàn tàu có đầu máy này làm đầu máy chính hoặc đẩy"/>
                            <Button Grid.Column="2" x:Name="btnLayTrongLuong" Click="BtnLayTrongLuong_Click"
                                    Style="{StaticResource DesktopButton}" Height="28" Margin="8,0,0,0" Padding="10,0"
                                    ToolTip="Điền trọng lượng kéo = tổng trọng lượng của đoàn tàu đã chọn">
                                <TextBlock Text="Lấy trọng lượng" FontSize="11"/>
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="txtGoiYDoanTau" Style="{StaticResource KtGoiY}" Margin="0,-6,0,8"
                               Text="Chọn đoàn tàu để điền nhanh trọng lượng kéo."/>

                    <TextBlock Text="Thời điểm bơm dầu" Style="{StaticResource KtNhanTruong}"/>
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3"
                            Height="30" Padding="9,0" Margin="0,0,0,4">
                        <TextBlock x:Name="txtThoiDiem" Text="—" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="txtGoiYThoiDiem" Text="Tự ghi khi lưu" Style="{StaticResource KtGoiY}" Margin="0,0,0,8"/>
                </StackPanel>

                <!-- ====== XEM TRƯỚC ====== -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="SUẤT TIÊU HAO (TỰ TÍNH)" Style="{StaticResource KtTieuDeMuc}"/>
                    <Border x:Name="bdSfc" Style="{StaticResource KtTheXemTruoc}" Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtSfc" Text="—" FontSize="24" FontWeight="Bold" Foreground="#475569"/>
                                <TextBlock Text="lít / 10,000 tấn·km" FontSize="10" Foreground="#64748B"
                                           VerticalAlignment="Bottom" Margin="6,0,0,5"/>
                            </StackPanel>
                            <TextBlock x:Name="txtCongThuc" Text="= số lít × 10,000 ÷ (tấn kéo × km)" FontSize="10"
                                       Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,8"/>

                            <!-- Thanh 0 – 150% định mức, vạch 100% -->
                            <Grid Height="10">
                                <Border CornerRadius="5" Background="#E2E8F0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="colSfcDaDung" Width="0*"/>
                                        <ColumnDefinition x:Name="colSfcConLai" Width="150*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="bdSfcVach" Grid.Column="0" CornerRadius="5" Background="#94A3B8"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100*"/>
                                        <ColumnDefinition Width="50*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="1" Width="2" Fill="#0F172A" HorizontalAlignment="Left" Margin="-1,-2,0,-2"/>
                                </Grid>
                            </Grid>
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100*"/>
                                    <ColumnDefinition Width="50*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="txtNhanDinhMuc" Grid.Column="1" Text="▲ định mức" FontSize="9"
                                           Foreground="#0F172A" Margin="-4,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Kết luận -->
                    <Border x:Name="bdKetLuan" Style="{StaticResource KtTheXemTruoc}" Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="icoKetLuan" Grid.Column="0" Symbol="Info24" FontSize="22"
                                           Foreground="#94A3B8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="txtKetLuan" Text="CHỜ NHẬP SỐ LIỆU" FontSize="12" FontWeight="Bold"
                                           Foreground="#475569" TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtKetLuanPhu" Text="Nhập số lít, trọng lượng kéo và cự ly" FontSize="10"
                                           Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Bồn dầu -->
                    <TextBlock Text="MỨC NẠP SO VỚI BỒN DẦU" Style="{StaticResource KtTieuDeMuc}"/>
                    <Border Style="{StaticResource KtTheXemTruoc}" Padding="11,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <TextBlock x:Name="txtBon" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/>
                                <TextBlock x:Name="txtBonTyLe" Text="" FontSize="11" FontWeight="Bold" Foreground="#0284C7"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Height="8">
                                <Border CornerRadius="4" Background="#E2E8F0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="colBonDaNap" Width="0*"/>
                                        <ColumnDefinition x:Name="colBonConLai" Width="100*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="bdBonVach" Grid.Column="0" CornerRadius="4" Background="#0284C7"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ĐẦU MÁY" Style="{StaticResource KtTieuDeMuc}"/>
                    <Border Style="{StaticResource KtTheXemTruoc}" Padding="11,3" Margin="0">
                        <StackPanel x:Name="pnlDauMay"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ============================================================= -->
            <!-- 3. CHÂN TRANG                                                 -->
            <!-- ============================================================= -->
            <Border Grid.Row="2" Style="{StaticResource KtFooter}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Info24" FontSize="13" Foreground="#64748B" Margin="0,0,6,0"/>
                        <TextBlock Text="Giai đoạn giao diện: phiếu chỉ hiển thị trên màn hình, chưa ghi vào CSDL. Định mức là số tham khảo."
                                   FontSize="10" Foreground="#64748B" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource DesktopButton}" Height="32" IsCancel="True" Click="BtnHuy_Click">
                            <TextBlock Text="Hủy (Esc)"/>
                        </Button>
                        <Button x:Name="btnLuu" Style="{StaticResource PrimaryDesktopButton}" Height="32" Margin="0"
                                IsDefault="True" Click="BtnLuu_Click" ToolTip="Lưu phiếu cấp phát (Enter hoặc Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                <TextBlock x:Name="txtNutLuu" Text="Lưu Phiếu Cấp Phát"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
