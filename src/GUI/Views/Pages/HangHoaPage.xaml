<Page x:Class="GUI.Views.Pages.HangHoaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Quản Lý Vận Tải Hàng Hóa">

    <Grid Margin="12,10,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Form Chi Tiết Vận Đơn -->
            <RowDefinition Height="*"/>    <!-- DataGrid Danh Sách Vận Đơn -->
        </Grid.RowDefinitions>

        <!-- 1. GROUPBOX THÔNG TIN VẬN ĐƠN -->
        <GroupBox Grid.Row="0" Header="THÔNG TIN CHI TIẾT VẬN ĐƠN HÓA VẬN &amp; HÀNH LÝ KÝ GỬI">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Dòng 1: Mã VĐ, Mặt Hàng, Trọng Lượng, Cước Phí -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="95"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Mã Vận Đơn:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" x:Name="txtMaVD" FontFamily="Consolas" FontWeight="Bold" Foreground="#003B73"/>

                    <TextBlock Grid.Column="3" Text="Loại Hàng Hóa:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Column="4" x:Name="cboLoaiHang">
                        <ComboBoxItem Content="Xe máy tay ga / số (&lt;175cc)" Tag="1" IsSelected="True"/>
                        <ComboBoxItem Content="Hàng bách hóa tiêu dùng" Tag="2"/>
                        <ComboBoxItem Content="Nông sản đóng bao" Tag="3"/>
                        <ComboBoxItem Content="Container hàng điện tử" Tag="4"/>
                    </ComboBox>

                    <TextBlock Grid.Column="6" Text="Trọng Lượng (Tấn):" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="7" x:Name="txtTrongLuong" HorizontalContentAlignment="Right" Text="0.15" FontWeight="SemiBold"
                             LostFocus="TxtTrongLuong_LostFocus"/>

                    <TextBlock Grid.Column="9" Text="Cước Phí:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="10" x:Name="txtCuocPhi" HorizontalContentAlignment="Right" FontWeight="Bold" Foreground="#15803D" Text="650,000"
                             LostFocus="TxtCuocPhi_LostFocus"/>
                </Grid>

                <!-- Dòng 2: Người Gửi, Người Nhận, Ga Gửi, Ga Nhận -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Người Gửi:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" x:Name="txtNguoiGui" Text="Nguyễn Văn A (0912345678)"/>

                    <TextBlock Grid.Column="3" Text="Người Nhận:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="4" x:Name="txtNguoiNhan" Text="Trần Thị B (0987654321)"/>

                    <TextBlock Grid.Column="6" Text="Chặng Ga:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="7" x:Name="txtChangGa" IsReadOnly="True" Background="#F1F5F9" Text="Ga Hà Nội → Ga Sài Gòn"/>
                </Grid>

                <!-- Dòng 3: Hình Thức, Biển Số / Cont, Rút Xăng PCCC, Trạng Thái -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Hình Thức:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Column="1" x:Name="cboLoaiVC">
                        <ComboBoxItem Content="XE_MAY - Xe máy hành lý" IsSelected="True"/>
                        <ComboBoxItem Content="HANG_ROI - Hàng lẻ toa xe"/>
                        <ComboBoxItem Content="CONTAINER - Container đường sắt"/>
                    </ComboBox>

                    <TextBlock Grid.Column="3" Text="Biển Số / Cont:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="4" x:Name="txtBienSo" Text="29B1-123.45" FontFamily="Consolas"/>

                    <ui:ToggleSwitch Grid.Column="6" x:Name="chkDaRutXang" Content="Đã rút sạch xăng theo PCCC" IsChecked="True" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="8" Text="Trạng Thái:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Column="9" x:Name="cboTrangThaiVD">
                        <ComboBoxItem Content="TIEP_NHAN - Đã tiếp nhận tại ga" IsSelected="True"/>
                        <ComboBoxItem Content="DANG_CHO - Đang trên toa xe tàu"/>
                        <ComboBoxItem Content="DA_GIAO - Đã giao cho người nhận"/>
                    </ComboBox>
                </Grid>

                <!-- Dòng 4: Thanh Nút Desktop -->
                <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Click="BtnLapDonMoi_Click" Style="{StaticResource PrimaryDesktopButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Lập Vận Đơn Mới"/>
                            </StackPanel>
                        </Button>

                        <Button Click="BtnLuu_Click" Style="{StaticResource DesktopButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,6,0" Foreground="#003B73"/>
                                <TextBlock Text="Lưu Vận Đơn"/>
                            </StackPanel>
                        </Button>

                        <Button Click="BtnInPhieu_Click" Style="{StaticResource DesktopButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Print24" FontSize="14" Margin="0,0,6,0" Foreground="#0284C7"/>
                                <TextBlock Text="In Phiếu Gửi Hàng"/>
                            </StackPanel>
                        </Button>

                        <Button Click="BtnGiaoHang_Click" Style="{StaticResource DesktopButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Margin="0,0,6,0" Foreground="#15803D"/>
                                <TextBlock Text="Xác Nhận Đã Giao"/>
                            </StackPanel>
                        </Button>

                        <Button Click="BtnNapLai_Click" Style="{StaticResource DesktopButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Nạp Lại Dữ Liệu"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </GroupBox>

        <!-- 2. GROUPBOX BẢNG TRA CỨU VẬN ĐƠN -->
        <GroupBox Grid.Row="1" Header="DANH SÁCH VẬN ĐƠN HÓA VẬN &amp; THEO DÕI HÀNH TRÌNH HÀNG">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="Tìm kiếm vận đơn:" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtTimKiem" Width="280" Margin="0,0,8,0"/>
                        <Button Click="BtnTimKiem_Click" Style="{StaticResource DesktopButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Search24" FontSize="13" Margin="0,0,4,0"/>
                                <TextBlock Text="Tìm Kiếm"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnNapLai_Click" Style="{StaticResource DesktopButton}" Content="Hiển Thị Tất Cả"/>
                    </StackPanel>

                    <TextBlock x:Name="txtTongSo" Text="Tổng số: 0 vận đơn" FontSize="11" FontWeight="Bold" Foreground="#003B73" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <DataGrid Grid.Row="1" x:Name="dgVanDon" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" CanUserAddRows="False"
                          SelectionChanged="DgVanDon_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding MaVanDon}" Width="45"/>
                        <DataGridTextColumn Header="Mã Vận Đơn" Binding="{Binding MaVanDonCode}" Width="105">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#003B73"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Người Gửi" Binding="{Binding TenNguoiGui}" Width="130"/>
                        <DataGridTextColumn Header="SĐT Gửi" Binding="{Binding SDTNguoiGui}" Width="95"/>
                        <DataGridTextColumn Header="Ga Gửi" Binding="{Binding TenGaGui}" Width="100"/>
                        <DataGridTextColumn Header="Người Nhận" Binding="{Binding TenNguoiNhan}" Width="130"/>
                        <DataGridTextColumn Header="SĐT Nhận" Binding="{Binding SDTNguoiNhan}" Width="95"/>
                        <DataGridTextColumn Header="Ga Nhận" Binding="{Binding TenGaNhan}" Width="100"/>
                        <DataGridTextColumn Header="Loại Hàng Hóa" Binding="{Binding TenHangHoa}" Width="130"/>
                        <DataGridTextColumn Header="TL (Tấn)" Binding="{Binding TrongLuongTan, StringFormat={}{0:N2}}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Cước Phí (VNĐ)" Binding="{Binding CuocPhi, StringFormat={}{0:N0}}" Width="105">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#15803D"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Hình Thức" Binding="{Binding LoaiVanChuyen}" Width="90"/>
                        <DataGridTextColumn Header="Biển Số / Cont" Binding="{Binding BienKiemSoat}" Width="100"/>
                        <DataGridTextColumn Header="Trạng Thái" Binding="{Binding TrangThai}" Width="100"/>
                        <DataGridTextColumn Header="Thời Gian Tạo" Binding="{Binding ThoiDiemTao, StringFormat=dd/MM/yyyy HH:mm}" Width="125"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</Page>
