<Page x:Class="GUI.Views.Pages.BieuDoChayTauPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:GUI.Converters"
      Title="Biểu Đồ Chạy Tàu Điều Độ 24h"
      Background="Transparent"
      Loaded="Page_Loaded">

    <Page.Resources>
        <conv:KmFormatConverter x:Key="KmConv"/>
        <conv:BooleanToSymbolConverter x:Key="BoolSymbolConv"/>

        <Style x:Key="DateQuickButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#003B73"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="12,8,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. Toolbar thanh công cụ điều độ -->
            <RowDefinition Height="*"/>    <!-- 2. Vùng chính: Biểu đồ Marey + Sidebar an toàn -->
            <RowDefinition Height="Auto"/> <!-- 3. Panel chi tiết lịch dừng ga bên dưới -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- 1. THANH CÔNG CỤ ĐIỀU ĐỘ CHẠY TÀU (RESPONSIVE COMPACT TOOLBAR)             -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" 
                Background="#FFFFFF" 
                BorderBrush="#CBD5E1" 
                BorderThickness="1" 
                CornerRadius="3" 
                Padding="12,8" 
                Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- DÒNG 1: TIÊU ĐỀ + CHỌN NHANH NGÀY CÓ DỮ LIỆU ĐIỀU ĐỘ + ZOOM & BADGE -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tiêu đề phân hệ -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Timeline24" FontSize="18" Foreground="#003B73" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="BIỂU ĐỒ CHẠY TÀU ĐIỀU ĐỘ 24H (MAREY STRING CHART)" FontSize="12.5" FontWeight="Bold" Foreground="#003B73" VerticalAlignment="Center"/>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="2" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TUYẾN BẮC — NAM" FontSize="10" FontWeight="Bold" Foreground="#003B73"/>
                        </Border>
                    </StackPanel>

                    <!-- Chọn nhanh ngày xem có dữ liệu tàu chạy (Được nạp tự động từ CSDL, KHÔNG HARDCODE) -->
                    <StackPanel x:Name="pnlQuickDates" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Các ngày có tàu:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    </StackPanel>

                    <!-- Điều khiển Zoom & Badges cảnh báo lỗi bên phải -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Zoom:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                        <Slider x:Name="sldZoom" Minimum="0.6" Maximum="1.8" Value="1.0" Width="80" SmallChange="0.1" LargeChange="0.2"
                                ValueChanged="SldZoom_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtZoomPercent" Text="100%" Foreground="#334155" FontSize="11" FontWeight="SemiBold" Width="34" Margin="4,0,10,0" VerticalAlignment="Center"/>

                        <Border x:Name="bdBadgeXungDot" Background="#DC2626" CornerRadius="2" Padding="8,3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️ " FontSize="10.5" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtBadgeXungDot" Text="0 Xung Đột" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- DÒNG 2: BỘ ĐIỀU KHIỂN CHI TIẾT (NGÀY, LỌC TÀU, NÚT HÀNH ĐỘNG ĐIỀU ĐỘ) -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Chọn ngày & Lọc mác tàu -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Ngày biểu đồ:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpNgay" Width="125" Height="26" SelectedDateChanged="DpNgay_SelectedDateChanged" Margin="0,0,12,0"/>

                            <TextBlock Text="Lọc tàu:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cboLocLoaiTau" Width="145" Height="26" SelectionChanged="CboLocLoaiTau_SelectionChanged" Margin="0,0,12,0">
                                <ComboBoxItem Content="Tất cả mác tàu" Tag="ALL" IsSelected="True"/>
                                <ComboBoxItem Content="Tàu Khách SE" Tag="TAU_NHANH"/>
                                <ComboBoxItem Content="Tàu Chợ / Địa phương" Tag="TAU_CHO"/>
                                <ComboBoxItem Content="Tàu Hàng Chuyên Tuyến" Tag="TAU_HANG"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Các nút hành động chính -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Nút Tự Động Xếp Tránh Tàu (Action quan trọng nhất) -->
                            <Button Click="BtnTuDongXepTranh_Click" 
                                    Style="{StaticResource PrimaryDesktopButton}" 
                                    Height="26" 
                                    Padding="10,0" 
                                    Margin="0,0,6,0"
                                    ToolTip="Thuật toán tự động phát hiện xung đột khu gian, dời giờ và chọn đường tránh an toàn">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="13" Margin="0,0,5,0" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Tự Động Xếp Tránh Tàu" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Nút Kiểm Tra Xung Đột -->
                            <Button Click="BtnKiemTraXungDot_Click" 
                                    Style="{StaticResource DesktopButton}" 
                                    Height="26" 
                                    Padding="9,0" 
                                    Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Search24" FontSize="13" Margin="0,0,5,0" Foreground="#003B73"/>
                                    <TextBlock Text="Kiểm Tra Xung Đột" FontSize="11" Foreground="#003B73"/>
                                </StackPanel>
                            </Button>

                            <!-- Nút Nạp Lại -->
                            <Button Click="BtnNapLai_Click" 
                                    Style="{StaticResource DesktopButton}" 
                                    Height="26" 
                                    Padding="9,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Margin="0,0,4,0" Foreground="#334155"/>
                                    <TextBlock Text="Nạp Lại" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 2. VÙNG CHÍNH: BIỂU ĐỒ MAREY (Canvas) + SIDEBAR GIÁM SÁT AN TOÀN           -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: KHUNG VẼ BIỂU ĐỒ MAREY (Canvas giấy trắng kỹ thuật) -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ScrollViewer chứa Biểu đồ Marey (Trục thời gian trên đỉnh hoàn toàn thông thoáng từ 00:00 đến 24:00) -->
                    <ScrollViewer Grid.Row="0" x:Name="svBieuDo" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="#FFFFFF" PanningMode="Both">
                        <!-- Canvas được vẽ từ code-behind -->
                        <Canvas x:Name="cvsBieuDo" Width="2600" Height="1400" Background="#FFFFFF"
                                MouseMove="CvsBieuDo_MouseMove" MouseLeave="CvsBieuDo_MouseLeave">
                            <Canvas.LayoutTransform>
                                <ScaleTransform x:Name="canvasScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Canvas.LayoutTransform>
                        </Canvas>
                    </ScrollViewer>

                    <!-- Dải chú thích hướng dẫn đọc ở đáy biểu đồ (KHÔNG CHE TRỤC GIỜ TRÊN ĐỈNH) -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10,5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="HƯỚNG DẪN ĐỌC:" FontSize="10" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <Rectangle Width="12" Height="3" Fill="#DC2626" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tàu Bắc ➔ Nam (Dốc xuống)" FontSize="10" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <Rectangle Width="12" Height="3" Fill="#0284C7" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tàu Nam ➔ Bắc (Dốc lên)" FontSize="10" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <Rectangle Width="12" Height="3" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tàu Chợ" FontSize="10" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <Rectangle Width="12" Height="3" Fill="#D97706" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tàu Hàng" FontSize="10" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,12,0"/>

                            <Ellipse Width="7" Height="7" Fill="#DC2626" Stroke="#F87171" StrokeThickness="1.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Điểm Xung Đột Khu Gian (Giao nhau)" FontSize="10" FontWeight="Bold" Foreground="#991B1B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Tooltip nổi hiển thị thông tin tàu khi hover -->
                    <Border Grid.Row="0" x:Name="bdHoverTooltip" Background="#FFFFFF" BorderBrush="#003B73" BorderThickness="1.5"
                            CornerRadius="4" Padding="12,8" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Visibility="Collapsed" Panel.ZIndex="100" IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="txtHoverTitle" Text="Mác Tàu: SE1" FontSize="12.5" FontWeight="Bold" Foreground="#003B73"/>
                            <TextBlock x:Name="txtHoverDetails" Text="Hà Nội -> Sài Gòn | 06:00 - 20:00" FontSize="11" Foreground="#334155" Margin="0,2,0,0"/>
                            <TextBlock x:Name="txtHoverSub" Text="Đang chạy qua khu gian Vinh - Hoàng Mai" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- CỘT PHẢI: BẢNG DANH SÁCH XUNG ĐỘT & ĐỘI TÀU (LUÔN CỐ ĐỊNH 290px) -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header cảnh báo -->
                        <RowDefinition Height="*"/>    <!-- Danh sách xung đột / Mác tàu -->
                        <RowDefinition Height="Auto"/> <!-- Thống kê nhanh tổng kết -->
                    </Grid.RowDefinitions>

                    <!-- Header Tiêu Đề Cảnh Báo -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="GIÁM SÁT ĐƯỜNG ĐƠN" FontSize="11.5" FontWeight="Bold" Foreground="#003B73"/>
                                <TextBlock Text="Cảnh báo đối đầu khu gian" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                            <Border x:Name="bdBadgeSideLoi" Grid.Column="1" Background="#DC2626" CornerRadius="2" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="txtSoXungDotSide" Text="0 LỖI" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Danh Sách Xung Đột (ItemsControl / ListBox) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Panel chứa các thẻ xung đột được sinh động -->
                            <StackPanel x:Name="pnlDanhSachXungDot"/>

                            <!-- Thông báo nếu không có xung đột -->
                            <Border x:Name="bdKhongXungDotNotice" Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1" CornerRadius="3" Padding="10,12" Margin="0,2,0,8" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="22" Foreground="#059669" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="LỊCH TRÌNH AN TOÀN" FontSize="11" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Không có xung đột đối đầu nào trên tuyến."
                                               FontSize="10" Foreground="#047857" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Danh Sách Đội Tàu Khai Thác Trong Ngày -->
                            <TextBlock Text="MÁC TÀU TRONG NGÀY" FontSize="10.5" FontWeight="Bold" Foreground="#003B73" Margin="0,8,0,5"/>
                            <StackPanel x:Name="pnlDanhSachTau"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Thống Kê Nhanh -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TỔNG CHUYẾN" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock x:Name="txtTongChuyenTau" Text="0 Chuyến" FontSize="12" FontWeight="Bold" Foreground="#003B73"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="ĐỘ DÀI TUYẾN" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                <TextBlock Text="1,726.20 Km" FontSize="12" FontWeight="Bold" Foreground="#003B73" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 3. PANEL CHI TIẾT LỊCH DỪNG GA TÀU ĐANG CHỌN (COLLAPSIBLE BOTTOM)          -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="12,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="VehicleSubway24" FontSize="14" Foreground="#003B73" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtChiTietTauTitle" 
                                   Text="CHI TIẾT LỘ TRÌNH DỪNG GA: Vui lòng click chọn một đường tàu trên biểu đồ" 
                                   FontSize="11.5" FontWeight="Bold" Foreground="#003B73"/>
                    </StackPanel>

                    <Button Click="BtnDongChiTiet_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4" Cursor="Hand" ToolTip="Đóng">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="#64748B"/>
                    </Button>
                </Grid>

                <!-- DataGrid Lịch Dừng Ga Chi Tiết -->
                <DataGrid Grid.Row="1" x:Name="dgChiTietLichDung" Height="120" 
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TT" Binding="{Binding ThuTuDung}" Width="45">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Tên Ga Dừng" Binding="{Binding TenGa}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#003B73"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Mã Ga" Binding="{Binding MaGaCode}" Width="65">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Lý Trình" Binding="{Binding LyTrinhKm, Converter={StaticResource KmConv}}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Giờ Đến (KH)" Binding="{Binding GioDen, StringFormat=HH:mm}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#059669"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Giờ Đi (KH)" Binding="{Binding GioDi, StringFormat=HH:mm}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#003B73"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Đỗ (Phút)" Binding="{Binding ThoiGianDungPhut}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#D97706"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Đường Ray Ga" Binding="{Binding SoHieuDuongRay, StringFormat=Đường #{0}}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Điểm Tránh Tàu" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Center" CornerRadius="2" Padding="6,1"
                                            Background="{Binding LaDiemTranh, Converter={StaticResource BoolSymbolConv}}">
                                        <TextBlock Text="{Binding LaDiemTranh, Converter={StaticResource BoolSymbolConv}}" 
                                                   FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
