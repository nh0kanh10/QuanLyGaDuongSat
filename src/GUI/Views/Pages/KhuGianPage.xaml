<Page x:Class="GUI.Views.Pages.KhuGianPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:conv="clr-namespace:GUI.Converters"
      Title="Quản Lý Phân Đoạn Khu Gian Độc Lập"
      PreviewKeyDown="Page_PreviewKeyDown">

    <Page.Resources>
        <conv:KmFormatConverter x:Key="KmConv"/>
        <conv:BooleanToSymbolConverter x:Key="BoolSymbolConv"/>

        <Style x:Key="SectionDivider" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Margin" Value="0,12,0,10"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#003B73"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="RequiredLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <!-- Style cho TabItem phẳng chuẩn mực hệ thống trong Inspector -->
        <Style x:Key="SystemTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Background="Transparent" Margin="0,0,8,0">
                            <ContentPresenter x:Name="contentPresenter" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#003B73"/>
                                <Setter Property="Foreground" Value="#003B73"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="12,10,12,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="550"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="480" MinWidth="400" MaxWidth="680"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================================================= -->
        <!-- CỘT TRÁI: DANH SÁCH PHÂN ĐOẠN KHU GIAN TOÀN TUYẾN (MASTER)                 -->
        <!-- ========================================================================= -->
        <Border Grid.Column="0" 
                Background="#FFFFFF" 
                BorderBrush="#CBD5E1" 
                BorderThickness="1" 
                CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Thanh công cụ & Bộ lọc -->
                    <RowDefinition Height="*"/>    <!-- DataGrid danh sách -->
                    <RowDefinition Height="Auto"/> <!-- Status strip thống kê -->
                </Grid.RowDefinitions>

                <!-- 1. Toolbar & Filters -->
                <Border Grid.Row="0" 
                        Background="#F8FAFC" 
                        BorderBrush="#CBD5E1" 
                        BorderThickness="0,0,0,1" 
                        Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Dòng 1: Tiêu đề phân hệ & Các nút hành động chính -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                                    <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="16" Foreground="#003B73" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="MẠNG LƯỚI PHÂN ĐOẠN KHU GIAN" FontSize="14" FontWeight="Bold" Foreground="#003B73"/>
                                    <TextBlock Text="Cấu hình thông số kỹ thuật, tốc độ và an toàn chạy tàu giữa các ga" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Global Action Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="BtnNhapFile_Click" 
                                        Style="{StaticResource DesktopButton}" 
                                        Height="30" Padding="12,0" Margin="0,0,6,0"
                                        ToolTip="Nhập danh sách phân đoạn khu gian từ tệp CSV/Excel">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="13" Foreground="#003B73" Margin="0,0,6,0"/>
                                        <TextBlock Text="Nhập Tệp" FontSize="11" FontWeight="SemiBold" Foreground="#003B73"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="BtnXuatExcel_Click" 
                                        Style="{StaticResource DesktopButton}" 
                                        Height="30" Padding="12,0" Margin="0,0,6,0"
                                        ToolTip="Xuất bảng danh sách khu gian ra định dạng CSV/Excel">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DocumentArrowDown24" FontSize="13" Foreground="#003B73" Margin="0,0,6,0"/>
                                        <TextBlock Text="Xuất Bảng" FontSize="11" FontWeight="SemiBold" Foreground="#003B73"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="BtnLamMoi_Click" 
                                        Style="{StaticResource DesktopButton}" 
                                        Height="30" Padding="10,0" Margin="0,0,6,0"
                                        ToolTip="Tải lại dữ liệu từ CSDL (F5)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowReset24" FontSize="13" Foreground="#475569" Margin="0,0,4,0"/>
                                        <TextBlock Text="Nạp Lại" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="BtnThemMoi_Click" 
                                        Style="{StaticResource PrimaryDesktopButton}" 
                                        Height="30" Padding="14,0"
                                        ToolTip="Thêm mới một phân đoạn khu gian vào mạng lưới (Ctrl + N)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                        <TextBlock Text="Thêm Khu Gian Mới" FontSize="11" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Dòng 2: Thanh tìm kiếm nhanh & Lọc trạng thái (Bố cục chuẩn cân đối, gọn gàng) -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Ô tìm kiếm -->
                                    <ColumnDefinition Width="Auto"/> <!-- Đường phân cách -->
                                    <ColumnDefinition Width="Auto"/> <!-- Lọc Trạng thái -->
                                    <ColumnDefinition Width="Auto"/> <!-- Đường phân cách -->
                                    <ColumnDefinition Width="Auto"/> <!-- Lọc Điểm đen tai nạn -->
                                    <ColumnDefinition Width="Auto"/> <!-- Nút Xóa Lọc -->
                                    <ColumnDefinition Width="*"/>    <!-- Khoảng đệm dạt sang phải -->
                                </Grid.ColumnDefinitions>

                                <!-- Tìm kiếm theo tên Ga Đầu hoặc Ga Cuối (Width 270 vừa vặn, không bị dài ngoằng) -->
                                <Border Grid.Column="0" Width="270" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Height="28">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="txtTimKiem" 
                                                     BorderThickness="0" Background="Transparent" 
                                                     VerticalContentAlignment="Center" FontSize="11" 
                                                     TextChanged="TxtTimKiem_TextChanged"
                                                     ToolTip="Nhập tên ga đầu, ga cuối hoặc mã code để lọc nhanh"/>
                                            <TextBlock x:Name="txtPlaceholderTimKiem" 
                                                       Text="Tìm ga đầu, ga cuối, mã ga..." 
                                                       FontSize="11" Foreground="#94A3B8" 
                                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                                       Margin="2,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=txtTimKiem}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Button Grid.Column="2" x:Name="btnXoaTimKiem" Click="BtnXoaTimKiem_Click"
                                                Background="Transparent" BorderThickness="0" Padding="6,0" Cursor="Hand" Visibility="Collapsed">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Foreground="#94A3B8"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Rectangle Grid.Column="1" Width="1" Height="18" Fill="#CBD5E1" Margin="10,0"/>

                                <!-- Lọc theo Trạng thái phân đoạn (Width 230 hiển thị đầy đủ 100% chữ không bị cắt ...) -->
                                <ComboBox Grid.Column="2" x:Name="cboLocTrangThai" Width="230" Height="28" FontSize="11"
                                          SelectionChanged="CboLocTrangThai_SelectionChanged">
                                    <ComboBoxItem Content="Tất cả trạng thái khu gian" IsSelected="True"/>
                                    <ComboBoxItem Content="Thông đường sẵn sàng"/>
                                    <ComboBoxItem Content="Đang có đoàn tàu chiếm dụng"/>
                                    <ComboBoxItem Content="Phong tỏa thi công / Sự cố"/>
                                </ComboBox>

                                <Rectangle Grid.Column="3" Width="1" Height="18" Fill="#CBD5E1" Margin="10,0"/>

                                <!-- Checkbox lọc điểm đen tai nạn (Căn chỉnh cân đối, trực quan) -->
                                <CheckBox Grid.Column="4" x:Name="chkLocDiemDen" 
                                          Content="Có Điểm đen tai nạn" 
                                          FontSize="11" FontWeight="SemiBold" Foreground="#B91C1C"
                                          VerticalAlignment="Center" Margin="2,0,10,0"
                                          Checked="ChkLocDiemDen_Changed" Unchecked="ChkLocDiemDen_Changed"
                                          ToolTip="Chỉ lọc các phân đoạn khu gian có ghi nhận điểm đen tai nạn nguy hiểm"/>

                                <!-- Nút đặt lại bộ lọc -->
                                <Button Grid.Column="5" Click="BtnDatLaiLoc_Click" 
                                        Height="28" Padding="10,0" Style="{StaticResource DesktopButton}"
                                        ToolTip="Xóa tất cả điều kiện tìm kiếm và bộ lọc">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="FilterDismiss24" FontSize="12" Foreground="#64748B" Margin="0,0,4,0"/>
                                        <TextBlock Text="Xóa Lọc" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. DataGrid Danh Sách Khu Gian -->
                <DataGrid Grid.Row="1" x:Name="dgKhuGian" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          SelectionMode="Single" 
                          CanUserAddRows="False" 
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          RowHeight="34"
                          Sorting="DgKhuGian_Sorting"
                          SelectionChanged="DgKhuGian_SelectionChanged">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Xem Chi Tiết &amp; Cấu Hình" Click="CtxSua_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Edit24" FontSize="14" Foreground="#003B73"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Đổi Trạng Thái Phong Tỏa / Mở Đường" Click="CtxDoiTrangThai_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="14" Foreground="#D97706"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Khai Báo Thêm Đường Ngang Giao Cắt..." Click="CtxThemDuongNgang_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="AddCircle24" FontSize="14" Foreground="#059669"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Sao Chép Thông Số Phân Đoạn" Click="CtxSaoChep_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Copy24" FontSize="14" Foreground="#475569"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Xóa Phân Đoạn Khu Gian Này" Click="CtxXoa_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#DC2626"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <!-- Cột STT -->
                        <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="45" HeaderStyle="{StaticResource DataGridHeaderCenter}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Ga Đầu -->
                        <DataGridTemplateColumn Header="Ga Đầu" SortMemberPath="TenGaDau" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding MaGaDauCode}" FontSize="9" FontWeight="Bold" Foreground="#003B73"/>
                                        </Border>
                                        <TextBlock Text="{Binding TenGaDau}" FontWeight="Bold" Foreground="#0F172A" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Nút mũi tên liên kết -->
                        <DataGridTemplateColumn Header="" Width="28">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Ga Cuối -->
                        <DataGridTemplateColumn Header="Ga Cuối" SortMemberPath="TenGaCuoi" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding MaGaCuoiCode}" FontSize="9" FontWeight="Bold" Foreground="#475569"/>
                                        </Border>
                                        <TextBlock Text="{Binding TenGaCuoi}" FontWeight="Bold" Foreground="#0F172A" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cự Ly (km) -->
                        <DataGridTextColumn Binding="{Binding CuLyKm, Converter={StaticResource KmConv}}" SortMemberPath="CuLyKm" Width="95" HeaderStyle="{StaticResource DataGridHeaderRight}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Cự Ly (km)" TextAlignment="Right" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#003B73"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Vmax Khách -->
                        <DataGridTextColumn Binding="{Binding TocDoToiDaKhach, StringFormat={}{0} km/h}" SortMemberPath="TocDoToiDaKhach" Width="95" HeaderStyle="{StaticResource DataGridHeaderRight}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Vmax Khách" TextAlignment="Right" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Vmax Hàng -->
                        <DataGridTextColumn Binding="{Binding TocDoToiDaHang, StringFormat={}{0} km/h}" SortMemberPath="TocDoToiDaHang" Width="90" HeaderStyle="{StaticResource DataGridHeaderRight}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Vmax Hàng" TextAlignment="Right" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Độ Dốc (‰) -->
                        <DataGridTextColumn Binding="{Binding DoDocPermil, StringFormat={}{0:0.0} ‰}" SortMemberPath="DoDocPermil" Width="80" HeaderStyle="{StaticResource DataGridHeaderRight}">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Độ Dốc" TextAlignment="Right" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Máy Đẩy Đèo -->
                        <DataGridTemplateColumn Header="Máy Đẩy" SortMemberPath="CanDauMayDay" Width="85" HeaderStyle="{StaticResource DataGridHeaderCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center">
                                        <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="2" Padding="6,1" 
                                                Visibility="{Binding CanDauMayDay, Converter={StaticResource BoolSymbolConv}, ConverterParameter=VisibilityTrue}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowTrendingLines24" FontSize="10" Foreground="#B45309" Margin="0,0,3,0"/>
                                                <TextBlock Text="Cần đẩy" FontSize="10" FontWeight="Bold" Foreground="#B45309"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="—" Foreground="#CBD5E1" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Visibility="{Binding CanDauMayDay, Converter={StaticResource BoolSymbolConv}, ConverterParameter=VisibilityFalse}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Điểm Giao Cắt Đường Ngang -->
                        <DataGridTemplateColumn Header="Đường Ngang" SortMemberPath="SoDuongNgang" Width="105" HeaderStyle="{StaticResource DataGridHeaderCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center">
                                        <TextBlock Text="—" Foreground="#CBD5E1" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Visibility="{Binding SoDuongNgang, Converter={StaticResource BoolSymbolConv}, ConverterParameter=VisibilityFalse}"/>

                                        <Border CornerRadius="2" Padding="6,1" HorizontalAlignment="Center"
                                                Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                                                Visibility="{Binding SoDuongNgang, Converter={StaticResource BoolSymbolConv}, ConverterParameter=VisibilityTrue}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="#DC2626" Margin="0,0,4,0" VerticalAlignment="Center"
                                                         Visibility="{Binding SoDiemDen, Converter={StaticResource BoolSymbolConv}, ConverterParameter=VisibilityTrue}"
                                                         ToolTip="Khu gian có ghi nhận vị trí điểm đen tai nạn"/>
                                                <TextBlock Text="{Binding SoDuongNgang, StringFormat={}{0} vị trí}" FontSize="10" FontWeight="SemiBold" Foreground="#334155"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Trạng Thái Phân Đoạn -->
                        <DataGridTemplateColumn Header="Trạng Thái Vận Hành" SortMemberPath="TrangThai" Width="*" MinWidth="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Ellipse x:Name="dotStatusKg" Width="8" Height="8" Fill="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtStatusKg" Text="Thông đường sẵn sàng" FontSize="11" Foreground="#15803D" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding TrangThai}" Value="RONG">
                                            <Setter TargetName="dotStatusKg" Property="Fill" Value="#16A34A"/>
                                            <Setter TargetName="txtStatusKg" Property="Text" Value="Thông đường sẵn sàng"/>
                                            <Setter TargetName="txtStatusKg" Property="Foreground" Value="#15803D"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TrangThai}" Value="CO_TAU">
                                            <Setter TargetName="dotStatusKg" Property="Fill" Value="#F59E0B"/>
                                            <Setter TargetName="txtStatusKg" Property="Text" Value="Đang có đoàn tàu"/>
                                            <Setter TargetName="txtStatusKg" Property="Foreground" Value="#B45309"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TrangThai}" Value="PHONG_TOA">
                                            <Setter TargetName="dotStatusKg" Property="Fill" Value="#EF4444"/>
                                            <Setter TargetName="txtStatusKg" Property="Text" Value="Phong tỏa thi công"/>
                                            <Setter TargetName="txtStatusKg" Property="Foreground" Value="#DC2626"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State khi tìm kiếm không ra kết quả -->
                <Border x:Name="pnlEmptyState" Grid.Row="1" Background="#FFFFFF" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="50" Height="50" CornerRadius="25" Background="#F1F5F9" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <ui:SymbolIcon Symbol="Search24" FontSize="22" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Không tìm thấy phân đoạn khu gian nào" FontSize="13" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Vui lòng kiểm tra lại từ khóa tìm kiếm hoặc đặt lại bộ lọc trạng thái." FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <Button Click="BtnDatLaiLoc_Click" Height="28" Padding="12,0" Style="{StaticResource DesktopButton}" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowReset24" FontSize="12" Margin="0,0,5,0" Foreground="#003B73"/>
                                <TextBlock Text="Đặt Lại Bộ Lọc" FontSize="11" FontWeight="SemiBold" Foreground="#003B73"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 3. Thanh Status Strip Thống Kê Dưới Chân Bảng -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtTongSoPhanDoan" Text="Tổng số: 12 phân đoạn" FontSize="11" FontWeight="Bold" Foreground="#003B73" Margin="0,0,16,0"/>
                            <TextBlock x:Name="txtTongCuLy" Text="Tổng cự ly: 1,726.20 km" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,16,0"/>
                            <TextBlock x:Name="txtTongDuongNgang" Text="Đường ngang: 0 vị trí" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,16,0"/>
                            <TextBlock x:Name="txtMayDayCount" Text="Đoạn máy đẩy: 1 đèo Hải Vân" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Tuyến Đường Sắt Bắc - Nam (Khổ ray 1,000mm)" FontSize="10" Foreground="#64748B" FontStyle="Italic" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" 
                      Width="8" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch" 
                      Background="Transparent" 
                      Cursor="SizeWE"/>

        <!-- ========================================================================= -->
        <!-- CỘT PHẢI: FORM CHI TIẾT & CHỈNH SỬA PHÂN ĐOẠN KHU GIAN (INSPECTOR)         -->
        <!-- ========================================================================= -->
        <Border Grid.Column="2" 
                Background="#FFFFFF" 
                BorderBrush="#CBD5E1" 
                BorderThickness="1" 
                CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header Inspector -->
                    <RowDefinition Height="*"/>    <!-- TabControl Inspector -->
                </Grid.RowDefinitions>

                <!-- 1. Header Inspector -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="28" Height="28" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="14" Foreground="#003B73"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="txtTitleFormKg" Text="CHI TIẾT PHÂN ĐOẠN KHU GIAN" FontSize="12" FontWeight="Bold" Foreground="#003B73" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtSubtitleFormKg" Text="Cấu hình thông số kỹ thuật phân đoạn" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Grid.Column="2" x:Name="badgeContainerKg" CornerRadius="2" Padding="8,2" VerticalAlignment="Center" Background="#F1F5F9" BorderThickness="1" BorderBrush="#CBD5E1">
                            <TextBlock x:Name="txtBadgeKg" Text="ID: #1" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 2. Tabbed Inspector: Tab 1 = Thông Số Kỹ Thuật, Tab 2 = Đường Ngang Giao Cắt -->
                <TabControl Grid.Row="1" x:Name="tabInspectorKg" BorderThickness="0" Background="Transparent" SelectionChanged="TabInspectorKg_SelectionChanged">

                    <!-- ============================================================== -->
                    <!-- TAB 1: THÔNG SỐ KỸ THUẬT PHÂN ĐOẠN                             -->
                    <!-- ============================================================== -->
                    <TabItem x:Name="tabThongSoKg" Style="{StaticResource SystemTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Wrench24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Thông Số Kỹ Thuật" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="16,12">
                                <StackPanel>
                                    <!-- Phân đoạn 1: Hai Ga Đầu Mối Kết Nối -->
                                    <TextBlock Text="ĐẦU MỐI KẾT NỐI PHÂN ĐOẠN" Style="{StaticResource SectionHeader}"/>

                                    <!-- A. Chế độ Xem / Chỉnh sửa: Route Connection Banner trực quan -->
                                    <Border x:Name="pnlRouteBanner" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Tuyến lộ trình: Ga Phía Bắc -> Mũi tên -> Ga Phía Nam -->
                                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Ga Bắc -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="GA PHÍA BẮC" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,4,0">
                                                            <TextBlock x:Name="txtBannerCodeDau" Text="HNI" FontSize="9" FontWeight="Bold" Foreground="#003B73"/>
                                                        </Border>
                                                        <TextBlock x:Name="txtBannerTenDau" Text="Hà Nội" FontSize="12" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="txtBannerKmDau" Text="Km 0.00" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Mũi tên liên kết -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,0">
                                                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="15" Foreground="#003B73"/>
                                                    <TextBlock Text="Khu Gian" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Ga Nam -->
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="GA PHÍA NAM" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3" HorizontalAlignment="Right"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock x:Name="txtBannerTenCuoi" Text="Phủ Lý" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,4,0" TextTrimming="CharacterEllipsis"/>
                                                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="4,1">
                                                            <TextBlock x:Name="txtBannerCodeCuoi" Text="PLY" FontSize="9" FontWeight="Bold" Foreground="#475569"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock x:Name="txtBannerKmCuoi" Text="Km 56.00" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Dòng thông tin bổ trợ: Cự ly khoảng cách lý trình giữa 2 ga -->
                                            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="8,4">
                                                <Grid>
                                                    <TextBlock Text="Đường sắt Bắc - Nam (Khổ ray 1.000mm)" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="txtBannerKhoangCachGa" Text="Khoảng cách lý trình: 56.00 km" FontSize="10" FontWeight="SemiBold" Foreground="#003B73" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- B. Chế độ Thêm Mới: Chọn 2 ga từ ComboBox -->
                                    <StackPanel x:Name="pnlRouteSelect" Visibility="Collapsed" Margin="0,0,0,8">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="135"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11">
                                                <Run Text="Ga Đầu Phía Bắc:" Foreground="#0F172A" FontWeight="SemiBold"/><Run Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                            </TextBlock>
                                            <ComboBox Grid.Column="1" x:Name="cboGaDau" Height="28" FontSize="11"
                                                      SelectionChanged="CboGa_SelectionChanged"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="135"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11">
                                                <Run Text="Ga Cuối Phía Nam:" Foreground="#0F172A" FontWeight="SemiBold"/><Run Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                            </TextBlock>
                                            <ComboBox Grid.Column="1" x:Name="cboGaCuoi" Height="28" FontSize="11"
                                                      SelectionChanged="CboGa_SelectionChanged"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Phân đoạn 2: Cự Ly & Vận Tốc Cho Phép -->
                                    <Border Style="{StaticResource SectionDivider}"/>
                                    <TextBlock Text="CỰ LY &amp; TỐC ĐỘ KHAI THÁC" Style="{StaticResource SectionHeader}"/>

                                    <!-- Cự ly Km -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11">
                                            <Run Text="Cự Ly Thực Tế (km):" Foreground="#0F172A" FontWeight="SemiBold"/><Run Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                        </TextBlock>
                                        <TextBox Grid.Column="1" x:Name="txtCuLyKg" Height="28" FontSize="11" Text="30.00" 
                                                 FontWeight="SemiBold" VerticalContentAlignment="Center"
                                                 TextChanged="FormInput_Changed"
                                                 ToolTip="Cự ly đường sắt thực tế giữa 2 ga (lớn hơn 0 km)"/>
                                    </Grid>

                                    <!-- Tốc độ Vmax Khách & Hàng -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tốc Độ Tối Đa:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Tàu Khách (km/h)" FontSize="10" Foreground="#64748B" Margin="0,0,0,2"/>
                                                <TextBox x:Name="txtVmaxKhach" Height="28" FontSize="11" Text="80" 
                                                         FontWeight="SemiBold" VerticalContentAlignment="Center"
                                                         TextChanged="FormInput_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Tàu Hàng (km/h)" FontSize="10" Foreground="#64748B" Margin="0,0,0,2"/>
                                                <TextBox x:Name="txtVmaxHang" Height="28" FontSize="11" Text="50" 
                                                         FontWeight="SemiBold" VerticalContentAlignment="Center"
                                                         TextChanged="FormInput_Changed"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <!-- Phân đoạn 3: Địa Hình & Yêu Cầu Kỹ Thuật Đèo Dốc -->
                                    <Border Style="{StaticResource SectionDivider}"/>
                                    <TextBlock Text="ĐỊA HÌNH &amp; KỸ THUẬT ĐÈO DỐC" Style="{StaticResource SectionHeader}"/>

                                    <!-- Độ dốc lớn nhất -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Độ Dốc Lớn Nhất:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="txtDoDocKg" Height="28" FontSize="11" Text="0.0" 
                                                 VerticalContentAlignment="Center" TextChanged="FormInput_Changed"
                                                 ToolTip="Độ dốc tính bằng phần nghìn (‰). Ví dụ: đèo Hải Vân 17.0 ‰"/>
                                    </Grid>

                                    <!-- Máy đẩy đèo Banker -->
                                    <Grid Margin="0,4,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Đầu Máy Đẩy:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <ui:ToggleSwitch Grid.Column="1" x:Name="chkCanDauMayDay" 
                                                         Content="Bố trí máy đẩy đèo dốc"
                                                         FontSize="11" FontWeight="SemiBold" Foreground="#334155"
                                                         ToolTip="Bố trí thêm đầu máy đẩy ở đuôi tàu khi qua phân đoạn đèo dốc hiểm trở (Banker Engine)"
                                                         Click="FormInput_Changed"/>
                                    </Grid>

                                    <!-- Trạng thái vận hành -->
                                    <Grid Margin="0,4,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Trạng Thái Chạy Tàu:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="cboTrangThaiKg" Height="28" FontSize="11"
                                                  SelectionChanged="FormInput_Changed">
                                            <ComboBoxItem Content="Thông đường sẵn sàng" IsSelected="True"/>
                                            <ComboBoxItem Content="Đang có đoàn tàu chiếm dụng"/>
                                            <ComboBoxItem Content="Phong tỏa thi công / Sự cố"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Ghi chú quy tắc ngắn gọn tinh tế -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="8,5" Margin="0,2,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Info24" FontSize="12" Foreground="#003B73" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Khu gian đường đơn: Chỉ 01 đoàn tàu được chiếm dụng tại một thời điểm." 
                                                       FontSize="10" Foreground="#64748B" FontStyle="Italic" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Thanh Nút Thao Tác CRUD Tối Ưu -->
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Nút Xóa an toàn gọn gàng bên trái -->
                                    <Button Grid.Column="0" x:Name="btnXoaKg" Click="BtnXoaKg_Click" 
                                            Style="{StaticResource DangerDesktopButton}" Height="30" Padding="10,0"
                                            ToolTip="Xóa vĩnh viễn phân đoạn khu gian này khỏi mạng lưới">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="12" Margin="0,0,4,0" Foreground="#B91C1C"/>
                                            <TextBlock Text="Xóa" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Nút Hủy Bỏ -->
                                    <Button Grid.Column="2" x:Name="btnHuyKg" Click="BtnHuyKg_Click" 
                                            Style="{StaticResource DesktopButton}" Height="30" Padding="12,0"
                                            ToolTip="Hủy các thay đổi và nạp lại thông tin gốc (Esc)">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Margin="0,0,4,0" Foreground="#64748B"/>
                                            <TextBlock Text="Hủy Bỏ" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Nút Lưu / Tạo mới Chính -->
                                    <Button Grid.Column="4" x:Name="btnLuuKg" Click="BtnLuuKg_Click" 
                                            Style="{StaticResource PrimaryDesktopButton}" Height="30" Padding="14,0"
                                            ToolTip="Lưu thay đổi phân đoạn khu gian vào CSDL (Ctrl + S)">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon x:Name="iconLuuKg" Symbol="Save24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="txtLuuKg" Text="Lưu Phân Đoạn" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- ============================================================== -->
                    <!-- TAB 2: ĐƯỜNG NGANG GIAO CẮT (HẠ TẦNG AN TOÀN)                 -->
                    <!-- ============================================================== -->
                    <TabItem x:Name="tabDuongNgangKg" Style="{StaticResource SystemTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Location24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Đường Ngang Giao Cắt" VerticalAlignment="Center"/>
                                <Border x:Name="bdTabBadgeDn" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtTabBadgeDn" Text="0" FontSize="9" FontWeight="Bold" Foreground="#475569"/>
                                </Border>
                            </StackPanel>
                        </TabItem.Header>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- 0: Header công cụ Tab 2: Tiêu đề + Nút Thêm -->
                                <RowDefinition Height="Auto"/> <!-- 1: Form Trượt Thêm / Sửa Đường Ngang -->
                                <RowDefinition Height="Auto"/> <!-- 2: Thước Đo Trực Quan Tuyến Ray (Track Timeline Strip) -->
                                <RowDefinition Height="*"/>    <!-- 3: Danh sách thẻ trạm giao cắt hạ tầng -->
                                <RowDefinition Height="Auto"/> <!-- 4: Footer tóm tắt -->
                            </Grid.RowDefinitions>

                            <!-- Header công cụ Tab 2 -->
                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtDnKhuGianTen" Text="Đường Ngang Giao Cắt" FontSize="11" FontWeight="Bold" Foreground="#003B73" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="txtDnPhamViKm" Text="Phạm vi: Km 0.00 — Km 56.00" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="btnThemDuongNgang" Click="BtnThemDuongNgang_Click"
                                            Style="{StaticResource PrimaryDesktopButton}" Height="28" Padding="10,0"
                                            ToolTip="Khai báo thêm điểm giao cắt đường bộ mới trong phân đoạn này">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Add24" FontSize="12" Margin="0,0,4,0"/>
                                            <TextBlock Text="Thêm Điểm Giao Cắt" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Form Trượt Thêm / Sửa Đường Ngang -->
                            <Border Grid.Row="1" x:Name="pnlFormDuongNgang" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="14,10" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="iconFormDn" Symbol="AddCircle24" FontSize="13" Foreground="#003B73" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="txtTitleFormDn" Text="KHAI BÁO ĐƯỜNG NGANG GIAO CẮT" FontSize="11" FontWeight="Bold" Foreground="#003B73"/>
                                        </StackPanel>
                                        <Border x:Name="bdBadgeFormDn" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="2" Padding="6,1" HorizontalAlignment="Right">
                                            <TextBlock x:Name="txtBadgeFormDn" Text="TẠO MỚI" FontSize="9" FontWeight="Bold" Foreground="#1D4ED8"/>
                                        </Border>
                                    </Grid>

                                    <!-- Lý Trình Km -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Lý Trình Giao Cắt: *" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/>
                                            <TextBlock Text="(Km đường sắt)" FontSize="9" Foreground="#64748B"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBox x:Name="txtDnLyTrinh" Height="28" FontSize="11" FontWeight="SemiBold" VerticalContentAlignment="Center"
                                                     ToolTip="Vị trí km giao cắt (ví dụ: 15.20)"/>
                                            <TextBlock x:Name="txtDnHintKm" Text="Phạm vi: Km 0.00 — Km 56.00" FontSize="9" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Tên Tuyến Đường Bộ -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Đường Bộ Giao Cắt: *" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtDnTenDuong" Grid.Column="1" Height="28" FontSize="11" VerticalContentAlignment="Center"
                                                 ToolTip="Nhập tên tuyến đường bộ (ví dụ: Quốc lộ 1A, Tỉnh lộ 427, Đường gom dân sinh)"/>
                                    </Grid>

                                    <!-- Hình Thức Phòng Vệ -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Hình Thức Bảo Vệ: *" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="cboDnLoai" Height="28" FontSize="11">
                                            <ComboBoxItem Content="Có người gác (Chắn đường bộ 24/7)" Tag="CO_NGUOI_GAC" IsSelected="True"/>
                                            <ComboBoxItem Content="Cảnh báo tự động (Chuông đèn &amp; Cần chắn)" Tag="TU_DONG"/>
                                            <ComboBoxItem Content="Biển báo dân sinh (Biển cảnh báo)" Tag="BIEN_BAO"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Điểm Đen Tai Nạn -->
                                    <Grid Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="1" x:Name="chkDnLaDiemDen"
                                                  Content="Cảnh báo điểm đen tai nạn (Vị trí rủi ro cao)"
                                                  FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                    </Grid>

                                    <!-- Nút Lưu / Hủy trong Form -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                        <Button x:Name="btnHuyDn" Click="BtnHuyDn_Click"
                                                Style="{StaticResource DesktopButton}" Height="28" Padding="12,0" Margin="0,0,6,0">
                                            <TextBlock Text="Đóng / Hủy" FontSize="11"/>
                                        </Button>
                                        <Button x:Name="btnLuuDn" Click="BtnLuuDn_Click"
                                                Style="{StaticResource PrimaryDesktopButton}" Height="28" Padding="14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Save24" FontSize="12" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="txtLuuDn" Text="Lưu Vị Trí" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 2. Thước Đo Trực Quan Tuyến Ray (Visual Track Timeline Strip) -->
                            <Border Grid.Row="2" x:Name="pnlTrackStrip" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Dòng tiêu đề sơ đồ thước đo -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="BranchFork24" FontSize="12" Foreground="#003B73" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="SƠ ĐỒ PHÂN BỐ GIAO CẮT TRÊN PHÂN ĐOẠN" FontSize="10" FontWeight="Bold" Foreground="#003B73" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="txtTrackDensity" Text="Mật độ: 0.20 vị trí/km" FontSize="9" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Trục ray & Canvas chứa các node mốc cọc -->
                                    <Grid Grid.Row="1" Margin="2,2,2,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="22"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Đường ray chính (Double Rail Line) -->
                                        <Grid Grid.Row="0" VerticalAlignment="Center">
                                            <!-- Tà vẹt / Thanh đệm xám -->
                                            <Border Height="6" Background="#E2E8F0" CornerRadius="3" VerticalAlignment="Center"/>
                                            <!-- Tim đường ray xanh Navy -->
                                            <Border x:Name="brdTrackMainLine" Height="2" Background="#003B73" CornerRadius="1" VerticalAlignment="Center"/>

                                            <!-- Canvas vẽ các điểm mốc giao cắt -->
                                            <Canvas x:Name="cvsTrackMarkers" Height="22" VerticalAlignment="Center" SizeChanged="CvsTrackMarkers_SizeChanged"/>
                                        </Grid>

                                        <!-- Nhãn 2 đầu Ga Bắc / Nam -->
                                        <Grid Grid.Row="1" Margin="0,3,0,0">
                                            <TextBlock x:Name="txtTrackGaDau" Text="Ga Đầu (Km 0.00)" FontSize="9" FontWeight="Bold" Foreground="#003B73" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="txtTrackGaCuoi" Text="Ga Cuối (Km 5.00)" FontSize="9" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 3. Danh Sách Thẻ Trạm Giao Cắt Hạ Tầng -->
                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="12,10">
                                <Grid>
                                    <StackPanel x:Name="pnlCardsDuongNgang"/>

                                    <!-- Empty State khi không có đường ngang -->
                                    <Border x:Name="pnlEmptyDn" Visibility="Collapsed" Padding="20,30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="46" Height="46" CornerRadius="23" Background="#F1F5F9" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="22" Foreground="#003B73" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Không Có Đường Ngang Giao Cắt" FontSize="12" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Phân đoạn này an toàn thông suốt hoặc chưa ghi nhận vị trí giao cắt đường bộ." FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="280" Margin="0,0,0,10"/>
                                            <Button Click="BtnThemDuongNgang_Click" Height="28" Padding="12,0" Style="{StaticResource DesktopButton}" HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Add24" FontSize="12" Margin="0,0,4,0" Foreground="#003B73"/>
                                                    <TextBlock Text="Khai Báo Điểm Giao Cắt Đầu Tiên" FontSize="10" FontWeight="SemiBold" Foreground="#003B73"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>

                            <!-- 4. Footer Tab 2 -->
                            <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12,6">
                                <Grid>
                                    <TextBlock x:Name="txtDnTongKetTab" Text="Tổng số: 0 vị trí giao cắt" FontSize="10" FontWeight="SemiBold" Foreground="#003B73" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tiêu chuẩn kỹ thuật QCVN 08:2018/BGTVT" FontSize="9" Foreground="#94A3B8" FontStyle="Italic" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Page>
