<Page x:Class="GUI.Views.Pages.SoatVePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Kiểm Soát Lên Tàu &amp; Soát Vé"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled">

    <Grid Margin="12,8,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Thanh điều khiển: Chọn chuyến, Ga soát, Ngày -->
            <RowDefinition Height="Auto"/> <!-- 1. Thẻ KPI thống kê kiểm soát vé -->
            <RowDefinition Height="*"/>    <!-- 2. Không gian làm việc: Máy quét/Thẩm định & Manifest -->
        </Grid.RowDefinitions>

        <!-- 0. THANH ĐIỀU KHIỂN & BỘ LỌC CHUYẾN TÀU -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Ngày kiểm soát -->
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/> <!-- Chuyến tàu -->
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/> <!-- Ga soát hiện tại -->
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/> <!-- Nút tải lại -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/> <!-- In danh sách / Thao tác -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Ngày Chạy:" Style="{StaticResource FieldLabel}"/>
                <DatePicker Grid.Column="1" x:Name="dpNgaySoatVe" Width="145" Height="30"
                            VerticalContentAlignment="Center" FontSize="12.5"
                            SelectedDateFormat="Short" SelectedDateChanged="DpNgaySoatVe_SelectedDateChanged"/>

                <TextBlock Grid.Column="3" Text="Chuyến Tàu:" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Column="4" x:Name="cboChuyenTauSoatVe" Height="30"
                          DisplayMemberPath="TenHienThi" SelectedValuePath="MaChuyenTau"
                          SelectionChanged="CboChuyenTauSoatVe_SelectionChanged"/>

                <TextBlock Grid.Column="6" Text="Ga Kiểm Soát:" Style="{StaticResource FieldLabel}"/>
                <ComboBox Grid.Column="7" x:Name="cboGaKiemSoat" Height="30"
                          DisplayMemberPath="TenGa" SelectedValuePath="MaGa"
                          SelectionChanged="CboGaKiemSoat_SelectionChanged"/>

                <Button Grid.Column="9" Click="BtnLamMoiSoatVe_Click" Style="{StaticResource DesktopButton}" Height="30" ToolTip="Tải lại dữ liệu chuyến tàu và danh sách hành khách (F5)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Margin="0,0,4,0" Foreground="#003B73"/>
                        <TextBlock Text="Làm Mới (F5)" FontSize="12"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="11" Orientation="Horizontal">
                    <Button Click="BtnInDanhSachManifest_Click" Style="{StaticResource DesktopButton}" Height="30" ToolTip="Xuất bảng danh sách hành khách kiểm soát (CSV/Excel)">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Print24" FontSize="13" Margin="0,0,4,0"/>
                            <TextBlock Text="In Manifest" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. THẺ KPI THỐNG KÊ SOÁT VÉ (DESKTOP ERP METRICS) -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- KPI 1: Tổng vé trên tàu -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TỔNG VÉ ĐÃ ĐẶT" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                        <TextBlock x:Name="lblKpiTongVe" Text="0" FontSize="22" FontWeight="Bold" Foreground="#003B73" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="#E2E8F0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="TicketDiagonal24" FontSize="18" Foreground="#003B73" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI 2: Đã lên tàu -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ĐÃ QUA CỬA SOÁT" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                        <TextBlock x:Name="lblKpiDaLenTau" Text="0" FontSize="22" FontWeight="Bold" Foreground="#15803D" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="#DCFCE7" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI 3: Chưa lên tàu -->
            <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CHƯA LÊN TÀU" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1"/>
                        <TextBlock x:Name="lblKpiChuaLenTau" Text="0" FontSize="22" FontWeight="Bold" Foreground="#0369A1" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="#E0F2FE" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Clock24" FontSize="18" Foreground="#0369A1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI 4: Khách đón tại ga này -->
            <Border Grid.Column="6" Background="#FFFFFF" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ĐÓN TẠI GA NÀY" FontSize="11" FontWeight="SemiBold" Foreground="#C2410C"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="lblKpiDonTaiGaDaLen" Text="0" FontSize="22" FontWeight="Bold" Foreground="#C2410C"/>
                            <TextBlock Text=" / " FontSize="16" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="2,0,2,3"/>
                            <TextBlock x:Name="lblKpiDonTaiGaTong" Text="0" FontSize="16" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="#FFEDD5" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="PersonArrowRight24" FontSize="18" Foreground="#C2410C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI 5: Khách trả tại ga này -->
            <Border Grid.Column="8" Background="#FFFFFF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="6" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TRẢ TẠI GA NÀY" FontSize="11" FontWeight="SemiBold" Foreground="#7E22CE"/>
                        <TextBlock x:Name="lblKpiTraTaiGa" Text="0" FontSize="22" FontWeight="Bold" Foreground="#7E22CE" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="#F3E8FF" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="PersonWalking24" FontSize="18" Foreground="#7E22CE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. KHÔNG GIAN LÀM VIỆC CHÍNH (SCANNER/THẨM ĐỊNH & MANIFEST DATAGRID) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450" MinWidth="400" MaxWidth="540"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: Ô QUÉT MÃ VÀ BẢNG THẨM ĐỊNH TRỰC QUAN -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Scanner Box -->
                    <RowDefinition Height="*"/>    <!-- Thẻ kết quả kiểm soát -->
                </Grid.RowDefinitions>

                <!-- Scanner Box -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#003B73" BorderThickness="1.5" CornerRadius="6" Padding="14" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BarcodeScanner24" FontSize="16" Foreground="#003B73" Margin="0,0,6,0"/>
                                <TextBlock Text="MÁY QUÉT BARCODE &amp; QR VÉ" FontSize="13" FontWeight="Bold" Foreground="#003B73"/>
                            </StackPanel>
                            <TextBlock Text="[Enter: Soát vé]" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Ô nhập Scanner -->
                        <Grid Margin="0,0,0,8">
                            <TextBox x:Name="txtScannerInput" Height="40" FontSize="14" FontWeight="SemiBold"
                                     Padding="10,0" VerticalContentAlignment="Center"
                                     KeyDown="TxtScannerInput_KeyDown"/>
                        </Grid>

                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="chkTuDongSoatVe" Content="Tự động cho lên tàu khi vé hợp lệ" 
                                      IsChecked="True" FontSize="11.5" Foreground="#334155" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Click="BtnKiemTraVaSoatVe_Click" Style="{StaticResource PrimaryDesktopButton}" Height="32" Padding="14,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="13" Margin="0,0,4,0"/>
                                    <TextBlock Text="Kiểm Tra (Enter)" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Thẻ kết quả Thẩm định vé (Result Card) -->
                <Border Grid.Row="1" x:Name="bdKetQuaSoatVe" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                    <Grid>
                        <!-- Trạng thái chờ quét (Mặc định) -->
                        <StackPanel x:Name="pnlChoQuetVe" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#F1F5F9" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="ScanThumbUp24" FontSize="32" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="SẴN SÀNG KIỂM SOÁT VÉ" FontSize="14" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                            <TextBlock Text="Quét mã vạch/QR trên vé hoặc thẻ lên tàu,&#x0a;hoặc gõ mã vé / CCCD / tên hành khách vào ô trên." 
                                       FontSize="12" Foreground="#64748B" TextAlignment="Center" Margin="0,6,0,0" LineHeight="18"/>
                        </StackPanel>

                        <!-- Panel kết quả thẩm định vé đã tìm thấy -->
                        <ScrollViewer x:Name="pnlKetQuaChiTiet" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Banner trạng thái -->
                                <Border x:Name="bdBannerTrangThai" BorderThickness="1.5" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon x:Name="iconBannerTrangThai" Symbol="CheckmarkCircle24" FontSize="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="lblBannerTieuDe" Text="HỢP LỆ - ĐƯỢC PHÉP LÊN TÀU" FontSize="13" FontWeight="Bold"/>
                                            <TextBlock x:Name="lblBannerMoTa" Text="Vé hợp lệ và đúng lịch trình chuyến tàu" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            <Button x:Name="btnChuyenSangChuyenTauNay" 
                                                    Content="Chuyển sang kiểm soát chuyến tàu của vé này" 
                                                    Visibility="Collapsed" 
                                                    Margin="0,6,0,0" 
                                                    Padding="10,4"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Cursor="Hand"
                                                    Background="#DC2626"
                                                    Foreground="#FFFFFF"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Left"
                                                    Click="BtnChuyenSangChuyenTauNay_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- VỊ TRÍ TOA XE & GHẾ NGỒI NỔI BẬT -->
                                <Border Background="#003B73" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="TOA XE" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="lblSoatToaXe" Text="TOA 03" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="lblSoatLoaiToa" Text="Ngồi mềm máy lạnh" FontSize="10.5" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="#1E40AF" Width="1" Margin="0,4"/>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="CHỖ NGỒI / GIƯỜNG" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="lblSoatSoGhe" Text="GHẾ 24" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="lblSoatTangGiuong" Text="Tầng 1" FontSize="10.5" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Chi tiết vé và hành khách -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Họ tên & CCCD -->
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Hành khách:" FontSize="12" Foreground="#64748B"/>
                                            <TextBlock x:Name="lblSoatTenKhach" Text="NGUYỄN VĂN AN" FontSize="13" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Số CCCD / ĐD:" FontSize="12" Foreground="#64748B"/>
                                            <TextBlock x:Name="lblSoatCccdKhach" Text="001202008899" FontSize="12" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Border Height="1" Background="#E2E8F0" Margin="0,4,0,8"/>

                                        <!-- Hành trình chặng -->
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Hành trình:" FontSize="12" Foreground="#64748B"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="lblSoatGaDi" Text="Hà Nội" FontSize="12.5" FontWeight="Bold" Foreground="#003B73"/>
                                                <ui:SymbolIcon Symbol="ArrowRight24" FontSize="11" Margin="4,0" Foreground="#64748B" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="lblSoatGaDen" Text="Sài Gòn" FontSize="12.5" FontWeight="Bold" Foreground="#003B73"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Chuyến tàu & Giờ chạy -->
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Mác tàu / Ngày:" FontSize="12" Foreground="#64748B"/>
                                            <TextBlock x:Name="lblSoatMacTauNgay" Text="SE1 - 24/09/2026" FontSize="12" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Giờ xuất phát ga đi:" FontSize="12" Foreground="#64748B"/>
                                            <TextBlock x:Name="lblSoatGioXuatPhat" Text="06:00" FontSize="12" FontWeight="SemiBold" Foreground="#15803D" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!-- Mã vé & Giá vé -->
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Mã vé / Code:" FontSize="12" Foreground="#64748B"/>
                                            <TextBlock x:Name="lblSoatMaVeCode" Text="TK_89FA012B" FontSize="12" FontWeight="Bold" Foreground="#003B73" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Giá vé thực thu:" FontSize="12" Foreground="#64748B"/>
                                            <TextBlock x:Name="lblSoatGiaVe" Text="850.000 VNĐ" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Lịch sử kiểm soát vé -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="THÔNG TIN SOÁT VÉ:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Trạng thái vé:" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock x:Name="lblSoatTrangThaiHienTai" Text="Chưa lên tàu" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Thời điểm soát:" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock x:Name="lblSoatThoiDiem" Text="--" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Ga soát vé:" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock x:Name="lblSoatGaKiemSoat" Text="--" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Nút thao tác trực tiếp -->
                                <UniformGrid Columns="2" Margin="0,0,0,6">
                                    <Button x:Name="btnXacNhanLenTau" Click="BtnXacNhanLenTau_Click" Style="{StaticResource PrimaryDesktopButton}" Height="34" Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="13" Margin="0,0,4,0"/>
                                            <TextBlock Text="Xác Nhận Lên Tàu" FontSize="11.5" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="btnHuySoatVe" Click="BtnHuySoatVe_Click" Style="{StaticResource DesktopButton}" Height="34" Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Margin="0,0,4,0" Foreground="#B91C1C"/>
                                            <TextBlock Text="Hủy Soát (Nhầm)" FontSize="11.5" Foreground="#B91C1C"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>

                                <Button Click="BtnXemTheLenTauSoatVe_Click" Style="{StaticResource DesktopButton}" Height="30" Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Print24" FontSize="12" Margin="0,0,4,0" Foreground="#003B73"/>
                                        <TextBlock Text="Xem &amp; In Thẻ Lên Tàu (F8)" FontSize="11.5"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- CỘT PHẢI: DANH SÁCH KIỂM SOÁT HÀNH KHÁCH (MANIFEST) -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Thanh công cụ tìm kiếm và lọc manifest -->
                        <RowDefinition Height="*"/>    <!-- DataGrid danh sách hành khách -->
                        <RowDefinition Height="Auto"/> <!-- Footer tổng kết -->
                    </Grid.RowDefinitions>

                    <!-- Thanh công cụ Manifest -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Tiêu đề -->
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="230"/>  <!-- Ô tìm kiếm -->
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="200"/>  <!-- Lọc trạng thái -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/> <!-- Soát theo toa/đoàn -->
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="DANH SÁCH HÀNH KHÁCH (MANIFEST)" FontSize="13" FontWeight="Bold" Foreground="#003B73"/>
                            <TextBlock x:Name="lblManifestSubTitle" Text="Hiển thị hành khách trên chuyến tàu" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>

                        <!-- Ô tìm kiếm nhanh trong manifest -->
                        <TextBox Grid.Column="2" x:Name="txtTimKiemManifest" Height="30"
                                 Padding="8,0" VerticalContentAlignment="Center"
                                 TextChanged="TxtTimKiemManifest_TextChanged"
                                 ToolTip="Tìm nhanh theo Tên, CCCD, Mã vé, Số ghế"/>

                        <!-- Lọc trạng thái trong manifest -->
                        <ComboBox Grid.Column="4" x:Name="cboLocTrangThaiManifest" Height="30"
                                  SelectionChanged="CboLocTrangThaiManifest_SelectionChanged">
                            <ComboBoxItem Content="Tất cả hành khách" Tag="ALL"/>
                            <ComboBoxItem Content="Đón tại ga này (Chưa lên)" Tag="DON_GA_CHUA_LEN"/>
                            <ComboBoxItem Content="Đón tại ga này (Đã lên)" Tag="DON_GA_DA_LEN"/>
                            <ComboBoxItem Content="Đã lên tàu (Toàn bộ)" Tag="DA_LEN_TAU"/>
                            <ComboBoxItem Content="Chưa lên tàu (Toàn bộ)" Tag="DA_DAT"/>
                            <ComboBoxItem Content="Đã hủy / Hoàn vé" Tag="HUY_HOAN"/>
                        </ComboBox>

                        <!-- Nút kiểm soát nhanh theo ga -->
                        <Button Grid.Column="6" Click="BtnSoatTatCaGaHienTai_Click" Style="{StaticResource DesktopButton}" Height="30" ToolTip="Xác nhận lên tàu nhanh cho toàn bộ khách đón tại ga này">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CheckmarkSquare24" FontSize="13" Margin="0,0,4,0" Foreground="#15803D"/>
                                <TextBlock Text="Soát Hết Khách Ga Này" FontSize="11.5" Foreground="#15803D" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- DataGrid Manifest -->
                    <DataGrid Grid.Row="1" x:Name="dgvManifest" AutoGenerateColumns="False" 
                              IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                              SelectionChanged="DgvManifest_SelectionChanged"
                              MouseDoubleClick="DgvManifest_MouseDoubleClick">
                        <DataGrid.Columns>
                            <!-- Toa xe -->
                            <DataGridTemplateColumn Header="Toa" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding ThuTuNoiToa, StringFormat='Toa {0}'}" FontWeight="Bold" FontSize="11" Foreground="#003B73"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Chỗ ngồi / Giường -->
                            <DataGridTemplateColumn Header="Chỗ" Width="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SoGhe, StringFormat='Số {0}'}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Họ tên hành khách -->
                            <DataGridTextColumn Header="Họ Tên Hành Khách" Binding="{Binding TenHanhKhach}" Width="*" FontWeight="SemiBold"/>

                            <!-- CCCD -->
                            <DataGridTextColumn Header="Số CCCD" Binding="{Binding CCCDHanhKhach}" Width="115"/>

                            <!-- Chặng đi - đến -->
                            <DataGridTemplateColumn Header="Chặng Đi - Đến" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TenGaDi}" FontWeight="SemiBold" FontSize="11.5" Foreground="#003B73"/>
                                            <TextBlock Text=" ➔ " FontSize="10" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding TenGaDen}" FontWeight="SemiBold" FontSize="11.5" Foreground="#003B73"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Giá vé -->
                            <DataGridTextColumn Header="Giá Vé" Binding="{Binding GiaVeThucThu, Converter={StaticResource CurrencyConv}}" Width="100"/>

                            <!-- Trạng thái vé (Badge) -->
                            <DataGridTemplateColumn Header="Trạng Thái" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding TrangThai, Converter={StaticResource TrangThaiVeConv}, ConverterParameter='BgColor'}"
                                                BorderBrush="{Binding TrangThai, Converter={StaticResource TrangThaiVeConv}, ConverterParameter='BorderColor'}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="{Binding TrangThai, Converter={StaticResource TrangThaiVeConv}, ConverterParameter='Icon'}"
                                                               FontSize="10" Margin="0,0,4,0"
                                                               Foreground="{Binding TrangThai, Converter={StaticResource TrangThaiVeConv}, ConverterParameter='Color'}"/>
                                                <TextBlock Text="{Binding TrangThai, Converter={StaticResource TrangThaiVeConv}}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding TrangThai, Converter={StaticResource TrangThaiVeConv}, ConverterParameter='Color'}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Thời điểm soát vé -->
                            <DataGridTemplateColumn Header="Thời Điểm Soát" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ThoiDiemSoatVe, StringFormat='{}{0:HH:mm dd/MM}'}" FontSize="11" Foreground="#475569" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Thao tác trực tiếp -->
                            <DataGridTemplateColumn Header="Thao Tác" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Click="BtnDongSoatVe_Click" Style="{StaticResource DesktopButton}" 
                                                    Height="24" Padding="6,0" Margin="0" ToolTip="Soát vé / Hủy soát vé">
                                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="11" Foreground="#15803D"/>
                                            </Button>
                                            <Button Click="BtnDongInThe_Click" Style="{StaticResource DesktopButton}" 
                                                    Height="24" Padding="6,0" Margin="4,0,0,0" ToolTip="In thẻ lên tàu">
                                                <ui:SymbolIcon Symbol="Print24" FontSize="11" Foreground="#003B73"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer tổng kết -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,6" Margin="0,4,0,0">
                        <Grid>
                            <TextBlock x:Name="lblManifestTongKet" Text="Hiển thị 0 hành khách" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Phím tắt: " FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <Border Background="#E2E8F0" CornerRadius="3" Padding="4,1" Margin="2,0">
                                    <TextBlock Text="Enter" FontSize="10.5" FontWeight="Bold" Foreground="#003B73"/>
                                </Border>
                                <TextBlock Text="Soát mã vạch | " FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <Border Background="#E2E8F0" CornerRadius="3" Padding="4,1" Margin="2,0">
                                    <TextBlock Text="F5" FontSize="10.5" FontWeight="Bold" Foreground="#003B73"/>
                                </Border>
                                <TextBlock Text="Làm mới | " FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <Border Background="#E2E8F0" CornerRadius="3" Padding="4,1" Margin="2,0">
                                    <TextBlock Text="F8" FontSize="10.5" FontWeight="Bold" Foreground="#003B73"/>
                                </Border>
                                <TextBlock Text="In thẻ lên tàu" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
