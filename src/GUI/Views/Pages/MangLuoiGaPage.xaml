<Page x:Class="GUI.Views.Pages.MangLuoiGaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Mạng Lưới Ga">

    <Grid Background="#F8FAFC">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="8" Padding="36,28" MaxWidth="500">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="28" Background="#EFF6FF" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="Globe24" FontSize="28" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="PHÂN HỆ MẠNG LƯỚI GA" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Mô-đun đang trong quá trình phát triển." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
