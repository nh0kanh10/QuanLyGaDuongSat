<Page x:Class="GUI.Views.Pages.MangLuoiGaPage"
      
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      
    xmlns:uc="clr-namespace:GUI.Views.UserControls"
      
    xmlns:conv="clr-namespace:GUI.Converters"
      Title="Quản Lý Mạng Lưới Ga &amp; Tuyến Đường"
      PreviewKeyDown="Page_PreviewKeyDown">
    <Page.Resources>
        <conv:HangGaConverter x:Key="HangGaConv"/>
        <conv:BooleanToSymbolConverter x:Key="BoolSymbolConv"/>
        <conv:KmFormatConverter x:Key="KmConv"/>
        <!-- Phân cách phân đoạn trong Panel Chi Tiết -->
        <Style x:Key="SectionDivider" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Margin" Value="0,10,0,8"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#003B73"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="RequiredLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Style cho Thẻ Khung Nhóm Thông Tin trong Inspector -->
        <Style x:Key="InspectorCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#003B73"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Style cho TabItem phẳng chuẩn mực hệ thống trong Inspector -->
        <Style x:Key="SystemTabItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}" Background="Transparent" Margin="0,0,8,0">
                            <ContentPresenter x:Name="contentPresenter" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#003B73"/>
                                <Setter Property="Foreground" Value="#003B73"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#003B73"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Margin="12,10,12,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="560"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="520" MinWidth="440" MaxWidth="750"/>
        </Grid.ColumnDefinitions>
        <!-- Bảng danh sách mạng lưới ga -->
        <Border Grid.Column="0" 
                Background="#FFFFFF" 
                BorderBrush="#CBD5E1" 
                BorderThickness="1" 
                CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" 
                        Background="#F8FAFC" 
                        BorderBrush="#CBD5E1" 
                        BorderThickness="0,0,0,1" 
                        Padding="16,12,16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- HÀNG 1: TIÊU ĐỀ BẢNG THOÁNG ĐÃNG & THANH CÔNG CỤ TÁC NGHIỆP CAO RÁO -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <!-- Tiêu đề bảng & Huy hiệu dữ liệu đĩnh đạc -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Table24" FontSize="16" Foreground="#003B73" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="DANH SÁCH GA TRÊN TUYẾN" FontSize="14.5" FontWeight="Bold" Foreground="#003B73" VerticalAlignment="Center"/>
                                    <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtTongSo" Text="13 ga" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                                    </Border>
                                    <Border x:Name="bdDemKetQuaLoc" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock x:Name="txtDemKetQuaLoc" Text="Hiển thị 5/13 ga" FontSize="11" FontWeight="Bold" Foreground="#92400E"/>
                                    </Border>
                                </StackPanel>
                                <!-- Ngữ cảnh tuyến đường thông thoáng, sang trọng -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ui:SymbolIcon Symbol="Navigation24" FontSize="11" Foreground="#0284C7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Tuyến đường sắt Thống Nhất (Hà Nội — Sài Gòn • 1.726,20 km)" FontSize="11" Foreground="#64748B" FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- THANH CÔNG CỤ 3 CỤM HÀNH ĐỘNG (CHUẨN DESKTOP ENTERPRISE 34PX) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Cụm 1: Nút tạo mới (Primary Action) -->
                                <Button x:Name="btnThemGaMoi" 
                                        Click="BtnThemGaMoi_Click" 
                                        Style="{StaticResource PrimaryDesktopButton}"
                                        Height="34" 
                                        Padding="14,0" 
                                        Margin="0,0,10,0"
                                        ToolTip="Thêm ga mới vào tuyến đường sắt (F2 hoặc Ctrl+N)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Thêm ga mới" FontWeight="Bold" FontSize="11.5"/>
                                    </StackPanel>
                                </Button>

                                <!-- Cụm 2: Nhóm Trao đổi dữ liệu (Data I/O Group) -->
                                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Height="34" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnNhapFile" 
                                                Click="BtnNhapFile_Click"
                                                Height="32" 
                                                Padding="11,0" 
                                                Background="Transparent" 
                                                BorderThickness="0" 
                                                Cursor="Hand"
                                                ToolTip="Nhập danh sách ga hàng loạt từ tệp Excel / CSV (F4)">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="13" Margin="0,0,5,0" Foreground="#003B73"/>
                                                <TextBlock Text="Nhập tệp" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                                            </StackPanel>
                                        </Button>
                                        <Rectangle Width="1" Fill="#E2E8F0" Margin="0,4"/>
                                        <Button x:Name="btnXuatExcel" 
                                                Click="BtnXuatExcel_Click"
                                                Height="32" 
                                                Padding="11,0" 
                                                Background="Transparent" 
                                                BorderThickness="0" 
                                                Cursor="Hand"
                                                ToolTip="Xuất toàn bộ danh sách ga ra tệp Excel (F6 hoặc Ctrl+E)">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Margin="0,0,5,0" Foreground="#003B73"/>
                                                <TextBlock Text="Xuất Excel" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Cụm 3: Báo cáo & In ấn kỹ thuật -->
                                <Button x:Name="btnInBaoCao" 
                                        Click="BtnInBaoCao_Click"
                                        Height="34" 
                                        Padding="12,0" 
                                        Background="#FFFFFF" 
                                        BorderBrush="#CBD5E1" 
                                        BorderThickness="1" 
                                        Cursor="Hand"
                                        ToolTip="Mở trung tâm in &amp; xuất báo cáo kỹ thuật ga (F9 hoặc Ctrl+P)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ClipboardTask24" FontSize="13.5" Margin="0,0,6,0" Foreground="#003B73"/>
                                        <TextBlock Text="Báo cáo thống kê" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- HÀNG 2: BỘ LỌC TÌM KIẾM ĐỒNG BỘ CHUẨN MỰC (CAO RÁO 32PX) -->
                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 1. Ô tìm kiếm đa năng kèm shortcut Ctrl+K -->
                                <Grid Grid.Column="0" Width="260">
                                    <ui:TextBox x:Name="txtTimKiem" 
                                                MaxLength="100"
                                                TextChanged="TxtTimKiem_TextChanged"
                                                Height="32"
                                                FontSize="11.5"
                                                VerticalContentAlignment="Center"
                                                Padding="30,0,52,0"/>
                                    <ui:SymbolIcon Symbol="Search24" FontSize="13.5" Foreground="#94A3B8" 
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" 
                                                   Margin="9,0,0,0" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="txtWatermark" 
                                               Text="Tìm tên ga, mã code, tỉnh, km..." 
                                               FontSize="11" Foreground="#94A3B8" 
                                               VerticalAlignment="Center" 
                                               Margin="30,0,0,0" 
                                               IsHitTestVisible="False"/>
                                    <Border x:Name="bdShortcutSearch" 
                                            Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" 
                                            Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" 
                                            IsHitTestVisible="False">
                                        <TextBlock Text="Ctrl+K" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                                    </Border>
                                    <Button x:Name="btnXoaTimKiem" 
                                            Click="BtnXoaTimKiem_Click"
                                            Visibility="Collapsed"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,7,0"
                                            Width="20" Height="20"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="Xóa tìm kiếm (Esc)">
                                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="11" Foreground="#94A3B8"/>
                                    </Button>
                                </Grid>

                                <Rectangle Grid.Column="1" Width="1" Height="20" Fill="#E2E8F0" Margin="10,0"/>

                                <!-- 2. Dropdown phân cấp ga có tiền tố trường rõ ràng -->
                                <ComboBox Grid.Column="2" 
                                          x:Name="cboLocHangGa" 
                                          SelectionChanged="CboLoc_SelectionChanged"
                                          Width="195" Height="32" FontSize="11.5" Margin="0,0,8,0">
                                    <ComboBoxItem Content="Cấp ga: Tất cả" IsSelected="True"/>
                                    <ComboBoxItem Content="Cấp ga: Hạng I (Đầu mối)"/>
                                    <ComboBoxItem Content="Cấp ga: Hạng II (Trung chuyển)"/>
                                    <ComboBoxItem Content="Cấp ga: Hạng III (Tránh xe)"/>
                                </ComboBox>

                                <!-- 3. Dropdown trạng thái có tiền tố trường -->
                                <ComboBox Grid.Column="3" 
                                          x:Name="cboLocKhaiThac" 
                                          SelectionChanged="CboLoc_SelectionChanged" 
                                          Width="165" Height="32" FontSize="11.5" Margin="0,0,8,0">
                                    <ComboBoxItem Content="Trạng thái: Tất cả" IsSelected="True"/>
                                    <ComboBoxItem Content="Trạng thái: Đang khai thác"/>
                                    <ComboBoxItem Content="Trạng thái: Tạm ngừng"/>
                                </ComboBox>

                                <!-- 4. Filter chip Toggle Cầu quay cùng chiều cao chuẩn 32px -->
                                <Border Grid.Column="4" 
                                        x:Name="bdChipCauQuay" 
                                        Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" 
                                        Height="32" Padding="10,0" VerticalAlignment="Center" Cursor="Hand">
                                    <CheckBox x:Name="chkLocCauQuay" 
                                              Content="Có cầu quay" 
                                              Checked="ChkLocCauQuay_Changed" 
                                              Unchecked="ChkLocCauQuay_Changed"
                                              FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" 
                                              VerticalAlignment="Center" Cursor="Hand"/>
                                </Border>

                                <!-- 5. Nút Đặt lại bộ lọc trực quan (khi có lọc) -->
                                <Button Grid.Column="5" 
                                        x:Name="btnXoaTatCaLoc" 
                                        Click="BtnXoaTatCaLoc_Click"
                                        Visibility="Collapsed"
                                        Height="32" Padding="12,0"
                                        Margin="8,0,0,0"
                                        Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                                        Foreground="#B91C1C" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand"
                                        ToolTip="Đặt lại toàn bộ các tiêu chí lọc về mặc định (Esc)"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowReset24" FontSize="12.5" Margin="0,0,5,0" Foreground="#DC2626"/>
                                        <TextBlock Text="Đặt lại bộ lọc"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <DataGrid Grid.Row="1" 
                          x:Name="dgGa" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          SelectionMode="Single" 
                          CanUserAddRows="False"
                          CanUserSortColumns="True"
                          SelectionChanged="DgGa_SelectionChanged"
                          LoadingRow="DgGa_LoadingRow"
                          BorderThickness="0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#F1F5F9"/>
                            <Style.Triggers>
                                <!-- Hover: Xám nhạt thanh thoát -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                                <!-- Select: Nền Slate-200 dịu mắt, không đổi cỡ chữ hay nét chữ, không nhảy layout -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E2E8F0"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1">
                            <MenuItem x:Name="ctxCopyCode" Header="Sao chép Mã Code Ga" Click="CtxCopyCode_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Copy24" FontSize="14" Foreground="#003B73"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ctxCopyTenKm" Header="Sao chép Tên &amp; Lý Trình" Click="CtxCopyTenKm_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="DocumentCopy24" FontSize="14" Foreground="#003B73"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ctxCopyRow" Header="Sao chép Toàn Bộ Dòng (Tab-separated)" Click="CtxCopyRow_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Table24" FontSize="14" Foreground="#003B73"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Background="#E2E8F0"/>
                            <MenuItem x:Name="ctxThemDuongRay" Header="Thêm Đường Ray Mới Vào Ga Này..." Click="CtxThemDuongRay_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Branch24" FontSize="14" Foreground="#003B73"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ctxXemKhuGian" Header="Xem Các Phân Đoạn Khu Gian Liên Kết..." Click="CtxXemKhuGian_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="14" Foreground="#003B73"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Background="#E2E8F0"/>
                            <MenuItem x:Name="ctxDoiTrangThai" Header="Đổi nhanh Trạng Thái Khai Thác" Click="CtxDoiTrangThai_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSyncCircle24" FontSize="14" Foreground="#15803D"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="ctxXemNhatKy" Header="Xem Lịch Sử Nhật Ký Sửa Đổi" Click="CtxXemNhatKy_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="History24" FontSize="14" Foreground="#D97706"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Background="#E2E8F0"/>
                            <MenuItem x:Name="ctxLamMoi" Header="Làm Mới Bảng Dữ Liệu (F5)" Click="CtxLamMoi_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="#003B73"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Background="#E2E8F0"/>
                            <MenuItem x:Name="ctxXoaGa" Header="Xóa Ga Này Khỏi Hệ Thống..." Click="CtxXoaGa_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#DC2626"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <!-- STT liên tục 1..N -->
                        <DataGridTextColumn Header="STT" Binding="{Binding STT}" SortMemberPath="STT" Width="48" HeaderStyle="{StaticResource DataGridHeaderCenter}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Mã Code" Binding="{Binding MaGaCode}" SortMemberPath="MaGaCode" Width="80" HeaderStyle="{StaticResource DataGridHeaderCenter}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tên Ga" Binding="{Binding TenGa}" SortMemberPath="TenGa" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Lý Trình (km)" Binding="{Binding LyTrinhKm, Converter={StaticResource KmConv}}" SortMemberPath="LyTrinhKm" Width="110" HeaderStyle="{StaticResource DataGridHeaderRight}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tỉnh / Thành Phố" Binding="{Binding TinhThanh}" SortMemberPath="TinhThanh" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#334155"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Phân Cấp Ga: Rút gọn thành Hạng I / II / III, đưa giải thích vào Tooltip -->
                        <DataGridTextColumn Header="Phân Cấp Ga" Binding="{Binding HangGa, Converter={StaticResource HangGaConv}, ConverterParameter=Short}" SortMemberPath="HangGa" Width="95" HeaderStyle="{StaticResource DataGridHeaderCenter}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="ToolTip" Value="{Binding HangGa, Converter={StaticResource HangGaConv}}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Cầu Quay: Hiển thị chữ rõ ràng "Có" hoặc để trống thoáng mắt -->
                        <DataGridTemplateColumn Header="Cầu Quay" SortMemberPath="CoCauQuay" Width="80" HeaderStyle="{StaticResource DataGridHeaderCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Có" Foreground="#15803D" FontWeight="Bold" FontSize="11"
                                                   Visibility="{Binding CoCauQuay, Converter={StaticResource BoolSymbolConv}, ConverterParameter=VisibilityTrue}"/>
                                        <TextBlock Text="—" Foreground="#CBD5E1" FontSize="11" HorizontalAlignment="Center"
                                                   Visibility="{Binding CoCauQuay, Converter={StaticResource BoolSymbolConv}, ConverterParameter=VisibilityFalse}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Khai Thác: Ngoại lệ "Tạm ngừng" đỏ sẫm BOLD, 26 ga "Đang khai thác" chấm xám dịu mắt -->
                        <DataGridTemplateColumn Header="Khai Thác" SortMemberPath="DangKhaiThac" Width="115" HeaderStyle="{StaticResource DataGridHeaderCenter}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse x:Name="dotStatusGa" Width="7" Height="7" Margin="0,0,6,0" Fill="#94A3B8" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtStatusGa" Text="Đang khai thác" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DangKhaiThac}" Value="True">
                                            <Setter TargetName="dotStatusGa" Property="Fill" Value="#94A3B8"/>
                                            <Setter TargetName="txtStatusGa" Property="Text" Value="Đang khai thác"/>
                                            <Setter TargetName="txtStatusGa" Property="Foreground" Value="#475569"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DangKhaiThac}" Value="False">
                                            <Setter TargetName="dotStatusGa" Property="Fill" Value="#DC2626"/>
                                            <Setter TargetName="txtStatusGa" Property="Text" Value="Tạm ngừng"/>
                                            <Setter TargetName="txtStatusGa" Property="Foreground" Value="#B91C1C"/>
                                            <Setter TargetName="txtStatusGa" Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Đường Ray: Căn phải số đếm -->
                        <DataGridTextColumn Header="Đường Ray" Binding="{Binding SoDuongRay}" SortMemberPath="SoDuongRay" Width="85" HeaderStyle="{StaticResource DataGridHeaderRight}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Setter Property="Margin" Value="0,0,14,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Khu Gian: Căn phải số đếm -->
                        <DataGridTextColumn Header="Khu Gian" Binding="{Binding SoKhuGian, StringFormat={}{0} khu gian}" SortMemberPath="SoKhuGian" Width="100" HeaderStyle="{StaticResource DataGridHeaderRight}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- Empty State khi tìm kiếm không có kết quả -->
                <Border x:Name="pnlEmptyState" Grid.Row="1" Background="#FFFFFF" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" Background="#F1F5F9" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Search24" FontSize="26" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Không tìm thấy ga nào phù hợp" FontSize="14" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="txtEmptySearchMsg" Text="Vui lòng kiểm tra lại từ khóa tìm kiếm hoặc điều chỉnh bộ lọc cấp ga / trạng thái." FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <Button Click="BtnXoaTatCaLoc_Click" Height="30" Padding="14,0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" HorizontalAlignment="Center" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowReset24" FontSize="13" Margin="0,0,6,0" Foreground="#003B73"/>
                                <TextBlock Text="Đặt Lại Bộ Lọc" FontSize="11" FontWeight="SemiBold" Foreground="#003B73"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <!-- Thanh Phân Trang kết nối trực tiếp liền mạch dưới chân DataGrid -->
                <uc:PaginationControl Grid.Row="2" x:Name="pagerGa"
                                      PageChanged="PagerGa_PageChanged"
                                      PageSizeChanged="PagerGa_PageSizeChanged"/>

                <!-- Giữ pbLyTrinh và txtThongTinLyTrinh ở dạng ẩn để tương thích 100% C# code-behind -->
                <StackPanel Visibility="Collapsed">
                    <ProgressBar x:Name="pbLyTrinh"/>
                    <TextBlock x:Name="txtThongTinLyTrinh"/>
                </StackPanel>
            </Grid>
        </Border>
        <GridSplitter Grid.Column="1" 
                      Width="8" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Stretch" 
                      Background="Transparent" 
                      Cursor="SizeWE"/>
        <!-- Thông tin chi tiết ga -->
        <Border Grid.Column="2" 
                Background="#FFFFFF" 
                BorderBrush="#CBD5E1" 
                BorderThickness="1" 
                CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Inspector Header -->
                    <RowDefinition Height="*"/>
                    <!-- Tabbed Inspector Content -->
                </Grid.RowDefinitions>
                <uc:InspectorHeader Grid.Row="0" x:Name="inspectorHeader" DeleteClicked="CrudActionBar_DeleteClicked"/>
                <!--Tab 1 = Thông Tin Ga, Tab 2 = Cấu Hình Đường Ray -->
                <TabControl Grid.Row="1" x:Name="tabInspector" BorderThickness="0" Background="Transparent" SelectionChanged="TabInspector_SelectionChanged">
                    <!-- TAB 1: THÔNG TIN GA & KHU GIAN LIÊN KẾT                       -->
                    <TabItem Style="{StaticResource SystemTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Info24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Thông Tin Ga" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0" x:Name="scrollViewerForm" VerticalScrollBarVisibility="Auto" Padding="14,8">
                                <StackPanel>
                                    <!-- Chỉ xuất hiện khi nhập liệu thiếu hoặc sai -->
                                    <Border x:Name="pnlFormError" 
                                            Background="#FEF2F2" 
                                            BorderBrush="#FCA5A5" 
                                            BorderThickness="1" 
                                            CornerRadius="5" 
                                            Padding="12,8" 
                                            Margin="0,0,0,12" 
                                            Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="#DC2626" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="txtFormErrorMsg" 
                                                       Text="Vui lòng nhập đầy đủ các trường thông tin bắt buộc." 
                                                       Foreground="#B91C1C" 
                                                       FontSize="11.5" 
                                                       FontWeight="SemiBold" 
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Click="BtnDismissFormError_Click"
                                                    Background="Transparent" BorderThickness="0" Padding="4,0" Cursor="Hand" ToolTip="Đóng thông báo">
                                                <ui:SymbolIcon Symbol="Dismiss16" FontSize="11" Foreground="#991B1B"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Hàng 1: Tên Ga & Mã Code Ga  -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Tên Ga Đón Trả -->
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="Tên ga đón trả hành khách / hàng hóa" Style="{StaticResource RequiredLabel}"/>
                                                <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBox x:Name="txtTenGa" MaxLength="100" Height="32" FontSize="12.5" FontWeight="SemiBold"
                                                     TextChanged="FormInput_Changed"/>
                                        </StackPanel>

                                        <!-- Mã Code Ga -->
                                        <StackPanel Grid.Column="2">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="Mã code ga" Style="{StaticResource RequiredLabel}"/>
                                                <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                                <ui:SymbolIcon Symbol="LockClosed16" FontSize="11" Foreground="#64748B" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="Mã định danh duy nhất (khóa cố định khi sửa ga đã lưu)"/>
                                            </StackPanel>
                                            <TextBox x:Name="txtMaCode" MaxLength="10" Height="32"
                                                     CharacterCasing="Upper" FontFamily="Consolas" FontWeight="Bold" FontSize="12.5"
                                                     TextChanged="FormInput_Changed"
                                                     LostFocus="TxtMaCode_LostFocus"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Hàng 2: Tỉnh / Thành Phố & Phân Cấp Ga -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Địa Bàn Tỉnh / Thành -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Địa bàn tỉnh / thành phố" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="cboTinhThanh" Height="32" FontSize="12" IsEditable="False"
                                                      SelectionChanged="FormCombo_Changed">
                                                <ComboBoxItem Content="Hà Nội" IsSelected="True"/>
                                                <ComboBoxItem Content="Hà Nam"/>
                                                <ComboBoxItem Content="Nam Định"/>
                                                <ComboBoxItem Content="Ninh Bình"/>
                                                <ComboBoxItem Content="Thanh Hóa"/>
                                                <ComboBoxItem Content="Nghệ An"/>
                                                <ComboBoxItem Content="Hà Tĩnh"/>
                                                <ComboBoxItem Content="Quảng Bình"/>
                                                <ComboBoxItem Content="Quảng Trị"/>
                                                <ComboBoxItem Content="Thừa Thiên Huế"/>
                                                <ComboBoxItem Content="Đà Nẵng"/>
                                                <ComboBoxItem Content="Quảng Nam"/>
                                                <ComboBoxItem Content="Quảng Ngãi"/>
                                                <ComboBoxItem Content="Bình Định"/>
                                                <ComboBoxItem Content="Phú Yên"/>
                                                <ComboBoxItem Content="Khánh Hòa"/>
                                                <ComboBoxItem Content="Ninh Thuận"/>
                                                <ComboBoxItem Content="Bình Thuận"/>
                                                <ComboBoxItem Content="Đồng Nai"/>
                                                <ComboBoxItem Content="Bình Dương"/>
                                                <ComboBoxItem Content="TP. Hồ Chí Minh"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Phân Cấp Ga Vận Hành -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Phân cấp ga vận hành" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="cboHangGa" Height="32" FontSize="12" SelectionChanged="FormCombo_Changed">
                                                <ComboBoxItem Content="Hạng I (Đầu mối trung tâm lớn)" IsSelected="True"/>
                                                <ComboBoxItem Content="Hạng II (Trung chuyển khu vực)"/>
                                                <ComboBoxItem Content="Hạng III (Tránh vượt kỹ thuật)"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Hàng 3: Lý Trình (km) & Trắc Dọc Tuyến Tích Hợp Gọn Gàng -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Lý Trình (km) -->
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="Lý trình (km)" Style="{StaticResource RequiredLabel}"/>
                                                <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBox x:Name="txtLyTrinh" 
                                                     MaxLength="8" Height="32"
                                                     FontFamily="Consolas" FontWeight="SemiBold" FontSize="12.5"
                                                     TextChanged="FormInput_Changed"
                                                     PreviewTextInput="TxtLyTrinh_PreviewTextInput"
                                                     PreviewKeyDown="TxtLyTrinh_PreviewKeyDown"
                                                     LostFocus="TxtLyTrinh_LostFocus"
                                                     ToolTip="Khoảng cách tính từ Ga đầu tuyến (Km 0.00 đến tối đa 5.000,00 km)"/>
                                        </StackPanel>

                                        <!-- Thước đo tiến trình trục tuyến mini tích hợp -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,4" Height="32">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <TextBlock x:Name="txtTyLeTuyen" Text="45.8% trục tuyến" FontSize="10.5" FontWeight="Bold" Foreground="#003B73" HorizontalAlignment="Left"/>
                                                        <TextBlock x:Name="txtKhoangCachSaiGon" Text="Cách ga cuối 934.80 km" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <ProgressBar Grid.Row="1" x:Name="pbLyTrinhMini" Height="4" Minimum="0" Maximum="5000" Value="791.4" Foreground="#0284C7" Background="#E2E8F0" BorderThickness="0" Margin="0,2,0,0"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Hàng 4: Trạng Thái Vận Hành & Cầu Quay Đầu Máy (Đồng bộ ngang) -->
                                    <Grid Margin="0,2,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Segmented Toggle Trạng Thái Khai Thác Chuẩn Fluent -->
                                        <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="3" Height="34" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Đang khai thác -->
                                                <RadioButton Grid.Column="0" x:Name="rbDangKhaiThac" 
                                                             GroupName="grpTrangThaiGa" 
                                                             IsChecked="True" 
                                                             Click="RbTrangThaiGa_Click"
                                                             Margin="0,0,2,0">
                                                    <RadioButton.Template>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="bdPill" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4" Padding="0,4" Cursor="Hand">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Ellipse x:Name="dotStatus" Width="7" Height="7" Fill="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock x:Name="txtPill" Text="Đang khai thác" FontSize="11.5" FontWeight="Medium" Foreground="#64748B" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="bdPill" Property="Background" Value="#FFFFFF"/>
                                                                    <Setter TargetName="bdPill" Property="BorderBrush" Value="#E2E8F0"/>
                                                                    <Setter TargetName="dotStatus" Property="Fill" Value="#16A34A"/>
                                                                    <Setter TargetName="txtPill" Property="Foreground" Value="#0F172A"/>
                                                                    <Setter TargetName="txtPill" Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter TargetName="bdPill" Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.08" Direction="270" Color="#000000"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                        <Condition Property="IsChecked" Value="False"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="bdPill" Property="Background" Value="#E2E8F0"/>
                                                                    <Setter TargetName="txtPill" Property="Foreground" Value="#334155"/>
                                                                </MultiTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </RadioButton.Template>
                                                </RadioButton>

                                                <!-- Tạm ngừng khai thác -->
                                                <RadioButton Grid.Column="1" x:Name="rbTamNgungKhaiThac" 
                                                             GroupName="grpTrangThaiGa" 
                                                             Click="RbTrangThaiGa_Click"
                                                             Margin="2,0,0,0">
                                                    <RadioButton.Template>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="bdPill" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4" Padding="0,4" Cursor="Hand">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Ellipse x:Name="dotStatus" Width="7" Height="7" Fill="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                    <TextBlock x:Name="txtPill" Text="Tạm ngừng khai thác" FontSize="11.5" FontWeight="Medium" Foreground="#64748B" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="bdPill" Property="Background" Value="#FFFFFF"/>
                                                                    <Setter TargetName="bdPill" Property="BorderBrush" Value="#E2E8F0"/>
                                                                    <Setter TargetName="dotStatus" Property="Fill" Value="#DC2626"/>
                                                                    <Setter TargetName="txtPill" Property="Foreground" Value="#0F172A"/>
                                                                    <Setter TargetName="txtPill" Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter TargetName="bdPill" Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.08" Direction="270" Color="#000000"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                                <MultiTrigger>
                                                                    <MultiTrigger.Conditions>
                                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                                        <Condition Property="IsChecked" Value="False"/>
                                                                    </MultiTrigger.Conditions>
                                                                    <Setter TargetName="bdPill" Property="Background" Value="#E2E8F0"/>
                                                                    <Setter TargetName="txtPill" Property="Foreground" Value="#334155"/>
                                                                </MultiTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </RadioButton.Template>
                                                </RadioButton>
                                            </Grid>
                                        </Border>

                                        <!-- CheckBox Cầu Quay Đầu Máy -->
                                        <CheckBox Grid.Column="1" x:Name="chkCoCauQuay" 
                                                  Content="Có cầu quay đầu máy xe lửa" 
                                                  FontSize="12"
                                                  FontWeight="SemiBold" Foreground="#0F172A"
                                                  VerticalAlignment="Center" Height="32"
                                                  ToolTip="Ga được trang bị bàn quay kỹ thuật đổi chiều đầu máy xe lửa"
                                                  Click="FormCheck_Changed"/>
                                    </Grid>

                                    <!-- NĂNG LỰC HẠ TẦNG TRONG GA  -->
                                    <Border Style="{StaticResource SectionDivider}" Margin="0,6,0,4"/>

                                    <Border x:Name="bdBoxDuongRay" 
                                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                                            CornerRadius="5" Padding="12,7" Margin="0,0,0,6" 
                                            Cursor="Hand" MouseLeftButtonUp="BdBoxDuongRay_MouseLeftButtonUp" 
                                            ToolTip="Nhấn để chuyển sang Tab quản lý cấu hình các đường ray trong ga">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- Tiêu đề & Nút chuyển tab -->
                                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Branch24" FontSize="13" Foreground="#003B73" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="NĂNG LỰC HẠ TẦNG TRONG GA" FontSize="11" FontWeight="Bold" Foreground="#003B73" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="Cấu hình ray" FontSize="10.5" Foreground="#0284C7" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="11" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <!-- 3 Khối chỉ số KPI hạ tầng -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                                    <StackPanel>
                                                        <TextBlock Text="ĐƯỜNG RAY" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                                        <TextBlock x:Name="txtSoDuongRay" Text="0 đường ray" FontSize="11" FontWeight="Bold" Foreground="#003B73" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                                    <StackPanel>
                                                        <TextBlock Text="SỨC CHỨA" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                                        <TextBlock x:Name="txtTongSucChuaTab0" Text="~0 toa xe" FontSize="11" FontWeight="Bold" Foreground="#15803D" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                                    <StackPanel>
                                                        <TextBlock Text="KE ĐÓN TRẢ" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                                        <TextBlock x:Name="txtTongKeGaTab0" Text="0 ke ga" FontSize="11" FontWeight="Bold" Foreground="#4338CA" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- CÁC KHU GIAN KẾT NỐI TRỰC TIẾP  -->
                                    <Border Style="{StaticResource SectionDivider}" Margin="0,4,0,4"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="13" Foreground="#003B73" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="CÁC KHU GIAN KẾT NỐI TRỰC TIẾP" FontSize="11" FontWeight="Bold" Foreground="#003B73" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Chip đếm khu gian -->
                                        <Border Grid.Column="1" x:Name="bdBoxKhuGian" 
                                                Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" 
                                                CornerRadius="3" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Cursor="Hand" MouseLeftButtonUp="BtnQuanLyKhuGian_Click" ToolTip="Nhấn để xem tổng hợp khu gian toàn tuyến">
                                            <TextBlock x:Name="txtSoKhuGian" Text="0 khu gian kết nối" FontSize="10.5" FontWeight="Bold" Foreground="#003B73"/>
                                        </Border>

                                        <!-- Nút Xem Toàn Tuyến -->
                                        <Button Grid.Column="3" Click="BtnQuanLyKhuGian_Click" 
                                                Height="24" Padding="8,0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" 
                                                Cursor="Hand" ToolTip="Xem chi tiết các khu gian trên toàn tuyến đường sắt">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Open24" FontSize="11" Foreground="#003B73" Margin="0,0,4,0"/>
                                                <TextBlock Text="Xem toàn tuyến" FontSize="10" FontWeight="SemiBold" Foreground="#003B73"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Khung chứa sơ đồ ray tuyến tính trực quan -->
                                    <StackPanel x:Name="pnlChiTietKhuGian" Margin="0,0,0,6">
                                        <TextBlock Text="Chọn ga để xem phân đoạn kết nối" FontSize="11" Foreground="#64748B" FontStyle="Italic"/>
                                    </StackPanel>

                                    <!-- ============================================================== -->
                                    <!-- ĐẶC TÍNH VẬN HÀNH GA (TIÊU ĐỀ NHẸ TINH GỌN LẤP CHIỀU CAO)     -->
                                    <!-- ============================================================== -->
                                    <Border Style="{StaticResource SectionDivider}" Margin="0,4,0,4"/>
                                    <TextBlock Text="ĐẶC TÍNH VẬN HÀNH GA" FontSize="11" FontWeight="Bold" Foreground="#003B73" Margin="0,0,0,4"/>

                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Card 1: Vai trò vận hành theo phân cấp -->
                                            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,4">
                                                <StackPanel>
                                                    <TextBlock Text="VAI TRÒ VẬN HÀNH" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                                    <TextBlock x:Name="txtQuyChuanGa" Text="Hạng II · Trung chuyển khu vực" FontSize="11" FontWeight="Bold" Foreground="#003B73" Margin="0,1,0,1" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="txtTacNghiepGa" Text="Đón trả khách &amp; điều tiết khu vực" FontSize="9.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 2: Thiết bị đầu máy & quay xe -->
                                            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="8,4">
                                                <StackPanel>
                                                    <TextBlock Text="THIẾT BỊ ĐẦU MÁY" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                                    <TextBlock x:Name="txtThietBiQuay" Text="Không trang bị bàn quay" FontSize="11" FontWeight="Bold" Foreground="#0F172A" Margin="0,1,0,1" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="txtMoTaQuay" Text="Tác nghiệp phương thức kéo đẩy 2 đầu" FontSize="9.5" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Dòng Kiểm toán hệ thống thanh mảnh ở đáy, chuẩn như bên Khu Gian -->
                                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Person24" FontSize="12" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Khởi tạo: " FontSize="10.5" Foreground="#64748B"/>
                                                <TextBlock x:Name="txtNguoiTao" Text="admin" FontSize="10.5" Foreground="#334155" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="1" Height="10" Background="#CBD5E1" Margin="8,0"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Clock24" FontSize="12" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Cập nhật: " FontSize="10.5" Foreground="#64748B"/>
                                                <TextBlock x:Name="txtNgayCapNhat" Text="Chưa cập nhật" FontSize="10.5" Foreground="#334155" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Các điều khiển ẩn giữ tương thích 100% C# code-behind -->
                                    <StackPanel Visibility="Collapsed">
                                        <ComboBox x:Name="cboTuyenDuong"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- Thanh Nút Thao Tác CRUD Ga -->
                            <uc:CrudActionBar Grid.Row="1" x:Name="crudActionBar"
                                              SaveClicked="CrudActionBar_SaveClicked"
                                              CancelClicked="CrudActionBar_CancelClicked"
                                              DeleteClicked="CrudActionBar_DeleteClicked"/>
                        </Grid>
                    </TabItem>
                    <!-- ============================================================== -->
                    <!-- TAB 2: CẤU HÌNH ĐƯỜNG RAY TRONG GA (INLINE WORKSPACE)          -->
                    <!-- ============================================================== -->
                    <TabItem Style="{StaticResource SystemTabItem}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Branch24" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Đường Ray Trong Ga" VerticalAlignment="Center"/>
                                <Border x:Name="bdRayCountBadge" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                                    <TextBlock x:Name="txtRayCountTab" Text="0 ray" FontSize="10.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Header & KPI Năng Lực Ga -->
                                <RowDefinition Height="Auto"/>
                                <!-- DataGrid hoặc sơ đồ đường ray ga -->
                                <RowDefinition Height="*"/>
                                <!-- Sơ đồ trực quan & Mini-Form chi tiết ray -->
                                <RowDefinition Height="Auto"/>
                                <!-- Thanh nút Lưu Ray -->
                            </Grid.RowDefinitions>
                            <!-- 1. Header Tab Đường Ray & KPI Năng Lực -->
                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Dòng 1: Tiêu đề & Thêm ray mới -->
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Branch24" FontSize="14" Foreground="#003B73" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="txtTenGaRayTab" Text="HẠ TẦNG RAY GA HÀ NỘI" FontSize="12" FontWeight="Bold" Foreground="#003B73" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button x:Name="btnThemRayMoi" Click="BtnThemRayMoi_Click" Height="26" Padding="10,0" HorizontalAlignment="Right"
                                                Style="{StaticResource PrimaryDesktopButton}" ToolTip="Thêm một đường ray mới vào ga đang chọn">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Add24" FontSize="11" Foreground="#FFFFFF" Margin="0,0,4,0"/>
                                                <TextBlock Text="Thêm Ray Mới" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <!-- Dòng 2: 3 Thẻ KPI Năng Lực Ga Trực Quan -->
                                    <Grid Grid.Row="1" Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="6,4">
                                            <StackPanel>
                                                <TextBlock Text="TỔNG CHIỀU DÀI" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                                <TextBlock x:Name="txtTongChieuDaiRay" Text="0 m" FontSize="11" FontWeight="Bold" Foreground="#003B73"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="6,4">
                                            <StackPanel>
                                                <TextBlock Text="SỨC CHỨA TỐI ĐA" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                                <TextBlock x:Name="txtTongSucChuaGa" Text="~0 toa xe" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="6,4">
                                            <StackPanel>
                                                <TextBlock Text="ĐƯỜNG CÓ KE GA" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                                <TextBlock x:Name="txtTongKeGa" Text="0 đường" FontSize="11" FontWeight="Bold" Foreground="#4338CA"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <!-- Dòng 3: Toggle chế độ hiển thị danh sách ray -->
                                    <Grid Grid.Row="2" Margin="0,8,0,0">
                                        <TextBlock Text="Chọn đường ray để chỉnh sửa" FontSize="11" Foreground="#94A3B8" FontStyle="Italic" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border x:Name="btnViewSoDo" Background="#003B73" BorderBrush="#003B73" BorderThickness="1" CornerRadius="3,0,0,3" Padding="8,3" Cursor="Hand" 
                                                    MouseLeftButtonUp="ToggleViewSoDo_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Branch24" FontSize="11" Foreground="#FFFFFF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="txtViewSoDo" Text="Sơ đồ" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="btnViewBang" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="0,3,3,0" Padding="8,3" Cursor="Hand" 
                                                    MouseLeftButtonUp="ToggleViewBang_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Table24" FontSize="11" Foreground="#64748B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="txtViewBang" Text="Bảng" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <!-- 2. DataGrid Đường Ray Ga -->
                            <DataGrid Grid.Row="1" x:Name="dgDuongRayGa" 
                                      Visibility="Collapsed"
                                      MaxHeight="160"
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True" 
                                      SelectionMode="Single" 
                                      CanUserAddRows="False" 
                                      BorderThickness="0,0,0,1"
                                      BorderBrush="#CBD5E1"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      RowHeight="30"
                                      SelectionChanged="DgDuongRayGa_SelectionChanged">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1">
                                        <MenuItem x:Name="ctxCopyRaySoHieu" Header="Sao chép Số Hiệu Ray" Click="CtxCopyRaySoHieu_Click">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Copy24" FontSize="14" Foreground="#003B73"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem x:Name="ctxCopyRayInfo" Header="Sao chép Thông Số Chi Tiết Đường Ray" Click="CtxCopyRayInfo_Click">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="DocumentCopy24" FontSize="14" Foreground="#003B73"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Background="#E2E8F0"/>
                                        <MenuItem x:Name="ctxDoiTrangThaiRay" Header="Đổi nhanh Trạng Thái Ray (Trống / Bảo Trì)" Click="CtxDoiTrangThaiRay_Click">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="ArrowSyncCircle24" FontSize="14" Foreground="#15803D"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Background="#E2E8F0"/>
                                        <MenuItem x:Name="ctxLamMoiRay" Header="Làm Mới Danh Sách Đường Ray" Click="CtxLamMoiRay_Click">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="#003B73"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Background="#E2E8F0"/>
                                        <MenuItem x:Name="ctxXoaRayItem" Header="Xóa Đường Ray Này" Click="CtxXoaRayItem_Click">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#DC2626"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <!-- Số Hiệu -->
                                    <DataGridTemplateColumn Header="Số Hiệu" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                                    <Border Width="18" Height="18" CornerRadius="9" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding SoHieuDuong}" FontSize="9" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding SoHieuDuong, StringFormat={}Đường {0}}" FontWeight="Bold" Foreground="#0F172A" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Phân Loại Tác Nghiệp (Loại Ray) -->
                                    <DataGridTemplateColumn Header="Loại Ray" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="bdLoai" CornerRadius="3" BorderThickness="1" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Background="#EEF2FF" BorderBrush="#C7D2FE">
                                                    <TextBlock x:Name="txtLoai" Text="Đường Tránh" FontSize="10" FontWeight="SemiBold" Foreground="#4338CA" VerticalAlignment="Center"/>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding LoaiDuong}" Value="CHINH_TUYEN">
                                                        <Setter TargetName="bdLoai" Property="Background" Value="#F0FDF4"/>
                                                        <Setter TargetName="bdLoai" Property="BorderBrush" Value="#BBF7D0"/>
                                                        <Setter TargetName="txtLoai" Property="Text" Value="Chính Tuyến"/>
                                                        <Setter TargetName="txtLoai" Property="Foreground" Value="#15803D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LoaiDuong}" Value="DUONG_TRANH">
                                                        <Setter TargetName="bdLoai" Property="Background" Value="#EEF2FF"/>
                                                        <Setter TargetName="bdLoai" Property="BorderBrush" Value="#C7D2FE"/>
                                                        <Setter TargetName="txtLoai" Property="Text" Value="Đường Tránh"/>
                                                        <Setter TargetName="txtLoai" Property="Foreground" Value="#4338CA"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LoaiDuong}" Value="BOC_DO">
                                                        <Setter TargetName="bdLoai" Property="Background" Value="#FFFBEB"/>
                                                        <Setter TargetName="bdLoai" Property="BorderBrush" Value="#FDE68A"/>
                                                        <Setter TargetName="txtLoai" Property="Text" Value="Bốc Dỡ"/>
                                                        <Setter TargetName="txtLoai" Property="Foreground" Value="#B45309"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Chiều Dài -->
                                    <DataGridTextColumn Header="Dài (m)" Binding="{Binding ChieuDaiHuuDungM, StringFormat={}{0} m}" Width="65" HeaderStyle="{StaticResource DataGridHeaderRight}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Setter Property="FontSize" Value="11"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- Ke Ga -->
                                    <DataGridTemplateColumn Header="Ke Ga" Width="55" HeaderStyle="{StaticResource DataGridHeaderCenter}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="13" Foreground="#15803D"
                                                                   Visibility="{Binding CoKeGa, Converter={StaticResource BoolSymbolConv}, ConverterParameter=VisibilityTrue}"/>
                                                    <TextBlock Text="—" Foreground="#CBD5E1" FontWeight="Bold" HorizontalAlignment="Center"
                                                               Visibility="{Binding CoKeGa, Converter={StaticResource BoolSymbolConv}, ConverterParameter=VisibilityFalse}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- Trạng Thái Ray -->
                                    <DataGridTemplateColumn Header="Trạng Thái" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                                    <Ellipse x:Name="dotStatusRay" Width="7" Height="7" Fill="#16A34A" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="txtStatusRay" Text="Trống" FontSize="10" Foreground="#15803D" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="TRONG">
                                                        <Setter TargetName="dotStatusRay" Property="Fill" Value="#16A34A"/>
                                                        <Setter TargetName="txtStatusRay" Property="Text" Value="Trống"/>
                                                        <Setter TargetName="txtStatusRay" Property="Foreground" Value="#15803D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="CO_TAU">
                                                        <Setter TargetName="dotStatusRay" Property="Fill" Value="#F59E0B"/>
                                                        <Setter TargetName="txtStatusRay" Property="Text" Value="Có tàu"/>
                                                        <Setter TargetName="txtStatusRay" Property="Foreground" Value="#B45309"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="BAO_TRI">
                                                        <Setter TargetName="dotStatusRay" Property="Fill" Value="#EF4444"/>
                                                        <Setter TargetName="txtStatusRay" Property="Text" Value="Bảo trì"/>
                                                        <Setter TargetName="txtStatusRay" Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- 3. Sơ đồ Mặt Bằng & Mini-Form Chi Tiết Đường Ray -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="12,10">
                                <StackPanel>
                                    <!-- A. Sơ Đồ Mặt Bằng Hạ Tầng Ray Trực Quan -->
                                    <Border x:Name="bdSoDoDuongRay" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <ui:SymbolIcon Symbol="Branch24" FontSize="12" Foreground="#003B73" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="SƠ ĐỒ MẶT BẰNG HẠ TẦNG RAY" FontSize="11" FontWeight="Bold" Foreground="#003B73" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <!-- Legend chú giải phân loại màu và trạng thái ray -->
                                            <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,0,8">
                                                <WrapPanel VerticalAlignment="Center">
                                                    <!-- Chính Tuyến -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Border Width="10" Height="4" Background="#003B73" CornerRadius="1" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Chính tuyến" FontSize="9.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <!-- Đường Tránh -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Border Width="10" Height="4" Background="#4338CA" CornerRadius="1" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Đường tránh" FontSize="9.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <!-- Bốc Dỡ -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <Border Width="10" Height="4" Background="#D97706" CornerRadius="1" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Bốc dỡ" FontSize="9.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <!-- Trạng thái -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
                                                        <Ellipse Width="6" Height="6" Fill="#16A34A" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Trống" FontSize="9.5" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <Ellipse Width="6" Height="6" Fill="#F59E0B" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Có tàu" FontSize="9.5" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <Ellipse Width="6" Height="6" Fill="#EF4444" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Bảo trì" FontSize="9.5" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </WrapPanel>
                                            </Border>
                                            <!-- Danh sách thanh ray trực quan -->
                                            <StackPanel x:Name="pnlVisualTracks">
                                                <TextBlock Text="Chọn ga để xem sơ đồ mặt bằng ray" FontSize="10" Foreground="#94A3B8" FontStyle="Italic"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- B. Khung Cấu Hình Chi Tiết Tuyến Ray -->
                                    <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Edit24" FontSize="13" Foreground="#003B73" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="txtTitleFormRay" Text="THÔNG SỐ KỸ THUẬT ĐƯỜNG RAY" FontSize="12" FontWeight="Bold" Foreground="#003B73"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Border x:Name="bdBadgeFormRay" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="2" Padding="6,1" Margin="0,0,6,0">
                                                        <TextBlock x:Name="txtBadgeFormRay" Text="ĐƯỜNG 1" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>
                                                    </Border>
                                                    <Button x:Name="btnXoaRayHeader" Click="BtnXoaRay_Click" Height="24" Padding="6,0" Style="{StaticResource DangerDesktopButton}"
                                                            ToolTip="Xóa đường ray này khỏi ga (yêu cầu xác nhận)">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Delete24" FontSize="11" Foreground="#B91C1C" Margin="0,0,3,0"/>
                                                            <TextBlock Text="Xóa ray" FontSize="10.5" FontWeight="SemiBold" Foreground="#B91C1C"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <!-- Hàng 1: Số hiệu & Chiều dài chia 2 cột -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Cột 1: Số hiệu -->
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="Số Hiệu Ray:" Style="{StaticResource RequiredLabel}"/>
                                                        <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                                    </StackPanel>
                                                    <TextBox x:Name="txtSoHieuRay" MaxLength="2" Height="28" FontSize="12" Text="1" FontWeight="Bold"
                                                             VerticalContentAlignment="Center" ToolTip="Số hiệu đường nguyên dương (1 - 99)"/>
                                                </StackPanel>
                                                <!-- Cột 2: Chiều dài -->
                                                <StackPanel Grid.Column="2">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="Chiều Dài Hữu Dụng (m):" Style="{StaticResource RequiredLabel}"/>
                                                        <TextBlock Text=" *" Foreground="#DC2626" FontWeight="Bold"/>
                                                    </StackPanel>
                                                    <TextBox x:Name="txtChieuDaiRay" MaxLength="6" Height="28" FontSize="12" Text="450" FontWeight="SemiBold"
                                                             VerticalContentAlignment="Center" ToolTip="Chiều dài hữu dụng đường ray (100 - 10,000 m)"
                                                             TextChanged="TxtChieuDaiRay_TextChanged"/>
                                                </StackPanel>
                                            </Grid>
                                            <!-- Hàng 2: Phân loại tác nghiệp -->
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="Phân Loại Tác Nghiệp:" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="cboLoaiDuongRay" Height="28" FontSize="12" SelectionChanged="CboLoaiDuongRay_SelectionChanged">
                                                        <ComboBoxItem Content="Chính Tuyến (Đón/gửi tàu tốc độ cao)" IsSelected="True"/>
                                                        <ComboBoxItem Content="Đường Tránh (Dừng tránh vượt tàu)"/>
                                                        <ComboBoxItem Content="Đường Bốc Dỡ (Xếp dỡ hàng hóa / Dồn toa)"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <!-- Hàng 3: Trạng thái vận hành (ĐÃ GIẤU SẠCH MÃ KỸ THUẬT) -->
                                            <Grid Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="Trạng Thái Vận Hành:" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="cboTrangThaiRay" Height="28" FontSize="12">
                                                        <ComboBoxItem Content="Trống (Sẵn sàng tác nghiệp)" IsSelected="True"/>
                                                        <ComboBoxItem Content="Đang có đoàn tàu chiếm dụng"/>
                                                        <ComboBoxItem Content="Tạm đóng bảo trì kỹ thuật"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                            <!-- Hàng 4: Ke ga (CheckBox trực quan) -->
                                            <Grid Margin="0,2,0,8">
                                                <CheckBox x:Name="chkCoKeGaRay" 
                                                          Content="Có ke ga đón trả khách" 
                                                          FontSize="12" FontWeight="SemiBold" Foreground="#334155"
                                                          VerticalAlignment="Center"/>
                                            </Grid>
                                            <!-- Hàng 5: Hộp thông tin năng lực hữu dụng thông minh -->
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Symbol="Info24" FontSize="13" Foreground="#003B73" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock x:Name="txtNangLucToa" Text="Sức chứa tiếp nhận: ~18 toa xe tiêu chuẩn VNR (25m/toa)" 
                                                                   FontSize="11" FontWeight="SemiBold" Foreground="#003B73"/>
                                                        <TextBlock x:Name="txtGhiChuTacNghiep" Text="Phù hợp đón gửi các đoàn tàu khách Thống Nhất SE1 - SE20" 
                                                                   FontSize="10" Foreground="#64748B"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <!-- Thông tin Audit kiểm toán đường ray compact (1 dòng ngang) -->
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="2" Padding="8,5" Margin="0,8,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Khởi tạo: " FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="txtNguoiTaoRay" Text="admin" FontSize="11" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Width="1" Height="10" Background="#CBD5E1" Margin="6,0"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Cập nhật: " FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                                        <TextBlock x:Name="txtNgayCapNhatRay" Text="Chưa cập nhật" FontSize="11" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- 4. Nút Thao Tác Cấu Hình Đường Ray -->
                            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="14,10">
                                <StackPanel>
                                    <!-- Dòng 1: Lưu ray & Hủy -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="btnLuuRay" Click="BtnLuuRay_Click" 
                                                Style="{StaticResource PrimaryDesktopButton}" Height="32"
                                                ToolTip="Lưu thông tin đường ray">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Save24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="txtLuuRay" Text="Lưu Cấu Hình Ray" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" x:Name="btnHuyRay" Click="BtnHuyRay_Click" 
                                                Style="{StaticResource DesktopButton}" Height="32" Padding="12,0"
                                                ToolTip="Hủy thay đổi ray">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Margin="0,0,4,0" Foreground="#64748B"/>
                                                <TextBlock Text="Hủy" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <!-- Dòng 2: Nút xóa ray ở chân form ẩn đi (đã đưa lên Header an toàn) -->
                                    <Button x:Name="btnXoaRay" Click="BtnXoaRay_Click" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Page>
