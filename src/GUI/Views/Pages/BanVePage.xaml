<Page x:Class="GUI.Views.Pages.BanVePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Hành Khách &amp; Bán Vé">

    <Grid Background="#F8FAFC">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="8" Padding="36,28" MaxWidth="500">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="28" Background="#EEF2FF" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="TicketDiagonal24" FontSize="28" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="PHÂN HỆ HÀNH KHÁCH &amp; BÁN VÉ" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Mô-đun đang trong quá trình phát triển." FontSize="13" Foreground="#64748B" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
