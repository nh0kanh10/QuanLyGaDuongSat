<Page x:Class="GUI.Views.Pages.BanVePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:uc="clr-namespace:GUI.Views.UserControls"
      Title="Quản Lý Vận Tải Hành Khách &amp; Bán Vé"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.ClearTypeHint="Enabled">

    <Grid Margin="10,6,10,6">
        <TabControl x:Name="tabMainBanVe" SelectionChanged="TabMainBanVe_SelectionChanged">
            
            <!-- ================================================================= -->
            <!-- TAB 1: QUẦY BÁN VÉ & ĐẶT CHỖ (POS)                                 -->
            <!-- ================================================================= -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="TicketDiagonal24" FontSize="14" Margin="0,0,6,0" Foreground="#003B73"/>
                        <TextBlock Text="Quầy Bán Vé &amp; Đặt Chỗ (POS)" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="6,6,6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="580"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="380" MinWidth="320" MaxWidth="520"/>
                    </Grid.ColumnDefinitions>

                    <!-- PHÂN VÙNG BÊN TRÁI: HÀNH TRÌNH, TOA GHẾ & LỊCH DỪNG GA (CO GIÃN TOÀN MÀN HÌNH) -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 0. Quy trình bán vé 5 bước (Step Indicator) -->
                            <RowDefinition Height="Auto"/> <!-- 1. Thanh tìm kiếm hành trình, Chặng nhanh & Lọc ẩn -->
                            <RowDefinition Height="*"/>    <!-- 2. Bảng các chuyến tàu chạy (Co giãn theo toàn màn hình) -->
                            <RowDefinition Height="Auto"/> <!-- 3. Sơ đồ Toa xe & Ghế ngồi (Ôm sát nội thất, không thừa thãi) -->
                            <RowDefinition Height="Auto"/> <!-- 4. Lịch trình dừng ga của chuyến tàu (Expander thu gọn tiết kiệm diện tích) -->
                        </Grid.RowDefinitions>

                        <!-- 0. QUY TRÌNH BÁN VÉ 5 BƯỚC (STEP INDICATOR CHUẨN UX - C3) -->
                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Bước 1 -->
                                    <ColumnDefinition Width="*"/>    <!-- Line 1-2 -->
                                    <ColumnDefinition Width="Auto"/> <!-- Bước 2 -->
                                    <ColumnDefinition Width="*"/>    <!-- Line 2-3 -->
                                    <ColumnDefinition Width="Auto"/> <!-- Bước 3 -->
                                    <ColumnDefinition Width="*"/>    <!-- Line 3-4 -->
                                    <ColumnDefinition Width="Auto"/> <!-- Bước 4 -->
                                    <ColumnDefinition Width="*"/>    <!-- Line 4-5 -->
                                    <ColumnDefinition Width="Auto"/> <!-- Bước 5 -->
                                </Grid.ColumnDefinitions>

                                <!-- Bước 1: Chọn Chặng -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="bdStep1Circle" Width="22" Height="22" CornerRadius="11" Background="#003B73" Margin="0,0,6,0">
                                        <ui:SymbolIcon x:Name="iconStep1" Symbol="Search24" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="txtStep1" Text="1. Tìm Chặng" FontSize="11" FontWeight="Bold" Foreground="#003B73" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Connector 1-2 -->
                                <Border Grid.Column="1" x:Name="lineStep12" Height="2" Background="#CBD5E1" Margin="8,0" VerticalAlignment="Center"/>

                                <!-- Bước 2: Chọn Tàu -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="bdStep2Circle" Width="22" Height="22" CornerRadius="11" Background="#E2E8F0" Margin="0,0,6,0">
                                        <ui:SymbolIcon x:Name="iconStep2" Symbol="VehicleSubway24" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="txtStep2" Text="2. Chọn Tàu" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Connector 2-3 -->
                                <Border Grid.Column="3" x:Name="lineStep23" Height="2" Background="#CBD5E1" Margin="8,0" VerticalAlignment="Center"/>

                                <!-- Bước 3: Chọn Ghế -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="bdStep3Circle" Width="22" Height="22" CornerRadius="11" Background="#E2E8F0" Margin="0,0,6,0">
                                        <ui:SymbolIcon x:Name="iconStep3" Symbol="TicketDiagonal24" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="txtStep3" Text="3. Chọn Ghế" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Connector 3-4 -->
                                <Border Grid.Column="5" x:Name="lineStep34" Height="2" Background="#CBD5E1" Margin="8,0" VerticalAlignment="Center"/>

                                <!-- Bước 4: Hành Khách -->
                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="bdStep4Circle" Width="22" Height="22" CornerRadius="11" Background="#E2E8F0" Margin="0,0,6,0">
                                        <ui:SymbolIcon x:Name="iconStep4" Symbol="Person24" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="txtStep4" Text="4. Hành Khách" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Connector 4-5 -->
                                <Border Grid.Column="7" x:Name="lineStep45" Height="2" Background="#CBD5E1" Margin="8,0" VerticalAlignment="Center"/>

                                <!-- Bước 5: Thanh Toán -->
                                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="bdStep5Circle" Width="22" Height="22" CornerRadius="11" Background="#E2E8F0" Margin="0,0,6,0">
                                        <ui:SymbolIcon x:Name="iconStep5" Symbol="Payment24" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="txtStep5" Text="5. Xuất Vé" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 1. THANH TÌM KIẾM HÀNH TRÌNH -->
                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Dòng 1: Tìm kiếm chính -->
                                    <RowDefinition Height="Auto"/> <!-- Dòng 2: Chặng nhanh -->
                                    <RowDefinition Height="Auto"/> <!-- Dòng 3: Bộ lọc nâng cao (Bấm mới hiện) -->
                                </Grid.RowDefinitions>

                                <!-- Dòng 1: Tìm kiếm chính -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Ga Đi:" Style="{StaticResource FieldLabel}"/>
                                    <uc:SearchableComboBox Grid.Column="1" x:Name="cboGaDi" 
                                                           DisplayMemberPath="TenGa" SelectedValuePath="MaGa"
                                                           SubTextMemberPath="LyTrinhKm" Placeholder="Chọn ga đi..."
                                                           SelectionChanged="CboGa_SelectionChanged" Height="28"/>

                                    <TextBlock Grid.Column="3" Text="Ga Đến:" Style="{StaticResource FieldLabel}"/>
                                    <uc:SearchableComboBox Grid.Column="4" x:Name="cboGaDen" 
                                                           DisplayMemberPath="TenGa" SelectedValuePath="MaGa"
                                                           SubTextMemberPath="LyTrinhKm" Placeholder="Chọn ga đến..."
                                                           SelectionChanged="CboGa_SelectionChanged" Height="28"/>

                                    <TextBlock Grid.Column="6" Text="Ngày Đi:" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker Grid.Column="7" x:Name="dpNgayDi" Width="135" Height="28"
                                                SelectedDateFormat="Short" VerticalAlignment="Center"/>

                                    <Button Grid.Column="9" Click="BtnTimChuyen_Click" Style="{StaticResource PrimaryDesktopButton}" MinWidth="150" Height="30">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Search24" FontSize="14" Margin="0,0,6,0"/>
                                            <TextBlock Text="Tìm Chuyến Tàu" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="11" x:Name="btnToggleLoc" Click="BtnToggleLoc_Click" Style="{StaticResource DesktopButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Filter24" FontSize="12" Margin="0,0,4,0" Foreground="#003B73"/>
                                            <TextBlock Text="Bộ Lọc ▾" FontSize="11"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- POPUP BỘ LỌC CHUYÊN SÂU NỔI (PHƯƠNG ÁN B - TIẾT KIỆM 100% DIỆN TÍCH MÀN HÌNH) -->
                                    <Popup x:Name="popBoLocNangCao" PlacementTarget="{Binding ElementName=btnToggleLoc}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.5"
                                                CornerRadius="6" Padding="14,12" Width="290" Margin="0,4,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.2" Color="#0F172A"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <!-- Tiêu đề & Nút đóng -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Filter24" FontSize="14" Foreground="#003B73" Margin="0,0,6,0"/>
                                                        <TextBlock Text="BỘ LỌC CHUYẾN TÀU" FontSize="12" FontWeight="Bold" Foreground="#003B73"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Click="BtnDongLoc_Click" Style="{StaticResource DesktopButton}" Width="24" Height="24" Padding="0" Margin="0" ToolTip="Đóng">
                                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="11"/>
                                                    </Button>
                                                </Grid>

                                                <!-- 1. Chế độ lọc chỗ (Switch Vuông 2 Nhãn Trượt Mượt - Chuẩn POS) -->
                                                <TextBlock Text="Chế độ chuyến tàu:" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Height="30" Margin="0,0,0,10" ClipToBounds="True">
                                                    <Grid x:Name="gridSwitchCheDo" Cursor="Hand" MouseLeftButtonDown="GridSwitchCheDo_Click" SizeChanged="GridSwitchCheDo_SizeChanged">
                                                        <!-- Khối trượt vuông màu Xanh Navy #003B73 -->
                                                        <Border x:Name="bdSwitchIndicator" Height="26" Background="#003B73" CornerRadius="2"
                                                                HorizontalAlignment="Left" Margin="2,2,0,2">
                                                            <Border.RenderTransform>
                                                                <TranslateTransform x:Name="ttSwitchIndicator" X="0"/>
                                                            </Border.RenderTransform>
                                                        </Border>

                                                        <!-- 2 Nhãn đè lên khối trượt để click -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="Transparent" MouseLeftButtonDown="TabTatCa_Click">
                                                                <TextBlock x:Name="txtSwitchTatCa" Text="Tất Cả Chuyến"
                                                                           FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Border Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TabChiConCho_Click">
                                                                <TextBlock x:Name="txtSwitchChiConCho" Text="Chuyến Còn Chỗ"
                                                                           FontSize="11" FontWeight="Normal" Foreground="#64748B"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>

                                                <!-- 2. Giờ đi -->
                                                <TextBlock Text="Khung giờ khởi hành:" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="cboLocGioDi" Height="28" Padding="8,0,22,0" FontSize="11" Margin="0,0,0,8" SelectionChanged="BoLoc_Changed">
                                                    <ComboBoxItem Content="Tất cả giờ đi" IsSelected="True"/>
                                                    <ComboBoxItem Content="Sáng sớm (00h - 06h)"/>
                                                    <ComboBoxItem Content="Buổi sáng (06h - 12h)"/>
                                                    <ComboBoxItem Content="Buổi chiều (12h - 18h)"/>
                                                    <ComboBoxItem Content="Buổi tối (18h - 24h)"/>
                                                </ComboBox>

                                                <!-- 3. Giờ đến -->
                                                <TextBlock Text="Khung giờ đến ga:" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="cboLocGioDen" Height="28" Padding="8,0,22,0" FontSize="11" Margin="0,0,0,8" SelectionChanged="BoLoc_Changed">
                                                    <ComboBoxItem Content="Tất cả giờ đến" IsSelected="True"/>
                                                    <ComboBoxItem Content="Buổi sáng (00h - 12h)"/>
                                                    <ComboBoxItem Content="Buổi chiều (12h - 18h)"/>
                                                    <ComboBoxItem Content="Buổi tối / Đêm (18h - 24h)"/>
                                                </ComboBox>

                                                <!-- 4. Khoảng giá theo toán tử dấu & nhập số linh hoạt -->
                                                <TextBlock Text="Lọc theo khoảng giá vé:" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox Grid.Column="0" x:Name="cboToanTuGia" Height="28" Padding="6,0,20,0" FontSize="11" SelectionChanged="CboToanTuGia_SelectionChanged">
                                                        <ComboBoxItem Content="Tất cả" IsSelected="True" Tag="ALL"/>
                                                        <ComboBoxItem Content="≤ Tối đa" Tag="LTE"/>
                                                        <ComboBoxItem Content="≥ Tối thiểu" Tag="GTE"/>
                                                        <ComboBoxItem Content="Từ ... Đến ..." Tag="BETWEEN"/>
                                                    </ComboBox>
                                                    <ui:TextBox Grid.Column="2" x:Name="txtGiaNhap1" Height="28" FontSize="11"
                                                                PlaceholderText="Nhập mức giá..." VerticalContentAlignment="Center"
                                                                TextChanged="TxtGiaNhap_TextChanged" IsEnabled="False"/>
                                                </Grid>

                                                <!-- Hàng nhập giá thứ 2 (khi chọn khoảng Từ... Đến...) -->
                                                <Grid x:Name="gridGiaDen" Visibility="Collapsed" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Đến mức giá tối đa:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                                    <ui:TextBox Grid.Column="2" x:Name="txtGiaNhap2" Height="28" FontSize="11"
                                                                PlaceholderText="Mức giá trần..." VerticalContentAlignment="Center"
                                                                TextChanged="TxtGiaNhap_TextChanged"/>
                                                </Grid>

                                                <!-- Phím tắt mức giá nhanh 1-chạm -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <TextBlock Text="Nhanh:" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Button Content="300k" Click="BtnChipGia_Click" Tag="300000" Style="{StaticResource DesktopButton}" Height="20" Padding="5,0" FontSize="10" Margin="0,0,4,0"/>
                                                    <Button Content="500k" Click="BtnChipGia_Click" Tag="500000" Style="{StaticResource DesktopButton}" Height="20" Padding="5,0" FontSize="10" Margin="0,0,4,0"/>
                                                    <Button Content="1.000k" Click="BtnChipGia_Click" Tag="1000000" Style="{StaticResource DesktopButton}" Height="20" Padding="5,0" FontSize="10" Margin="0,0,4,0"/>
                                                    <Button Content="1.500k" Click="BtnChipGia_Click" Tag="1500000" Style="{StaticResource DesktopButton}" Height="20" Padding="5,0" FontSize="10" Margin="0,0,4,0"/>
                                                </StackPanel>

                                                <!-- 5. Mác tàu -->
                                                <TextBlock Text="Số hiệu mác tàu:" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                                <ui:TextBox x:Name="txtLocMacTau" Height="28" FontSize="11"
                                                            PlaceholderText="VD: SE1, TN1, SPT2..."
                                                            VerticalContentAlignment="Center"
                                                            TextChanged="TxtLocMacTau_TextChanged"
                                                            Margin="0,0,0,12"/>

                                                <!-- Footer nút bấm -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Click="BtnResetLoc_Click" Style="{StaticResource DesktopButton}" Height="28" Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="ArrowReset24" FontSize="11" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Đặt Lại"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1" Click="BtnDongLoc_Click" Style="{StaticResource PrimaryDesktopButton}" Height="28" Padding="14,0">
                                                        <TextBlock Text="Áp Dụng"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <!-- Dòng 2: Quick Chips chặng kinh điển -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Chặng nhanh:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Click="BtnQuickRoute_Click" Tag="HN-SG" Style="{StaticResource DesktopButton}" Content="Hà Nội - Sài Gòn" Height="22" Padding="8,0" FontSize="10"/>
                                    <Button Click="BtnQuickRoute_Click" Tag="HN-VIN" Style="{StaticResource DesktopButton}" Content="Hà Nội - Vinh" Height="22" Padding="8,0" FontSize="10"/>
                                    <Button Click="BtnQuickRoute_Click" Tag="HN-DNA" Style="{StaticResource DesktopButton}" Content="Hà Nội - Đà Nẵng" Height="22" Padding="8,0" FontSize="10"/>
                                    <Button Click="BtnQuickRoute_Click" Tag="SG-NTR" Style="{StaticResource DesktopButton}" Content="Sài Gòn - Nha Trang" Height="22" Padding="8,0" FontSize="10"/>
                                    <Button Click="BtnQuickRoute_Click" Tag="SG-DNA" Style="{StaticResource DesktopButton}" Content="Sài Gòn - Đà Nẵng" Height="22" Padding="8,0" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. BẢNG DANH SÁCH CHUYẾN TÀU KHẢ DỤNG (CO GIÃN THEO MÀN HÌNH) -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6">
                            <DataGrid x:Name="dgChuyenTau" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" CanUserAddRows="False" MinHeight="115"
                                      SelectionChanged="DgChuyenTau_SelectionChanged"
                                      BorderThickness="0"
                                      HeadersVisibility="Column"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <!-- Mác Tàu -->
                                    <DataGridTemplateColumn Header="Mác Tàu" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding SoHieuMacTau}" FontWeight="Bold" FontSize="12.5" Foreground="#003B73"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Loại Tàu -->
                                    <DataGridTextColumn Header="Loại Tàu" Binding="{Binding TenLoaiTau}" Width="105">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="11.5"/>
                                                <Setter Property="Foreground" Value="#475569"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Khởi Hành -->
                                    <DataGridTextColumn Header="Khởi Hành" Binding="{Binding GioXuatPhatKH, StringFormat=HH:mm}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#15803D"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Đến Ga -->
                                    <DataGridTextColumn Header="Đến Ga" Binding="{Binding GioVeDichKH, StringFormat=HH:mm}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Lộ Trình Chạy (Co giãn cân đối *) -->
                                    <DataGridTemplateColumn Header="Lộ Trình Chạy" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                    <TextBlock Text="{Binding TenGaXuatPhat}" FontWeight="SemiBold" FontSize="12" Foreground="#003B73"/>
                                                    <TextBlock Text=" ➔ " FontSize="10" Foreground="#94A3B8" Margin="4,0"/>
                                                    <TextBlock Text="{Binding TenGaKetThuc}" FontWeight="SemiBold" FontSize="12" Foreground="#003B73"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Thời Gian Chạy -->
                                    <DataGridTextColumn Header="Hành Trình" Binding="{Binding ThoiGianChay}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="Foreground" Value="#64748B"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Số Toa -->
                                    <DataGridTextColumn Header="Số Toa" Binding="{Binding SoToaXe, StringFormat='{}{0} toa'}" Width="75">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="11.5"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- A2: CỘT CHỖ TRỐNG HIỂN THỊ BADGE MÀU VÀ ICON CHUẨN UX (KHÔNG EMOJI) -->
                                    <DataGridTemplateColumn Header="Chỗ Trống" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding SoChoConLai, Converter={StaticResource ChoTrongBadgeConv}, ConverterParameter=BgColor}"
                                                        BorderBrush="{Binding SoChoConLai, Converter={StaticResource ChoTrongBadgeConv}, ConverterParameter=BorderColor}"
                                                        BorderThickness="1" CornerRadius="10" Padding="8,2"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="{Binding SoChoConLai, Converter={StaticResource ChoTrongBadgeConv}, ConverterParameter=Icon}"
                                                                       FontSize="11" Margin="0,0,4,0"
                                                                       Foreground="{Binding SoChoConLai, Converter={StaticResource ChoTrongBadgeConv}, ConverterParameter=TextColor}"/>
                                                        <TextBlock Text="{Binding SoChoConLai, Converter={StaticResource ChoTrongBadgeConv}, ConverterParameter=Text}"
                                                                   FontSize="10.5" FontWeight="Bold"
                                                                   Foreground="{Binding SoChoConLai, Converter={StaticResource ChoTrongBadgeConv}, ConverterParameter=TextColor}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Giá vé cơ sở -->
                                    <DataGridTextColumn Header="Giá Từ (VNĐ)" Binding="{Binding GiaVeCoSo, StringFormat={}{0:N0}}" Width="115">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#0F172A"/>
                                                <Setter Property="Margin" Value="0,0,8,0"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- 3. SƠ ĐỒ TOA XE & GHẾ NGỒI CHUẨN DSVN -->
                        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#003B73" BorderThickness="1.5" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Thanh chọn Toa xe -->
                                    <RowDefinition Height="Auto"/> <!-- Chú thích trạng thái -->
                                    <RowDefinition Height="Auto"/> <!-- Sơ đồ ghế/khoang -->
                                </Grid.RowDefinitions>

                                <!-- 3.1. Dải Chọn Toa Xe & Khung Vừa Tìm Vừa Chọn Toa (+) -->
                                <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/> <!-- Nhãn Đoàn Tàu -->
                                            <ColumnDefinition Width="Auto"/> <!-- Nút Cuộn ◄ -->
                                            <ColumnDefinition Width="*"/>    <!-- ScrollViewer danh sách toa (ẩn scroll ngang) -->
                                            <ColumnDefinition Width="Auto"/> <!-- Nút Cuộn ► -->
                                            <ColumnDefinition Width="Auto"/> <!-- Nút [+] Mở khung Vừa Tìm Vừa Chọn -->
                                            <ColumnDefinition Width="Auto"/> <!-- Tiêu đề Toa đang chọn -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Nhãn Đoàn Tàu -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <ui:SymbolIcon Symbol="VehicleSubway24" FontSize="15" Foreground="#003B73" Margin="0,0,5,0"/>
                                            <TextBlock Text="Đoàn Tàu:" FontWeight="Bold" FontSize="11" Foreground="#003B73" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Nút Cuộn ◄ -->
                                        <Button Grid.Column="1" x:Name="btnCuonToaTrai" Click="BtnCuonToaTrai_Click" 
                                                Width="22" Height="26" Padding="0" Margin="0,0,4,0" 
                                                Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"
                                                ToolTip="Cuộn về phía các toa trước">
                                            <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="11" Foreground="#003B73"/>
                                        </Button>

                                        <!-- Dải Toa Xe (ẨN HOÀN TOÀN THANH CUỘN NGANG XẤU, hỗ trợ lăn bánh xe chuột) -->
                                        <ScrollViewer Grid.Column="2" x:Name="svToaXe" 
                                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                                      PreviewMouseWheel="SvToaXe_PreviewMouseWheel">
                                            <StackPanel x:Name="spToaXe" Orientation="Horizontal"/>
                                        </ScrollViewer>

                                        <!-- Nút Cuộn ► -->
                                        <Button Grid.Column="3" x:Name="btnCuonToaPhai" Click="BtnCuonToaPhai_Click" 
                                                Width="22" Height="26" Padding="0" Margin="4,0,8,0" 
                                                Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"
                                                ToolTip="Cuộn về phía các toa sau">
                                            <ui:SymbolIcon Symbol="ChevronRight24" FontSize="11" Foreground="#003B73"/>
                                        </Button>

                                        <!-- Nút [+] Mở danh sách toàn bộ Toa xe -->
                                        <Border Grid.Column="4" x:Name="btnMoKhungTimToa" Margin="0,0,8,0" 
                                                Background="#003B73" CornerRadius="4" Padding="8,4" 
                                                Cursor="Hand" PreviewMouseLeftButtonUp="BtnMoKhungTimToa_Click"
                                                ToolTip="Xem danh sách toàn bộ toa xe">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Add24" FontSize="13" Foreground="White" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="txtNhanNutTimToa" Text="Toa (+)" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Tiêu đề Toa đang chọn -->
                                        <TextBlock Grid.Column="5" x:Name="txtTieuDeToaHienTai" Text="Toa: Đang chọn..." 
                                                   FontWeight="Bold" FontSize="11" Foreground="#003B73" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- POPUP VỪA TÌM VỪA CHỌN TOA (DÀNH CHO ĐOÀN TÀU 11 - 15 TOA) -->
                                <Popup x:Name="popTimChonToa" 
                                       PlacementTarget="{Binding ElementName=btnMoKhungTimToa}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       VerticalOffset="4"
                                       Opened="PopTimChonToa_Opened"
                                       Closed="PopTimChonToa_Closed">
                                    <Border Width="380" MaxHeight="450" Background="#FFFFFF" BorderBrush="#CBD5E1" 
                                            BorderThickness="1" CornerRadius="8" Padding="0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18" Color="#0F172A"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/> <!-- Header -->
                                                <RowDefinition Height="Auto"/> <!-- Search & Quick Filter Chips -->
                                                <RowDefinition Height="*"/>    <!-- Danh sách Toa cuộn dọc -->
                                                <RowDefinition Height="Auto"/> <!-- Footer tóm tắt -->
                                            </Grid.RowDefinitions>

                                            <!-- 1. Header -->
                                            <Border Grid.Row="0" Background="#003B73" CornerRadius="7,7,0,0" Padding="12,10">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="VehicleSubway24" FontSize="15" Foreground="White" Margin="0,0,8,0"/>
                                                        <TextBlock x:Name="txtTieuDePopupToa" Text="DANH SÁCH BIÊN CHẾ TOA TÀU" 
                                                                   FontWeight="Bold" FontSize="12" Foreground="White"/>
                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right" Background="Transparent" Cursor="Hand" 
                                                            PreviewMouseLeftButtonUp="BtnDongPopupToa_Click" Padding="4">
                                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="13" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- 2. Search & Filter -->
                                            <StackPanel Grid.Row="1" Margin="10,10,10,6">
                                                <!-- Search Box -->
                                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="13" Foreground="#64748B" Margin="0,0,6,0"/>
                                                        <TextBox Grid.Column="1" x:Name="txtTimToa" BorderThickness="0" Background="Transparent" 
                                                                 FontSize="12" Padding="0" VerticalAlignment="Center"
                                                                 TextChanged="TxtTimToa_TextChanged"/>
                                                        <TextBlock Grid.Column="1" x:Name="txtTimToaPlaceholder" Text="Tìm số toa, loại chỗ (VIP, K4, K6, Ngồi mềm)..." 
                                                                   FontSize="12" Foreground="#94A3B8" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                                        <ui:SymbolIcon Grid.Column="2" x:Name="btnClearTimToa" Symbol="DismissCircle24" FontSize="12" 
                                                                       Foreground="#94A3B8" Cursor="Hand" Visibility="Collapsed"
                                                                       PreviewMouseLeftButtonUp="BtnClearTimToa_Click"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Quick Filter Chips -->
                                                <StackPanel Orientation="Horizontal">
                                                    <Border x:Name="chipLocTatCa" Padding="6,2" Margin="0,0,4,0" Background="#003B73" BorderBrush="#003B73" BorderThickness="1" CornerRadius="10" Cursor="Hand" Tag="ALL" PreviewMouseLeftButtonUp="ChipLoc_Click">
                                                        <TextBlock Text="Tất cả" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>
                                                    <Border x:Name="chipLocK4" Padding="6,2" Margin="0,0,4,0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Cursor="Hand" Tag="AN" PreviewMouseLeftButtonUp="ChipLoc_Click">
                                                        <TextBlock Text="Nằm VIP K4" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                                                    </Border>
                                                    <Border x:Name="chipLocK6" Padding="6,2" Margin="0,0,4,0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Cursor="Hand" Tag="BN" PreviewMouseLeftButtonUp="ChipLoc_Click">
                                                        <TextBlock Text="Nằm K6" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                                                    </Border>
                                                    <Border x:Name="chipLocNM" Padding="6,2" Margin="0,0,4,0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Cursor="Hand" Tag="NML" PreviewMouseLeftButtonUp="ChipLoc_Click">
                                                        <TextBlock Text="Ngồi mềm" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                                                    </Border>
                                                    <Border x:Name="chipLocConCho" Padding="6,2" Margin="0,0,4,0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Cursor="Hand" Tag="CON_CHO" PreviewMouseLeftButtonUp="ChipLoc_Click">
                                                        <TextBlock Text="Còn chỗ" FontSize="10" FontWeight="SemiBold" Foreground="#475569"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 3. Danh sách Toa cuộn dọc -->
                                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" 
                                                          MaxHeight="260" Margin="10,0,10,6">
                                                <StackPanel x:Name="spDanhSachToaPopup"/>
                                            </ScrollViewer>

                                            <!-- 4. Footer -->
                                            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" 
                                                    CornerRadius="0,0,7,7" Padding="10,6">
                                                <Grid>
                                                    <TextBlock x:Name="txtPopupTongSoToa" Text="Biên chế đoàn tàu" 
                                                               FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    <TextBlock Text="* Bấm vào toa để chuyển sơ đồ ghế" 
                                                               FontSize="10" FontStyle="Italic" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Popup>

                                <!-- 3.2. Bảng Chú Thích Trạng Thái Chỗ Chuẩn DSVN -->
                                <Grid Grid.Row="1" Margin="2,0,2,4">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Border Width="12" Height="12" Background="#FFFFFF" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="2" Margin="0,0,4,0"/>
                                        <TextBlock Text="Ghế Trống" FontSize="10" FontWeight="SemiBold" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                        <Border Width="12" Height="12" Background="#EA580C" BorderBrush="#C2410C" BorderThickness="1.5" CornerRadius="2" Margin="0,0,4,0"/>
                                        <TextBlock Text="Đang Chọn Đặt" FontSize="10" FontWeight="SemiBold" Foreground="#EA580C" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                        <Border Width="12" Height="12" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Margin="0,0,4,0"/>
                                        <TextBlock Text="Đã Bán / Khóa" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="* Cuộn ngang để xem hết chiều dài toa" FontSize="10" FontStyle="Italic" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 3.3. VÙNG HIỂN THỊ CÁC KHOANG / GHẾ NGỒI (B5 - EMPTY STATE + SƠ ĐỒ THỰC TẾ) -->
                                <Grid Grid.Row="2">
                                    <!-- Empty State khi chưa chọn đoàn tàu hoặc toa xe (B5) -->
                                    <Border x:Name="bdEmptySoDo" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="20,16" Margin="4,2">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="VehicleSubway24" FontSize="32" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="Chưa chọn chuyến tàu hoặc toa xe" FontSize="12" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Vui lòng bấm chọn một chuyến tàu từ danh sách phía trên để xem sơ đồ toa và chọn chỗ ngồi." 
                                                       FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sơ đồ ghế thực tế -->
                                    <ScrollViewer x:Name="svSoDoToa" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="#F8FAFC" Visibility="Collapsed">
                                        <Border Margin="4,2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid x:Name="gridNoiThatToa" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 4. LỊCH TRÌNH DỪNG GA CỦA CHUYẾN TÀU (EXPANDER THU GỌN TIẾT KIỆM DIỆN TÍCH) -->
                        <Expander Grid.Row="4" Header="THỜI KHÓA BIỂU &amp; LỊCH TRÌNH DỪNG GA CỦA CHUYẾN TÀU (BẤM ĐỂ MỞ)"
                                  IsExpanded="False" Margin="0,4,0,0" Background="#F8FAFC" BorderBrush="#CBD5E1">
                            <DataGrid x:Name="dgLichDungGa" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" CanUserAddRows="False" MaxHeight="200"
                                      BorderThickness="0" Margin="0,4,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STT" Binding="{Binding ThuTuDung}" Width="50">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Ga Dừng" Binding="{Binding TenGa}" Width="150">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#003B73"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Lý Trình (Km)" Binding="{Binding LyTrinhKm, StringFormat={}{0:N1} km}" Width="105">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Giờ Đến" Binding="{Binding GioDenKeHoach, StringFormat=HH:mm}" Width="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Giờ Đi" Binding="{Binding GioDiKeHoach, StringFormat=HH:mm}" Width="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#003B73"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Thời Gian Đỗ" Binding="{Binding ThoiGianDungPhut, StringFormat={}{0} phút}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Điểm Tránh Tàu" SortMemberPath="LaDiemTranh" Width="110" HeaderStyle="{StaticResource DataGridHeaderCenter}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding LaDiemTranh, Converter={StaticResource BoolSymbolConv}, ConverterParameter=VisibilityTrue}">
                                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="#15803D" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Có" FontSize="11" FontWeight="SemiBold" Foreground="#15803D" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="—" Foreground="#CBD5E1" FontWeight="Bold" HorizontalAlignment="Center"
                                                               Visibility="{Binding LaDiemTranh, Converter={StaticResource BoolSymbolConv}, ConverterParameter=VisibilityFalse}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </Grid>

                    <!-- THANH KÉO CO GIÃN RESPONSIVE GIỮA 2 CỘT (C2) -->
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  Background="#E2E8F0" ShowsPreview="True" Cursor="SizeWE"/>

                    <!-- PHÂN VÙNG BÊN PHẢI: GIỎ VÉ & THANH TOÁN (RESPONSIVE) -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>    <!-- Giỏ vé đang đặt (co giãn theo chiều cao) -->
                            <RowDefinition Height="Auto"/> <!-- Người mua & Thanh toán (gọn gàng ở đáy) -->
                        </Grid.RowDefinitions>

                        <!-- KHUNG GIỎ VÉ -->
                        <GroupBox Grid.Row="0" Margin="0,0,0,6">
                            <GroupBox.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Luggage24" FontSize="14" Foreground="#003B73" Margin="0,0,6,0"/>
                                        <TextBlock Text="GIỎ VÉ ĐANG ĐẶT" FontWeight="Bold"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="txtSoLuongGioVe" Text="0 vé" FontWeight="Bold" FontSize="11" Foreground="#0284C7"/>
                                    </Border>
                                </Grid>
                            </GroupBox.Header>

                            <Grid>
                                <!-- Trạng thái rỗng (Empty State) -->
                                <Border x:Name="bdEmptyGioVe" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" 
                                        CornerRadius="6" Margin="6" Padding="14">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="TicketDiagonal24" FontSize="36" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="Giỏ vé đang trống" FontSize="12" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Vui lòng bấm chọn ghế trống (màu xanh) trên sơ đồ toa tàu bên trái để tiến hành đặt vé." 
                                                   FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Danh sách thẻ vé khi có dữ liệu -->
                                <ScrollViewer x:Name="svGioVeList" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                                    <StackPanel x:Name="spGioVe" Margin="2"/>
                                </ScrollViewer>
                            </Grid>
                        </GroupBox>

                        <!-- KHUNG THÔNG TIN NGƯỜI MUA & THANH TOÁN -->
                        <GroupBox Grid.Row="1" Header="NGƯỜI MUA &amp; THANH TOÁN">
                            <Grid Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Booker -->
                                    <RowDefinition Height="Auto"/> <!-- Bảng tính tiền -->
                                    <RowDefinition Height="Auto"/> <!-- Hình thức TT -->
                                    <RowDefinition Height="Auto"/> <!-- VietQR Box -->
                                    <RowDefinition Height="Auto"/> <!-- Nút hành động -->
                                </Grid.RowDefinitions>

                                <!-- Người mua -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Họ Tên -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <ui:SymbolIcon Symbol="Person24" FontSize="11" Foreground="#003B73" Margin="0,0,4,0"/>
                                            <TextBlock Text="Họ Tên Khách:" Style="{StaticResource FieldLabel}" Margin="0"/>
                                        </StackPanel>
                                        <TextBox x:Name="txtNguoiMuaTen" FontWeight="SemiBold" Height="28"/>
                                        <TextBlock x:Name="lblErrNguoiMuaTen" Foreground="#DC2626" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                    </StackPanel>

                                    <!-- SĐT -->
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <ui:SymbolIcon Symbol="Phone24" FontSize="11" Foreground="#003B73" Margin="0,0,4,0"/>
                                            <TextBlock Text="Số ĐT:" Style="{StaticResource FieldLabel}" Margin="0"/>
                                        </StackPanel>
                                        <TextBox x:Name="txtNguoiMuaSdt" FontFamily="Consolas" Height="28"/>
                                        <TextBlock x:Name="lblErrNguoiMuaSdt" Foreground="#DC2626" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Bảng tính tiền (THỰC THU DARK POS TERMINAL EMERALD) -->
                                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,3">
                                            <TextBlock Text="Tổng Tiền Cước Gốc:" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock x:Name="txtTongTienGoc" Text="0 VNĐ" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,0,0,3">
                                            <TextBlock Text="Chiết Khấu Đối Tượng:" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock x:Name="txtTongGiamGia" Text="0 VNĐ" FontSize="11" FontWeight="SemiBold" Foreground="#B91C1C" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!-- DÒNG THỰC THU XANH LỤC BẢO ĐẬM CHUẨN POS NGÂN HÀNG (0% PASTEL) -->
                                        <Border Grid.Row="2" Background="#064E3B" BorderBrush="#047857" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,0,0">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="Money24" FontSize="15" Foreground="#34D399" Margin="0,0,6,0"/>
                                                    <TextBlock Text="THỰC THU:" FontSize="12" FontWeight="Bold" Foreground="#A7F3D0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="txtThucThu" Text="0 VNĐ" FontSize="20" FontWeight="ExtraBold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Hình thức thanh toán -->
                                <Grid Grid.Row="2" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Hình Thức TT:" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Grid.Column="1" x:Name="cboHinhThucTT" SelectionChanged="CboHinhThucTT_SelectionChanged">
                                        <ComboBoxItem Tag="TIEN_MAT" Content="Tiền Mặt" IsSelected="True"/>
                                        <ComboBoxItem Tag="CHUYEN_KHOAN" Content="Chuyển Khoản / VietQR"/>
                                        <ComboBoxItem Tag="THE_NGAN_HANG" Content="Thẻ POS Ngân Hàng"/>
                                        <ComboBoxItem Tag="VI_DIEN_TU" Content="Ví Điện Tử"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Khung VietQR -->
                                <Border Grid.Row="3" x:Name="bdVietQrBox" Visibility="Collapsed" Background="#FFFFFF" 
                                        BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image x:Name="imgVietQrPos" Width="65" Height="65" Grid.Column="0"/>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="QUÉT MÃ VIETQR THANH TOÁN" FontSize="10" FontWeight="Bold" Foreground="#003B73"/>
                                            <TextBlock Text="Tổng Công Ty ĐSVN" FontSize="9" Foreground="#64748B"/>
                                            <TextBlock x:Name="txtVietQrNoiDung" Text="Nội dung: VNR TICKET" FontSize="9" FontFamily="Consolas" Foreground="#0284C7" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Nút hành động (A3 - CTA NỔI BẬT) -->
                                <Border Grid.Row="4" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Click="BtnThanhToan_Click" Style="{StaticResource PrimaryDesktopButton}" Height="42" Margin="0,0,6,0"
                                                ToolTip="Xác nhận thanh toán và xuất thẻ lên tàu điện tử (F12)">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Margin="0,0,8,0"/>
                                                <TextBlock Text="XUẤT VÉ &amp; IN THẺ (F12)" FontSize="13" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Click="BtnXoaGio_Click" Style="{StaticResource DesktopButton}" Height="42" Width="42" ToolTip="Xóa toàn bộ vé trong giỏ">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="16" Foreground="#B91C1C"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- B4: TOAST NOTIFICATION CONTAINER CHO QUẦY POS (KHÔNG EMOJI) -->
                    <Border x:Name="toastNotification" Grid.ColumnSpan="3"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,12,0,0" CornerRadius="6" Padding="16,10"
                            Background="#0F172A" BorderBrush="#334155" BorderThickness="1"
                            Visibility="Collapsed" Panel.ZIndex="1000">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.3" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon x:Name="toastIcon" Symbol="CheckmarkCircle24" FontSize="18" Foreground="#22C55E" Margin="0,0,10,0"/>
                            <TextBlock x:Name="toastMessage" Text="Thao tác thành công!" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 5. LOADING OVERLAY CHO TAB 1 -->
                    <Border x:Name="loadingOverlay" Grid.ColumnSpan="3"
                            Background="#66000000" Visibility="Collapsed"
                            Panel.ZIndex="999">
                        <Border Background="#FFFFFF" CornerRadius="8" Padding="24,18"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                BorderBrush="#CBD5E1" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,12" Foreground="#003B73"/>
                                <TextBlock x:Name="txtLoadingText" Text="Đang tải dữ liệu..." 
                                           FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================================================================= -->
            <!-- TAB 2: SỔ TRA CỨU, IN & ĐỔI TRẢ VÉ (MASTER-DETAIL)                 -->
            <!-- ================================================================= -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Search24" FontSize="14" Margin="0,0,6,0" Foreground="#0284C7"/>
                        <TextBlock Text="Sổ Tra Cứu &amp; Đổi Trả Vé" FontWeight="SemiBold"/>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="6,6,6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="600"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="380" MinWidth="320" MaxWidth="520"/>
                    </Grid.ColumnDefinitions>

                    <!-- CỘT TRÁI: TÌM KIẾM, BỘ LỌC, BẢNG VÉ & PHÂN TRANG -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Row 0: Search bar + Actions -->
                            <RowDefinition Height="Auto"/> <!-- Row 1: Advanced Filters -->
                            <RowDefinition Height="*"/>    <!-- Row 2: DataGrid dgVe -->
                            <RowDefinition Height="Auto"/> <!-- Row 3: PaginationControl -->
                            <RowDefinition Height="Auto"/> <!-- Row 4: Bottom Action Bar -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: Search bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Tra Cứu Vé:" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                <ui:TextBox x:Name="txtTimKiemVe" Width="260" Height="28" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,6,0"
                                            PlaceholderText="Nhập Mã vé, PNR, CCCD, Họ tên, Mác tàu..."
                                            KeyDown="TxtTimKiemVe_KeyDown"
                                            ToolTip="Nhập Mã vé, Mã PNR, CCCD, Họ tên, Mác tàu để tra cứu"/>
                                <Button Click="BtnTimKiemVe_Click" Style="{StaticResource DesktopButton}" Margin="0,0,6,0" Height="28" Padding="10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Search24" FontSize="13" Margin="0,0,4,0"/>
                                        <TextBlock Text="Tìm (Enter)"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnTraCuuTheoCccd_Click" Style="{StaticResource DesktopButton}" Margin="0,0,6,0" Height="28" Padding="10,0"
                                        ToolTip="Tra cứu nhanh toàn bộ lịch sử vé mua theo CCCD người mua hoặc hành khách">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="PersonSearch24" FontSize="13" Margin="0,0,4,0" Foreground="#0284C7"/>
                                        <TextBlock Text="Lịch Sử Khách"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnNapLaiDanhSach_Click" Style="{StaticResource DesktopButton}" Margin="0,0,6,0" Height="28" Padding="10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Margin="0,0,4,0"/>
                                        <TextBlock Text="Nạp Lại (F5)"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnXuatExcelVe_Click" Style="{StaticResource DesktopButton}" Height="28" Padding="10,0"
                                        ToolTip="Xuất danh sách vé hiện tại ra tệp Excel (.xlsx)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DocumentTable24" FontSize="13" Margin="0,0,4,0" Foreground="#15803D"/>
                                        <TextBlock Text="Xuất Excel (F6)"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="BtnBaoCaoDoanhThu_Click" Style="{StaticResource DesktopButton}" Margin="6,0,0,0" Height="28" Padding="10,0"
                                        ToolTip="Mở bảng tổng hợp &amp; báo cáo doanh thu bán vé đường sắt">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DataPie24" FontSize="13" Margin="0,0,4,0" Foreground="#003B73"/>
                                        <TextBlock Text="Báo Cáo Doanh Thu"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Column="1" x:Name="txtTongSoVePhatHanh" Text="Tổng số: 0 vé" FontSize="11" FontWeight="Bold" Foreground="#003B73" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Row 1: Advanced Filters -->
                        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,6">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                                    <TextBlock Text="Trạng thái:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="cboLocTrangThaiVe" Width="120" Height="26" FontSize="11" VerticalContentAlignment="Center"
                                              SelectionChanged="CboLocTrangThaiVe_SelectionChanged">
                                        <ComboBoxItem Content="-- Tất cả --" IsSelected="True"/>
                                        <ComboBoxItem Content="Đã Đặt"/>
                                        <ComboBoxItem Content="Đã Lên Tàu"/>
                                        <ComboBoxItem Content="Đã Hoàn Vé"/>
                                        <ComboBoxItem Content="Đã Hủy"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                                    <TextBlock Text="Từ ngày:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <DatePicker x:Name="dpLocTuNgay" Width="105" Height="26" FontSize="11" SelectedDateChanged="DpLocNgay_SelectedDateChanged"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                                    <TextBlock Text="Đến ngày:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <DatePicker x:Name="dpLocDenNgay" Width="105" Height="26" FontSize="11" SelectedDateChanged="DpLocNgay_SelectedDateChanged"/>
                                </StackPanel>

                                <Button Click="BtnXoaBoLoc_Click" Style="{StaticResource DesktopButton}" Height="26" Padding="8,0" Margin="0,2,0,2"
                                        ToolTip="Xóa tất cả bộ lọc ngày và trạng thái để hiển thị toàn bộ">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Margin="0,0,3,0" Foreground="#B91C1C"/>
                                        <TextBlock Text="Xóa Lọc" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Border>

                        <!-- Row 2: DataGrid dgVe with ContextMenu and DoubleClick -->
                        <DataGrid Grid.Row="2" x:Name="dgVe" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" CanUserAddRows="False"
                                  SelectionChanged="DgVe_SelectionChanged"
                                  MouseDoubleClick="DgVe_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Xem Chi Tiết Vé (F4)" Click="CtxXemChiTiet_Click">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Eye24" Foreground="#0284C7"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="In Lại Thẻ Lên Tàu (F8)" Click="BtnInTheLenTauTab2_Click">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Print24" Foreground="#003B73"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Sao Chép Mã PNR" Click="CtxSaoChepPNR_Click">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Copy24"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Sao Chép Mã Vé" Click="CtxSaoChepMaVe_Click">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Copy24"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Xem Tất Cả Vé Của Khách Này" Click="CtxXemVeCungKhach_Click">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="PersonSearch24" Foreground="#0284C7"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Đổi Ghế Cùng Chuyến" Click="BtnDoiGheTab2_Click">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="ArrowRepeatAll24" Foreground="#D97706"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Làm Thủ Tục Hoàn Trả Vé" Click="BtnHoanVeTab2_Click">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="ArrowUndo24" Foreground="#B91C1C"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding MaVe}" Width="45"/>
                                <DataGridTextColumn Header="Mã Vé Điện Tử" Binding="{Binding MaVeCode}" Width="145">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#003B73"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Mã PNR" Binding="{Binding MaPNR}" Width="105">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#0284C7"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Mác Tàu" Binding="{Binding SoHieuMacTau}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Ga Đi" Binding="{Binding TenGaDi}" Width="100"/>
                                <DataGridTextColumn Header="Ga Đến" Binding="{Binding TenGaDen}" Width="100"/>
                                <DataGridTextColumn Header="Tên Hành Khách" Binding="{Binding TenHanhKhach}" Width="135"/>
                                <DataGridTextColumn Header="Số CCCD" Binding="{Binding CCCDHanhKhach}" Width="105">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Toa" Binding="{Binding NhanHieuToa}" Width="60"/>
                                <DataGridTextColumn Header="Ghế" Binding="{Binding SoGhe}" Width="50">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Thực Thu (VNĐ)" Binding="{Binding GiaVeThucThu, StringFormat={}{0:N0}}" Width="105">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#003B73"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Trạng Thái" SortMemberPath="TrangThai" Width="120" HeaderStyle="{StaticResource DataGridHeaderCenter}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding TrangThai, Converter={StaticResource TrangThaiVeConv}, ConverterParameter=BgColor}"
                                                    BorderBrush="{Binding TrangThai, Converter={StaticResource TrangThaiVeConv}, ConverterParameter=BorderColor}"
                                                    BorderThickness="1" CornerRadius="12" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Symbol="{Binding TrangThai, Converter={StaticResource TrangThaiVeConv}, ConverterParameter=Icon}" 
                                                                   FontSize="12" 
                                                                   Foreground="{Binding TrangThai, Converter={StaticResource TrangThaiVeConv}, ConverterParameter=Color}"
                                                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TrangThai, Converter={StaticResource TrangThaiVeConv}, ConverterParameter=Text}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding TrangThai, Converter={StaticResource TrangThaiVeConv}, ConverterParameter=Color}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Thời Gian Mua" Binding="{Binding ThoiDiemXuatVe, StringFormat=dd/MM/yyyy HH:mm}" Width="125"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Row 3: PaginationControl -->
                        <uc:PaginationControl x:Name="pagerVe" Grid.Row="3" Margin="0,4,0,0"
                                              PageChanged="PagerVe_PageChanged"
                                              PageSizeChanged="PagerVe_PageSizeChanged"/>

                        <!-- Row 4: Bottom Action Bar -->
                        <Border Grid.Row="4" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Click="BtnInTheLenTauTab2_Click" Style="{StaticResource PrimaryDesktopButton}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Print24" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="In Thẻ Lên Tàu (F8)"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="BtnDoiGheTab2_Click" Style="{StaticResource DesktopButton}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="14" Margin="0,0,6,0" Foreground="#D97706"/>
                                        <TextBlock Text="Đổi Ghế Cùng Chuyến" Foreground="#D97706"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="BtnHoanVeTab2_Click" Style="{StaticResource DesktopButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="14" Margin="0,0,6,0" Foreground="#B91C1C"/>
                                        <TextBlock Text="Làm Thủ Tục Hoàn Vé" Foreground="#B91C1C"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- CỘT 1: SPLITTER -->
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#E2E8F0"/>

                    <!-- CỘT 2: PANEL CHI TIẾT VÉ & QR CODE (MASTER-DETAIL) -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <Grid>
                            <!-- Empty State khi chưa chọn vé -->
                            <StackPanel x:Name="pnlChiTietVeTrong" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                                <ui:SymbolIcon Symbol="TicketDiagonal24" FontSize="48" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="CHƯA CHỌN VÉ TRA CỨU" FontSize="13" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Chọn một vé trên danh sách bên trái hoặc click đúp để xem chi tiết đầy đủ, mã QR và lịch sử giao dịch."
                                           FontSize="11" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                            </StackPanel>

                            <!-- Panel Chi Tiết Nội Dung Vé -->
                            <ScrollViewer x:Name="scrollChiTietVe" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                                <StackPanel>
                                    <!-- Header mã vé & trạng thái -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="CHI TIẾT VÉ ĐIỆN TỬ" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock x:Name="lblChiTietMaVeCode" Text="TK_0000000000" FontSize="15" FontWeight="Bold" FontFamily="Consolas" Foreground="#003B73"/>
                                            <TextBlock x:Name="lblChiTietMaPNR" Text="PNR: ABCDEF" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#0284C7"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" x:Name="brdChiTietTrangThai" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="8,4" VerticalAlignment="Top">
                                            <TextBlock x:Name="lblChiTietTrangThai" Text="ĐÃ ĐẶT" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                        </Border>
                                    </Grid>

                                    <!-- QR Code điện tử -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Image x:Name="imgChiTietQRCode" Width="110" Height="110" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,0,4"/>
                                            <TextBlock Text="Mã kiểm soát soát vé điện tử VNR" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Block 1: Hành trình -->
                                    <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="HÀNH TRÌNH TÀU" FontSize="10" FontWeight="Bold" Foreground="#0369A1" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Ga đi" FontSize="10" Foreground="#64748B"/>
                                                    <TextBlock x:Name="lblChiTietGaDi" Text="Hà Nội" FontSize="13" FontWeight="Bold" Foreground="#003B73"/>
                                                </StackPanel>
                                                <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight24" FontSize="14" Foreground="#0284C7" VerticalAlignment="Center" Margin="6,0"/>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                    <TextBlock Text="Ga đến" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right"/>
                                                    <TextBlock x:Name="lblChiTietGaDen" Text="Sài Gòn" FontSize="13" FontWeight="Bold" Foreground="#003B73" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                            <Separator Margin="0,6" Background="#BAE6FD"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Mác tàu:" FontSize="10" Foreground="#64748B"/>
                                                    <TextBlock x:Name="lblChiTietMacTau" Text="SE1" FontSize="12" FontWeight="Bold" Foreground="#003B73"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <TextBlock Text="Giờ khởi hành:" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right"/>
                                                    <TextBlock x:Name="lblChiTietGioChay" Text="19:30 - 24/09/2026" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Block 2: Toa & Chỗ ngồi -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Toa xe" FontSize="10" Foreground="#64748B"/>
                                                <TextBlock x:Name="lblChiTietToa" Text="Toa 03" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock x:Name="lblChiTietLoaiToa" Text="Nằm khoang 4" FontSize="10" Foreground="#64748B"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <TextBlock Text="Số ghế" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="lblChiTietSoGhe" Text="14" FontSize="16" FontWeight="Bold" Foreground="#003B73" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="lblChiTietTangGiuong" Text="Tầng 1" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="Mã chỗ" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right"/>
                                                <TextBlock x:Name="lblChiTietMaCho" Text="#102" FontSize="12" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Block 3: Hành khách -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="THÔNG TIN HÀNH KHÁCH" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="Họ và tên:" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="lblChiTietTenHK" Text="NGUYỄN VĂN A" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="CCCD / Định danh:" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="lblChiTietCccdHK" Text="001200000000" FontSize="11" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#003B73" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Block 4: Chi phí & Thanh toán -->
                                    <Border Background="#FEFCE8" BorderBrush="#FEF08A" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="GIÁ VÉ &amp; THANH TOÁN" FontSize="10" FontWeight="Bold" Foreground="#A16207" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="Giá vé gốc:" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="lblChiTietGiaGoc" Text="850,000 VNĐ" FontSize="11" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="Giảm giá đối tượng:" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="lblChiTietGiamGia" Text="-0 VNĐ" FontSize="11" Foreground="#15803D" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Separator Margin="0,4" Background="#FEF08A"/>
                                            <Grid>
                                                <TextBlock Text="Thực thu:" FontSize="12" FontWeight="Bold" Foreground="#003B73"/>
                                                <TextBlock x:Name="lblChiTietThucThu" Text="850,000 VNĐ" FontSize="14" FontWeight="Bold" Foreground="#003B73" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Block 5: Đơn hàng & Người mua -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="ĐƠN HÀNG ĐẶT VÉ" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="Người mua:" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="lblChiTietNguoiMua" Text="Trần Văn B" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="Số điện thoại:" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="lblChiTietSdtNguoiMua" Text="0901234567" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="Thời điểm xuất:" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="lblChiTietThoiDiemXuat" Text="10:30 - 20/09/2026" FontSize="11" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Block 6: Thông tin hoàn trả (nếu có) -->
                                    <Border x:Name="brdChiTietHoanHuy" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8" Visibility="Collapsed">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="12" Foreground="#B91C1C" Margin="0,0,4,0"/>
                                                <TextBlock Text="THÔNG TIN HOÀN VÉ (CHUẨN VNR)" FontSize="10" FontWeight="Bold" Foreground="#B91C1C"/>
                                            </StackPanel>
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="Thời điểm hoàn:" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="lblChiTietThoiDiemHoan" Text="--" FontSize="11" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="Tỷ lệ lệ phí khấu trừ:" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="lblChiTietTyLeHoan" Text="10%" FontSize="11" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="Số tiền lệ phí:" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="lblChiTietLePhiHoan" Text="0 VNĐ" FontSize="11" Foreground="#B91C1C" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="Tiền thực hoàn lại:" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                                <TextBlock x:Name="lblChiTietThucHoan" Text="0 VNĐ" FontSize="12" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="Lý do:" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="lblChiTietLyDoHoan" Text="--" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" MaxWidth="180"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Quick action buttons trong detail panel -->
                                    <UniformGrid Columns="3" Margin="0,4,0,0">
                                        <Button Click="BtnInTheLenTauTab2_Click" Style="{StaticResource PrimaryDesktopButton}" Margin="0,0,4,0" Padding="0" Height="32" ToolTip="In thẻ lên tàu cho vé đang chọn (F8)">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Print24" FontSize="12" Margin="0,0,3,0"/>
                                                <TextBlock Text="In Thẻ" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="BtnDoiGheTab2_Click" Style="{StaticResource DesktopButton}" Margin="2,0" Padding="0" Height="32" ToolTip="Đổi sang ghế khác cùng chuyến tàu">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="12" Margin="0,0,3,0" Foreground="#D97706"/>
                                                <TextBlock Text="Đổi Ghế" FontSize="11" Foreground="#D97706"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="BtnHoanVeTab2_Click" Style="{StaticResource DesktopButton}" Margin="4,0,0,0" Padding="0" Height="32" ToolTip="Làm thủ tục hoàn vé theo chuẩn VNR">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="12" Margin="0,0,3,0" Foreground="#B91C1C"/>
                                                <TextBlock Text="Hoàn Vé" FontSize="11" Foreground="#B91C1C"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
