<Page x:Class="GUI.Views.Pages.QuanTriPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Quản Trị Hệ Thống"
      Loaded="Page_Loaded">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GUI;component/Resources/Styles/KyThuatPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DongTaiKhoanStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <EventSetter Event="MouseDoubleClick" Handler="DongTaiKhoan_MouseDoubleClick"/>
                <Setter Property="Opacity" Value="{Binding DoMo}"/>
            </Style>

            <Style x:Key="QtIconNut" TargetType="ui:SymbolIcon">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,5,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Style>
            <Style x:Key="QtNhanDem" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#475569"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="QtSoDem" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#334155"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="QtVachNgan" TargetType="Border">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Background" Value="#E2E8F0"/>
                <Setter Property="Margin" Value="12,0"/>
            </Style>
            <Style x:Key="QtChuO" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- DẢI TIÊU ĐỀ -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="18" Foreground="#003B73"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="QUẢN TRỊ HỆ THỐNG" FontSize="13" FontWeight="Bold" Foreground="#003B73"/>
                        <TextBlock Text="Tài khoản · Vai trò &amp; quyền · Lịch sử đăng nhập · Nhật ký hệ thống" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tài khoản hoạt động" Style="{StaticResource QtNhanDem}"/>
                    <TextBlock x:Name="txtDemHoatDong" Text="0" Style="{StaticResource QtSoDem}"/>
                    <Border Style="{StaticResource QtVachNgan}"/>
                    <TextBlock Text="Đang bị khóa" Style="{StaticResource QtNhanDem}"/>
                    <TextBlock x:Name="txtDemBiKhoa" Text="0" Style="{StaticResource QtSoDem}"/>
                    <Border Style="{StaticResource QtVachNgan}"/>
                    <TextBlock Text="Đăng nhập sai hôm nay" Style="{StaticResource QtNhanDem}"/>
                    <TextBlock x:Name="txtDemSaiHomNay" Text="0" Style="{StaticResource QtSoDem}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="tabQuanTri" Margin="12,8,12,12" SelectionChanged="TabQuanTri_SelectionChanged"
                    Background="Transparent" BorderThickness="0">

            <!-- ============================================================= -->
            <!-- TAB 1: TÀI KHOẢN                                              -->
            <!-- ============================================================= -->
            <TabItem Style="{StaticResource KtTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Person24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Tài Khoản" VerticalAlignment="Center"/>
                        <Border Background="#E2E8F0" CornerRadius="8" Padding="6,1" Margin="6,0,0,0">
                            <TextBlock x:Name="txtBadgeTaiKhoan" Text="0" FontSize="10" FontWeight="Bold" Foreground="#334155"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,8,0,0" TextElement.FontWeight="Normal" TextElement.FontSize="12" TextElement.Foreground="#0F172A">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource KtToolbar}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="90" MaxWidth="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tra cứu:" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" x:Name="txtTimTaiKhoan" TextChanged="LocTaiKhoan_Changed"
                                     ToolTip="Tìm theo tên đăng nhập, tên hiển thị, vai trò, mã nhân viên, email (gõ không dấu cũng được)"/>
                            <ComboBox Grid.Column="2" x:Name="cboVaiTroLoc" Width="170" Margin="6,0,0,0"
                                      SelectionChanged="LocTaiKhoan_Changed" ToolTip="Lọc theo vai trò"/>
                            <ComboBox Grid.Column="3" x:Name="cboTrangThaiLoc" Width="160" Margin="6,0,0,0"
                                      SelectionChanged="LocTaiKhoan_Changed" ToolTip="Lọc theo trạng thái">
                                <ComboBoxItem Content="Tất cả trạng thái" Tag="ALL" IsSelected="True"/>
                                <ComboBoxItem Content="Hoạt động" Tag="HOAT_DONG"/>
                                <ComboBoxItem Content="Đang bị khóa" Tag="BI_KHOA"/>
                                <ComboBoxItem Content="Vô hiệu hóa" Tag="VO_HIEU"/>
                            </ComboBox>
                            <StackPanel Grid.Column="5" Orientation="Horizontal">
                                <Button x:Name="btnThemTaiKhoan" Click="BtnThemTaiKhoan_Click" Style="{StaticResource PrimaryDesktopButton}"
                                        ToolTip="Tạo tài khoản mới (F2)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="PersonAdd24" Style="{StaticResource QtIconNut}"/>
                                        <TextBlock Text="Thêm"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnSuaTaiKhoan" Click="BtnSuaTaiKhoan_Click" IsEnabled="False" Padding="10,0"
                                        Style="{StaticResource DesktopButton}" ToolTip="Sửa tài khoản, gán vai trò, vô hiệu hóa (nhấp đúp vào dòng)">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Edit24" Style="{StaticResource QtIconNut}"/>
                                        <TextBlock Text="Sửa"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnDatLaiMatKhau" Click="BtnDatLaiMatKhau_Click" IsEnabled="False" Padding="10,0"
                                        Style="{StaticResource DesktopButton}" ToolTip="Đặt mật khẩu mới — người dùng phải đổi ở lần đăng nhập sau">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="LockClosed24" Style="{StaticResource QtIconNut}"/>
                                        <TextBlock Text="Đặt Lại Mật Khẩu"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="btnMoKhoa" Click="BtnMoKhoa_Click" IsEnabled="False" Padding="10,0"
                                        Style="{StaticResource DesktopButton}" ToolTip="Mở khóa tài khoản bị khóa do nhập sai mật khẩu 5 lần">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ShieldCheckmark24" Style="{StaticResource QtIconNut}"/>
                                        <TextBlock Text="Mở Khóa"/>
                                    </StackPanel>
                                </Button>
                                <Border Width="1" Background="#CBD5E1" Margin="2,4,8,4"/>
                                <Button x:Name="btnNapLaiQuanTri" Click="BtnNapLai_Click" Style="{StaticResource DesktopButton}" Margin="0" Padding="8,0" ToolTip="Nạp lại (F5)">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="13" Foreground="#64748B"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="420"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="310" MinWidth="270" MaxWidth="380"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KtCard}">
                            <DataGrid x:Name="dgTaiKhoan" HeadersVisibility="Column" BorderThickness="0" IsReadOnly="True"
                                      AutoGenerateColumns="False" RowStyle="{StaticResource DongTaiKhoanStyle}"
                                      SelectionMode="Single" SelectionChanged="DgTaiKhoan_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên Đăng Nhập" Width="120" Binding="{Binding TenDangNhap}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource QtChuO}">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Tên Hiển Thị" Width="*" MinWidth="120" Binding="{Binding HoTenHienThi}" ElementStyle="{StaticResource QtChuO}"/>
                                    <DataGridTextColumn Header="Vai Trò" Width="*" MinWidth="120" Binding="{Binding NhanVaiTro}" ElementStyle="{StaticResource QtChuO}"/>
                                    <DataGridTextColumn Header="Hồ Sơ Nhân Viên" Width="150" Binding="{Binding NhanHoSo}" ElementStyle="{StaticResource QtChuO}"/>
                                    <DataGridTemplateColumn Header="Trạng Thái" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding MauTrangThai}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding NhanTrangThai}" Foreground="{Binding MauTrangThai}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Đăng Nhập Gần Nhất" Width="130" Binding="{Binding NhanDangNhapCuoi}" ElementStyle="{StaticResource QtChuO}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource KtCard}" Padding="14,12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="txtCtTen" Text="Chọn một tài khoản" FontSize="14" FontWeight="Bold" Foreground="#003B73" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="txtCtPhu" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                    <StackPanel x:Name="pnlChiTiet" Visibility="Collapsed">
                                        <TextBlock Text="TRẠNG THÁI" Style="{StaticResource KtSectionHeader}"/>
                                        <TextBlock x:Name="txtCtTrangThai" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <TextBlock Text="THÔNG TIN" Style="{StaticResource KtSectionHeader}"/>
                                        <TextBlock x:Name="txtCtThongTin" FontSize="11" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="18"/>
                                        <TextBlock Text="QUYỀN ĐƯỢC CẤP (THEO VAI TRÒ)" Style="{StaticResource KtSectionHeader}"/>
                                        <ItemsControl x:Name="icCtQuyen">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="11" Foreground="#15803D" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#0F172A" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================================= -->
            <!-- TAB 2: VAI TRÒ & QUYỀN                                         -->
            <!-- ============================================================= -->
            <TabItem Style="{StaticResource KtTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Vai Trò &amp; Quyền" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,8,0,0" TextElement.FontWeight="Normal" TextElement.FontSize="12" TextElement.Foreground="#0F172A">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KtCard}" Padding="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="VAI TRÒ" Style="{StaticResource KtSectionHeader}" Margin="12,10,12,6"/>
                            <ListBox x:Name="lstVaiTro" BorderThickness="0" SelectionChanged="LstVaiTro_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,4">
                                            <TextBlock Text="{Binding TenVaiTro}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                            <!-- Cung mau chu voi dong dang chon (nen dam khi chon -> mau xam co dinh khong doc duoc) -->
                                            <TextBlock Text="{Binding NhanPhu}" FontSize="10.5" Opacity="0.75"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource KtCard}" Padding="14,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock x:Name="txtVtTen" Text="Chọn một vai trò" FontSize="14" FontWeight="Bold" Foreground="#003B73"/>
                                    <TextBlock x:Name="txtVtMoTa" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0" MaxWidth="560" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button x:Name="btnHoanTacQuyen" Click="BtnHoanTacQuyen_Click" IsEnabled="False"
                                            Style="{StaticResource DesktopButton}" Padding="10,0" ToolTip="Bỏ các thay đổi chưa lưu">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="ArrowUndo24" Style="{StaticResource QtIconNut}"/>
                                            <TextBlock Text="Hoàn Tác"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnLuuQuyen" Click="BtnLuuQuyen_Click" IsEnabled="False" Margin="0"
                                            Style="{StaticResource PrimaryDesktopButton}" ToolTip="Lưu quyền của vai trò (áp dụng từ lần đăng nhập sau của người dùng)">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Save24" Style="{StaticResource QtIconNut}"/>
                                            <TextBlock Text="Lưu Quyền"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="icNhomQuyen">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <Border BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="0,0,0,3" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Key}" FontSize="11" FontWeight="Bold" Foreground="#003B73"/>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding DuocChon, Mode=TwoWay}" IsEnabled="{Binding ChoSua}" Width="330"
                                                                      Margin="0,2,8,2" Checked="QuyenThayDoi" Unchecked="QuyenThayDoi" ToolTip="{Binding MoTa}"
                                                                      ToolTipService.ShowOnDisabled="True">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Ten}" FontSize="11.5" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding Ma2}" FontSize="10" Foreground="#64748B"/>
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================================================= -->
            <!-- TAB 3: LỊCH SỬ ĐĂNG NHẬP                                       -->
            <!-- ============================================================= -->
            <TabItem Style="{StaticResource KtTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="History24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Lịch Sử Đăng Nhập" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,8,0,0" TextElement.FontWeight="Normal" TextElement.FontSize="12" TextElement.Foreground="#0F172A">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource KtToolbar}">
                        <WrapPanel>
                            <TextBlock Text="Từ:" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="dpLsTu" Width="125" SelectedDateChanged="LocLichSu_Changed"/>
                            <TextBlock Text="Đến:" Style="{StaticResource FieldLabel}" Margin="10,0,6,0"/>
                            <DatePicker x:Name="dpLsDen" Width="125" SelectedDateChanged="LocLichSu_Changed"/>
                            <ComboBox x:Name="cboLsTaiKhoan" Width="200" Margin="10,0,0,0" SelectionChanged="LocLichSu_Changed" ToolTip="Lọc theo tài khoản"/>
                            <ComboBox x:Name="cboLsKetQua" Width="130" Margin="6,0,0,0" SelectionChanged="LocLichSu_Changed">
                                <ComboBoxItem Content="Tất cả kết quả" Tag="ALL" IsSelected="True"/>
                                <ComboBoxItem Content="Thành công" Tag="OK"/>
                                <ComboBoxItem Content="Thất bại" Tag="LOI"/>
                            </ComboBox>
                            <TextBox x:Name="txtLsTim" Width="160" Margin="6,0,0,0" KeyUp="TxtLsTim_KeyUp"
                                     ToolTip="Tìm theo tên đăng nhập, thiết bị, lý do (Enter để lọc)"/>
                            <TextBlock x:Name="txtLsDem" FontSize="11" Foreground="#475569" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </WrapPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource KtCard}">
                        <DataGrid x:Name="dgLichSu" HeadersVisibility="Column" BorderThickness="0" IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Thời Điểm" Width="140" Binding="{Binding NhanThoiDiem}" ElementStyle="{StaticResource QtChuO}"/>
                                <DataGridTextColumn Header="Tài Khoản" Width="110" Binding="{Binding TenDangNhap}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource QtChuO}">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Tên Hiển Thị" Width="150" Binding="{Binding HoTen}" ElementStyle="{StaticResource QtChuO}"/>
                                <DataGridTemplateColumn Header="Kết Quả" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NhanKetQua}" Foreground="{Binding MauKetQua}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Lý Do" Width="*" MinWidth="150" Binding="{Binding LyDo}" ElementStyle="{StaticResource QtChuO}"/>
                                <DataGridTextColumn Header="Thiết Bị" Width="220" Binding="{Binding ThietBi}" ElementStyle="{StaticResource QtChuO}"/>
                                <DataGridTextColumn Header="Địa Chỉ IP" Width="110" Binding="{Binding DiaChiIP}" ElementStyle="{StaticResource QtChuO}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================================================= -->
            <!-- TAB 4: NHẬT KÝ HỆ THỐNG                                        -->
            <!-- ============================================================= -->
            <TabItem Style="{StaticResource KtTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ClipboardTaskListLtr24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Nhật Ký Hệ Thống" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,8,0,0" TextElement.FontWeight="Normal" TextElement.FontSize="12" TextElement.Foreground="#0F172A">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource KtToolbar}">
                        <WrapPanel>
                            <TextBlock Text="Từ:" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="dpNkTu" Width="125" SelectedDateChanged="LocNhatKy_Changed"/>
                            <TextBlock Text="Đến:" Style="{StaticResource FieldLabel}" Margin="10,0,6,0"/>
                            <DatePicker x:Name="dpNkDen" Width="125" SelectedDateChanged="LocNhatKy_Changed"/>
                            <ComboBox x:Name="cboNkNguoi" Width="210" Margin="10,0,0,0" SelectionChanged="LocNhatKy_Changed" ToolTip="Người thao tác"/>
                            <ComboBox x:Name="cboNkBang" Width="180" Margin="6,0,0,0" SelectionChanged="LocNhatKy_Changed" ToolTip="Bảng dữ liệu"/>
                            <ComboBox x:Name="cboNkHanhDong" Width="170" Margin="6,0,0,0" SelectionChanged="LocNhatKy_Changed" ToolTip="Hành động"/>
                            <TextBox x:Name="txtNkTim" Width="150" Margin="6,0,0,0" KeyUp="TxtNkTim_KeyUp"
                                     ToolTip="Tìm trong khóa bản ghi / dữ liệu cũ / mới (Enter để lọc)"/>
                            <TextBlock x:Name="txtNkDem" FontSize="11" Foreground="#475569" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </WrapPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="420"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="380" MinWidth="300" MaxWidth="460"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KtCard}">
                            <DataGrid x:Name="dgNhatKy" HeadersVisibility="Column" BorderThickness="0" IsReadOnly="True" AutoGenerateColumns="False"
                                      SelectionMode="Single" SelectionChanged="DgNhatKy_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Thời Điểm" Width="140" Binding="{Binding NhanThoiDiem}" ElementStyle="{StaticResource QtChuO}"/>
                                    <DataGridTextColumn Header="Người Thao Tác" Width="110" Binding="{Binding NguoiThucHien}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource QtChuO}">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Hành Động" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding NhanHanhDong}" Foreground="{Binding MauHanhDong}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Bảng" Width="*" MinWidth="130" Binding="{Binding TenBang}" ElementStyle="{StaticResource QtChuO}"/>
                                    <DataGridTextColumn Header="Khóa" Width="80" Binding="{Binding KhoaChinh}" ElementStyle="{StaticResource QtChuO}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource KtCard}" Padding="12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <TextBlock x:Name="txtNkTieuDe" Text="Chọn một dòng nhật ký" FontSize="13" FontWeight="Bold" Foreground="#003B73" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="txtNkPhu" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                    <TextBlock Text="SO SÁNH DỮ LIỆU CŨ / MỚI" Style="{StaticResource KtSectionHeader}"/>
                                </StackPanel>
                                <DataGrid Grid.Row="1" x:Name="dgNkTruong" HeadersVisibility="Column" BorderThickness="1" BorderBrush="#E2E8F0"
                                          IsReadOnly="True" AutoGenerateColumns="False" GridLinesVisibility="Horizontal" RowHeight="NaN" MinRowHeight="26">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Setter Property="Background" Value="{Binding MauDong}"/>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Trường" Width="100" Binding="{Binding Truong}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="FontWeight" Value="{Binding DoDam}"/>
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Trước" Width="*" Binding="{Binding Truoc}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Sau" Width="*" Binding="{Binding Sau}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="Foreground" Value="#166534"/>
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
