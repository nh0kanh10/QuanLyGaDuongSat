{
  // =========================================================================
  // Cấu hình kết nối CSDL — FILE DÙNG CHUNG CỦA CẢ NHÓM (được đẩy lên Git).
  //
  // KHÔNG sửa file này để chạy trên máy mình. Máy nào lệch thì tạo thêm file
  // "appsettings.Local.json" ngay bên cạnh (file đó bị .gitignore loại ra) và
  // chỉ ghi lại những khoá cần đổi, ví dụ:
  //
  //     { "KetNoiCsdl": { "MayChu": "DESKTOP-ABC123" } }
  //
  // Thứ tự ưu tiên: appsettings.Local.json > appsettings.json > mặc định trong mã.
  // Nếu vẫn không nối được, app tự dò các instance SQL Server quen gặp
  // (xem TuDongDoMayChu bên dưới).
  //
  // LƯU Ý: đây là JSON nên dấu gạch chéo ngược phải viết đôi.
  // Instance SQLEXPRESS viết là ".\\SQLEXPRESS", không phải ".\SQLEXPRESS".
  // =========================================================================
  "KetNoiCsdl": {
    // Tên máy chủ / instance SQL Server.
    // Ví dụ: ".\\SQLEXPRESS" · "." · "localhost" · "DESKTOP-ABC123"
    //        "(localdb)\\MSSQLLocalDB"
    "MayChu": ".\\SQLEXPRESS",

    // CSDL chính của ứng dụng.
    "TenCsdl": "QuanLyDuongSatV2",

    // CSDL dành riêng cho kiểm thử tự động (chưa dựng — việc nền Sprint 1).
    "TenCsdlKiemThu": "QuanLyDuongSatV2_Test",

    // Để trống thì chuỗi kết nối được ghép từ MayChu + TenCsdl ở trên.
    // Chỉ điền khi cần dạng đặc biệt (đăng nhập SQL, đổi cổng, timeout riêng...).
    "ChuoiKetNoi": "",

    // true: nối không được thì tự dò lần lượt các instance quen gặp.
    // false: báo lỗi luôn, không dò (dùng khi muốn biết chắc cấu hình sai).
    "TuDongDoMayChu": true
  }
}
