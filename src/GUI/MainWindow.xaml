<ui:FluentWindow x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="HỆ THỐNG ĐIỀU HÀNH &amp; QUẢN LÝ VẬN TẢI ĐƯỜNG SẮT VIỆT NAM (VNR ENTERPRISE)"
        Width="1480" Height="890"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Language="vi-VN">

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Thanh tiêu đề -->
        <ui:TitleBar Grid.Row="0"
                     Title="TỔNG CÔNG TY ĐƯỜNG SẮT VIỆT NAM (VNR) • HỆ THỐNG ĐIỀU HÀNH VẬN TẢI TUYẾN BẮC - NAM"
                     Icon="{ui:SymbolIcon VehicleSubway24}">
            <ui:TitleBar.Header>
                <TextBlock Text="PHIÊN BẢN 2.0 • PHÂN HỆ ĐIỀU ĐỘ &amp; VẬN TẢI" 
                           FontSize="11" Foreground="#64748B" FontWeight="SemiBold" 
                           VerticalAlignment="Center" Margin="14,0"/>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Menu chính -->
        <Menu Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,1,0,1" Height="26" FontSize="12">
            <MenuItem Header="_Hệ Thống">
                <MenuItem Header="Thông Tin Kết Nối CSDL (SQL Server)" Click="MenuKetNoi_Click"/>
                <Separator/>
                <MenuItem Header="Đăng Xuất Khỏi Ca Trực" Click="MenuThoat_Click"/>
                <MenuItem Header="Thoát Ứng Dụng (Alt+F4)" Click="MenuThoat_Click"/>
            </MenuItem>
            <MenuItem Header="_Danh Mục Tuyến">
                <MenuItem Header="Danh Sách Ga Kỹ Thuật" Click="MenuGa_Click"/>
                <MenuItem Header="Danh Sách Phân Đoạn Khu Gian" Click="MenuKhuGian_Click"/>
                <MenuItem Header="Cơ Cấu Biểu Cước Vận Tải" Click="MenuGa_Click"/>
            </MenuItem>
            <MenuItem Header="_Vận Hành &amp; Điều Độ">
                <MenuItem Header="Biểu Đồ Chạy Tàu 24h" Click="MenuLichTrinh_Click"/>
                <MenuItem Header="Theo Dõi Chậm Giờ &amp; Sự Cố" Click="MenuLichTrinh_Click"/>
            </MenuItem>
            <MenuItem Header="_Kinh Doanh Vận Tải">
                <MenuItem Header="Bán Vé Chặng &amp; Chỗ Ngồi" Click="MenuBanVe_Click"/>
                <MenuItem Header="Vận Chuyển Hóa Vận &amp; Xe Máy PCCC" Click="MenuHangHoa_Click"/>
            </MenuItem>
            <MenuItem Header="_Báo Cáo - Thống Kê">
                <MenuItem Header="Báo Cáo Doanh Thu Bán Vé" Click="MenuBaoCao_Click"/>
                <MenuItem Header="Thống Kê Tấn.Km Hóa Vận" Click="MenuBaoCao_Click"/>
                <MenuItem Header="Báo Cáo Đúng Giờ Đoàn Tàu" Click="MenuBaoCao_Click"/>
            </MenuItem>
            <MenuItem Header="_Trợ Giúp">
                <MenuItem Header="Hướng Dẫn Tác Nghiệp Phần Mềm" Click="MenuTroGiup_Click"/>
                <Separator/>
                <MenuItem Header="Thông Tin Đồ Án 2 - Quản Lý Đường Sắt" Click="MenuTroGiup_Click"/>
            </MenuItem>
        </Menu>

        <!-- Thanh chuyển phân hệ chức năng -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border x:Name="tabGa" Background="#003B73" BorderBrush="#002855" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0">
                        <Button Click="NavTab_Click" Tag="MangLuoiGa" Background="Transparent" BorderThickness="0" Padding="12,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="iconTabGa" Symbol="Globe24" FontSize="16" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtTabGa" Text="MẠNG LƯỚI GA" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border x:Name="tabKhuGian" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0">
                        <Button Click="NavTab_Click" Tag="KhuGian" Background="Transparent" BorderThickness="0" Padding="12,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="iconTabKhuGian" Symbol="ArrowSwap24" FontSize="16" Foreground="#475569" Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtTabKhuGian" Text="KHU GIAN ĐƯỜNG SẮT" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border x:Name="tabLichTrinh" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0">
                        <Button Click="NavTab_Click" Tag="LichTrinh" Background="Transparent" BorderThickness="0" Padding="12,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="iconTabLichTrinh" Symbol="CalendarClock24" FontSize="16" Foreground="#475569" Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtTabLichTrinh" Text="LỊCH TRÌNH CHẠY TÀU" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border x:Name="tabBanVe" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0">
                        <Button Click="NavTab_Click" Tag="BanVe" Background="Transparent" BorderThickness="0" Padding="12,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="iconTabBanVe" Symbol="TicketDiagonal24" FontSize="16" Foreground="#475569" Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtTabBanVe" Text="HÀNH KHÁCH &amp; BÁN VÉ" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Border x:Name="tabHangHoa" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0">
                        <Button Click="NavTab_Click" Tag="HangHoa" Background="Transparent" BorderThickness="0" Padding="12,6" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="iconTabHangHoa" Symbol="Box24" FontSize="16" Foreground="#475569" Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtTabHangHoa" Text="VẬN TẢI HÀNG HÓA" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="2" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Đường sắt Bắc - Nam (1,726.20 km)" FontSize="11" Foreground="#334155" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Khung hiển thị nội dung -->
        <Frame Grid.Row="3" x:Name="MainFrame" NavigationUIVisibility="Hidden" Margin="0"/>

        <!-- Thanh phím tắt -->
        <Border Grid.Row="4" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,1,0,1" Padding="8,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnScF1" Click="BtnShortcut_Click" Tag="F1" Margin="2,0" Padding="6,3" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="F1: Mở hướng dẫn nghiệp vụ &amp; danh mục phím tắt">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0284C7" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                            <TextBlock Text="F1" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock x:Name="txtScF1" Text="Trợ Giúp" FontSize="11" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle x:Name="sepScF1" Width="1" Height="14" Fill="#334155" Margin="4,0"/>

                <Button x:Name="btnScF2" Click="BtnShortcut_Click" Tag="F2" Margin="2,0" Padding="6,3" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="F2: Thêm mới bản ghi">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#15803D" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                            <TextBlock Text="F2" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock x:Name="txtScF2" Text="Thêm Mới" FontSize="11" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle x:Name="sepScF2" Width="1" Height="14" Fill="#334155" Margin="4,0"/>

                <Button x:Name="btnScF3" Click="BtnShortcut_Click" Tag="F3" Margin="2,0" Padding="6,3" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="F3: Tra cứu nhanh tức thì">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#D97706" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                            <TextBlock Text="F3" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock x:Name="txtScF3" Text="Tra Cứu" FontSize="11" FontWeight="SemiBold" Foreground="#FDE68A" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle x:Name="sepScF3" Width="1" Height="14" Fill="#334155" Margin="4,0"/>

                <Button x:Name="btnScF4" Click="BtnShortcut_Click" Tag="F4" Margin="2,0" Padding="6,3" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="F4: Nhập dữ liệu hàng loạt từ tệp Excel/CSV">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#6366F1" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                            <TextBlock Text="F4" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock x:Name="txtScF4" Text="Nhập Tệp" FontSize="11" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle x:Name="sepScF4" Width="1" Height="14" Fill="#334155" Margin="4,0"/>

                <Button x:Name="btnScF5" Click="BtnShortcut_Click" Tag="F5" Margin="2,0" Padding="6,3" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="F5: Nạp lại toàn bộ dữ liệu sạch từ CSDL SQL Server">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#059669" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                            <TextBlock Text="F5" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock x:Name="txtScF5" Text="Nạp Lại" FontSize="11" FontWeight="SemiBold" Foreground="#A7F3D0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle x:Name="sepScF5" Width="1" Height="14" Fill="#334155" Margin="4,0"/>

                <Button x:Name="btnScF6" Click="BtnShortcut_Click" Tag="F6" Margin="2,0" Padding="6,3" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="F6: Xuất danh sách dữ liệu ra bảng tính Excel / CSV">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#10B981" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                            <TextBlock Text="F6" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock x:Name="txtScF6" Text="Xuất Excel" FontSize="11" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle x:Name="sepScF6" Width="1" Height="14" Fill="#334155" Margin="4,0"/>

                <Button x:Name="btnScF9" Click="BtnShortcut_Click" Tag="F9" Margin="2,0" Padding="6,3" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="F9: Mở Trung tâm Lập &amp; In Báo Cáo Kỹ Thuật A4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#003B73" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                            <TextBlock Text="F9" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock x:Name="txtScF9" Text="Báo Cáo A4" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle x:Name="sepScF9" Width="1" Height="14" Fill="#334155" Margin="4,0"/>

                <Button x:Name="btnScF11" Click="BtnShortcut_Click" Tag="F11" Margin="2,0" Padding="6,3" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="F11: Phóng to toàn màn hình hoặc thu nhỏ cửa sổ">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#475569" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                            <TextBlock Text="F11" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock x:Name="txtScF11" Text="Toàn Màn Hình" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Rectangle x:Name="sepScF11" Width="1" Height="14" Fill="#334155" Margin="4,0"/>

                <Button x:Name="btnScEsc" Click="BtnShortcut_Click" Tag="ESC" Margin="2,0" Padding="6,3" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Esc: Xóa bộ lọc tìm kiếm hoặc hủy form chi tiết">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#DC2626" CornerRadius="3" Padding="5,1" Margin="0,0,5,0">
                            <TextBlock Text="Esc" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <TextBlock x:Name="txtScEsc" Text="Hủy" FontSize="11" FontWeight="SemiBold" Foreground="#FCA5A5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Thanh trạng thái -->
        <Border Grid.Row="5" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" Padding="12,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="●" Foreground="#15803D" Margin="0,0,6,0" FontSize="11"/>
                    <TextBlock Text="SẴN SÀNG" FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="|  Máy chủ: .\SQLEXPRESS  |  CSDL: QuanLyDuongSatV2" FontSize="11" Foreground="#475569"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Điều Độ Viên Trung Tâm" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,14,0"/>
                    <TextBlock x:Name="txtClock" Text="17/09/2026" FontSize="11" Foreground="#003B73" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
